model SearchStrategy {
  id                String                      @id @default(uuid())
  searchOptionId    String
  strategyId        String                      @unique
  provider          String
  modelId           String?
  providerModelId   String?
  displayName       String
  kind              String
  description       String
  enabled           Boolean                     @default(true)
  config            Json
  adapterKind       String                      @default("answer_provider_hosted")
  credentialMode    String                      @default("answer_provider")
  draft             Json                        @default("{}")
  draftVersion      Int                         @default(1)
  testedDraftHash   String?
  draftTestEvidence Json?
  activeRevisionId  String?                     @unique
  activatedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  activeRevision    SearchIntegrationRevision?  @relation("ActiveSearchRevision", fields: [id, activeRevisionId], references: [searchStrategyId, id], onDelete: Restrict, onUpdate: Restrict, map: "SearchStrategy_activeRevision_fkey")
  providerModel     ProviderModel?              @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  revisions         SearchIntegrationRevision[] @relation("SearchIntegrationRevisions")
  runBindings       SearchRunBinding[]
  searchOption      SearchOption                @relation(fields: [searchOptionId], references: [id], onDelete: Restrict)

  @@unique([id, activeRevisionId])
  @@index([providerModelId])
  @@index([searchOptionId])
  @@index([enabled, archivedAt])
}

model SearchIntegrationRevision {
  id                    String             @id @default(uuid())
  searchStrategyId      String
  revisionNumber        Int
  adapterKind           String
  credentialMode        String
  configuration         Json
  providerModelId       String?
  validationEvidence    Json
  draftHash             String
  validationFingerprint String             @default("legacy")
  createdAt             DateTime           @default(now())
  activeFor             SearchStrategy?    @relation("ActiveSearchRevision")
  providerModel         ProviderModel?     @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  searchStrategy        SearchStrategy     @relation("SearchIntegrationRevisions", fields: [searchStrategyId], references: [id], onDelete: Restrict)
  runBindings           SearchRunBinding[]
  searchRuns            SearchRun[]

  @@unique([searchStrategyId, revisionNumber])
  @@unique([searchStrategyId, draftHash, validationFingerprint], map: "SearchIntegrationRevision_strategy_draft_validation_key")
  @@unique([searchStrategyId, id])
  @@index([providerModelId])
}

model SearchRunBinding {
  id                  String                    @id @default(uuid())
  modelRunId          String
