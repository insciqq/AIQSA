  autoSaved       Boolean              @default(false)
  checksum        String?              @db.Char(64)
  createdAt       DateTime             @default(now())
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  currentSecret   WorkspaceSecret?
  runBindings     WorkspaceRunSecret[]

  @@index([userId, secretId])
}

model WorkspaceRunSecret {
  modelRunId String
  secretId   String
  valueId    String
  runBinding WorkspaceRunBinding  @relation(fields: [modelRunId], references: [modelRunId], onDelete: Cascade, onUpdate: Restrict)
  value      WorkspaceSecretValue @relation(fields: [valueId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([modelRunId, secretId])
  @@index([valueId])
}

model WorkspaceOutputCheckpoint {
  id                   String @id @default(uuid())
  modelRunId           String
  toolCallId           String @unique
  requestHash          String @db.Char(64)
  description          String @db.VarChar(300)
  selection            Json
