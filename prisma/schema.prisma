  @@unique([documentId, id])
  @@unique([knowledgeBaseId, id])
  @@unique([knowledgeBaseId, documentId, id])
  @@index([knowledgeBaseId, ingestState, ingestNextAttemptAt])
  @@index([ingestGenerationId])
  @@index([originalStorageKey])
  @@index([normalizedTextStorageKey])
  @@index([knowledgeBaseId, visibleFromRevision, visibleUntilRevision])
