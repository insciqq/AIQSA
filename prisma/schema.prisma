/// Who wrote a follow-up (`RunFollowup`): the user, the main agent writing to a running background sub-agent, or the
/// callback of a background sub-agent turn delivered into a running main-agent answer (`subagentTurnId`).
enum RunFollowupOrigin {
  user
  main_agent
  subagent_callback
}

/// How a sub-agent turn runs: `foreground` inside its parent run, which waits for it; `background` as its own run.
enum SubagentTurnMode {
  foreground
