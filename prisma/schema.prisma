  updatedAt            DateTime @default(now()) @updatedAt
  settledAt            DateTime?
  binding              WorkspaceRunBinding @relation(fields: [modelRunId], references: [modelRunId], onDelete: Cascade, onUpdate: Restrict)
  toolCall             ModelRunToolCall @relation(fields: [modelRunId, toolCallId], references: [modelRunId, id], onDelete: Cascade, onUpdate: Restrict, map: "WorkspaceOutputCheckpoint_toolCall_fkey")
  capture              WorkspaceSelectedCapture? @relation(fields: [captureId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  files                WorkspaceCheckpointFile[]

  @@unique([id, captureId])
  @@unique([modelRunId, toolCallId])
  @@index([modelRunId, createdAt])
  @@index([state, updatedAt])
}

model WorkspaceCheckpointFile {
  checkpointId         String
  captureId            String @db.Char(32)
  relativePath         String @db.VarChar(512)
  attachmentId         String @unique
  checkpoint           WorkspaceOutputCheckpoint @relation(fields: [checkpointId, captureId], references: [id, captureId], onDelete: Cascade, onUpdate: Restrict)
  capturedFile         WorkspaceCapturedFile @relation(fields: [captureId, relativePath], references: [captureId, relativePath], onDelete: Cascade, onUpdate: Restrict)
  attachment           Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([checkpointId, relativePath])
}

model WorkspaceRunOutput {
  id                    String              @id @default(uuid())
  workspaceRunBindingId String
  attachmentId          String              @unique
  relativePath          String              @db.VarChar(512)
  checksum              String              @db.Char(64)
  byteSize              Int
  createdAt             DateTime            @default(now())
  workspaceRunBinding   WorkspaceRunBinding @relation(fields: [workspaceRunBindingId], references: [modelRunId], onDelete: Cascade, onUpdate: Restrict)
  attachment            Attachment          @relation(fields: [attachmentId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([workspaceRunBindingId, relativePath])
  @@index([workspaceRunBindingId, createdAt])
}

model WorkspaceExecution {
  id                   String                  @id @default(uuid())
  workspaceSessionId   String
  modelRunId           String
  modelRunToolCallId   String                  @unique
  runtimeExecSessionId String                  @db.VarChar(256)
  state                WorkspaceExecutionState @default(ACTIVE)
  startedAt            DateTime                @default(now())
  completedAt          DateTime?
  lastErrorCode        String?                 @db.VarChar(64)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  workspaceSession     WorkspaceSession        @relation(fields: [workspaceSessionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  modelRun             ModelRun                @relation(fields: [modelRunId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  modelRunToolCall     ModelRunToolCall        @relation(fields: [modelRunToolCallId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([workspaceSessionId, runtimeExecSessionId])
  @@index([modelRunId, state])
  @@index([workspaceSessionId, state])
}

model AttachmentProcessingJob {
  id            String     @id @default(uuid())
  attachmentId  String     @unique
  ownerUserId   String
  claimToken    String?
  claimedAt     DateTime?
  attemptCount  Int        @default(0)
  nextAttemptAt DateTime   @default(now())
  lastAttemptAt DateTime?
  lastErrorCode String?    @db.VarChar(64)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  /// The queue owner is processing/fairness attribution; Attachment itself owns the personal-or-Project boundary.
  attachment    Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([attachmentId, ownerUserId])
  @@index([ownerUserId, nextAttemptAt, createdAt, id], map: "AttachmentProcessingJob_owner_due_idx")
  @@index([nextAttemptAt, createdAt, ownerUserId, id], map: "AttachmentProcessingJob_due_owner_idx")
  @@index([nextAttemptAt, claimedAt, createdAt])
}

model AttachmentDeletionJob {
  id                String    @id @default(uuid())
  storageKey        String    @unique
  multipartUploadId String?
  claimToken        String?
  claimedAt         DateTime?
  attemptCount      Int       @default(0)
  lastAttemptAt     DateTime?
  lastErrorCode     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([claimedAt, createdAt])
}

model SharedChatSnapshot {
  id                   String    @id @default(uuid())
  ownerUserId          String?
  projectId            String?
  createdByDisplayName String?
  chatId               String?
  slugHash             String    @unique
  title                String
  snapshot             Json
  expiresAt            DateTime?
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())
  chat                 Chat?     @relation(fields: [chatId], references: [id], onDelete: SetNull)
  owner                User?     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  project              Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([ownerUserId, createdAt])
  @@index([projectId, createdAt])
}

model UsageEvent {
  visionAnalysis                  Boolean                        @default(false)
  visionAnalysisAttemptId          String?                        @unique
  visionAnalysisAttempt            VisionAnalysisAttempt?         @relation(fields: [visionAnalysisAttemptId], references: [toolCallId], onDelete: SetNull, onUpdate: Restrict)
  /// The usage receipt of a Knowledge run's image observation, flagged `visionAnalysis`.
  knowledgeImageObservationRunId   String?                        @unique
  knowledgeImageObservation        KnowledgeImageObservation?     @relation(fields: [knowledgeImageObservationRunId], references: [modelRunId], onDelete: SetNull, onUpdate: Restrict)
  optionalDecision                Boolean                        @default(false)
  optionalDecisionAttemptId       String?                        @unique
  optionalDecisionAttempt         OptionalDecisionAttempt?       @relation(fields: [optionalDecisionAttemptId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  knowledgeRelevance              Boolean                        @default(false)
  knowledgeRelevanceAttemptId     String?                        @unique
  knowledgeRelevanceAttempt       KnowledgeRelevanceAttempt?     @relation(fields: [knowledgeRelevanceAttemptId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  mcpHubDiscovery                  Boolean                        @default(false)
  mcpHubDiscoveryAttemptId         String?                        @unique
  mcpHubDiscoveryAttempt           McpHubDiscoveryAttempt?        @relation(fields: [mcpHubDiscoveryAttemptId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  chatTitleGeneration             Boolean                        @default(false)
  chatTitleGenerationId           String?                        @unique
  chatTitle                       ChatTitleGeneration?           @relation(fields: [chatTitleGenerationId], references: [runId], onDelete: SetNull, onUpdate: Restrict)
  imageGeneration                 Boolean                        @default(false)
  imageToolCallId                  String?                        @unique
  imageToolCall                    ModelRunToolCall?              @relation("ImageToolUsage", fields: [imageToolCallId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  chatPdfPreparation              Boolean                        @default(false)
  chatPdfPageAttemptId             String?                        @unique
  chatPdfPageAttempt               ChatPdfPageAttempt?            @relation(fields: [chatPdfPageAttemptId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  id                              String                         @id @default(uuid())
  userId                          String
  /// No default: every writer chooses. Previous-release inserts are classified by a database trigger.
  purpose                         UsagePurpose
  chatId                          String?
  modelRunId                      String?
  projectId                       String?
  provider                        String
  modelId                         String
  providerModelId                 String?
  knowledgeBaseId                 String?
  knowledgeIndexGenerationId      String?
  knowledgeDocumentVersionId      String?
  knowledgeBatchIndex             Int?
  memoryExecutionBindingId        String?                        @unique
  knowledgePdfProcessingAttemptId String?                        @unique
  operationCount                  Int?
  inputTokens                     Int?
  cachedInputTokens               Int?
  cacheWriteInputTokens           Int?
  outputTokens                    Int?
  reasoningTokens                 Int?
  totalTokens                     Int?
  usageCompleteness               TokenUsageCompleteness             @default(UNAVAILABLE)
  /// Provider-reported billed web searches this row covers; null when none were reported.
  webSearchCount                  Int?
  estimatedCostMicros             Int?
  /// A run answer row whose cost is the charge its provider reported for its calls, kept by the run's rewrites.
  costReported                    Boolean                        @default(false)
  createdAt                       DateTime                       @default(now())
  knowledgeBase                   KnowledgeBase?                 @relation("KnowledgeUsageBase", fields: [knowledgeBaseId], references: [id], onDelete: Restrict)
  knowledgeDocumentVersion        KnowledgeDocumentVersion?      @relation("KnowledgeUsageDocumentVersion", fields: [knowledgeBaseId, knowledgeDocumentVersionId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "UsageEvent_knowledgeDocumentVersion_fkey")
  knowledgeIndexGeneration        KnowledgeIndexGeneration?      @relation("KnowledgeUsageGeneration", fields: [knowledgeBaseId, knowledgeIndexGenerationId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "UsageEvent_knowledgeIndexGeneration_fkey")
  knowledgePdfProcessingAttempt   KnowledgePdfProcessingAttempt? @relation(fields: [knowledgePdfProcessingAttemptId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  modelRun                        ModelRun?                      @relation(fields: [modelRunId], references: [id], onDelete: SetNull)
  project                         Project?                       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user                            User                           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([knowledgeIndexGenerationId, knowledgeDocumentVersionId, knowledgeBatchIndex])
  @@index([chatId])
  @@index([modelRunId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([provider, modelId])
  @@index([projectId, createdAt])
  @@index([knowledgeBaseId, createdAt])
}

// One immutable Workspace image analysis dispatch per persisted tool call.
model VisionAnalysisAttempt {
  toolCallId         String    @id
  modelRunId         String
  providerBindingKey String
  requestHash        String    @db.Char(64)
  images             Json
  state              String    @default("dispatched") @db.VarChar(16)
  result             Json?
  failureCode        String?   @db.VarChar(64)
  createdAt          DateTime  @default(now())
  settledAt          DateTime?
  toolCall           ModelRunToolCall @relation(fields: [modelRunId, toolCallId], references: [modelRunId, id], onDelete: Cascade, onUpdate: Restrict, map: "VisionAnalysisAttempt_tool_fkey")
  providerBinding    ProviderRunBinding @relation(fields: [modelRunId, providerBindingKey], references: [modelRunId, bindingKey], onDelete: NoAction, onUpdate: Restrict, map: "VisionAnalysisAttempt_binding_fkey")
  usageEvent         UsageEvent?

  @@unique([modelRunId, toolCallId])
  @@index([modelRunId, createdAt])
}

/// The one frozen description of a Knowledge run's current-message images,
/// made before the grounded answer by the answer model (`answer`) or the System
/// Vision Model (`vision_analysis`). The row exists before dispatch, so a
/// dispatched description is never sent again. Results are private run content.
model KnowledgeImageObservation {
  modelRunId         String             @id
  providerBindingKey String
  requestHash        String             @db.Char(64)
  images             Json
  state              String             @default("dispatched") @db.VarChar(16)
  result             Json?
  failureCode        String?            @db.VarChar(64)
  createdAt          DateTime           @default(now())
  settledAt          DateTime?
  modelRun           ModelRun           @relation(fields: [modelRunId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  providerBinding    ProviderRunBinding @relation(fields: [modelRunId, providerBindingKey], references: [modelRunId, bindingKey], onDelete: NoAction, onUpdate: Restrict, map: "KnowledgeImageObservation_binding_fkey")
  usageEvent         UsageEvent?
}

// Content-free dispatch fences for optional interactive decisions. Results
// contain only answer aliases/scores; queries and catalog text are not retained.
model OptionalDecisionAttempt {
  id                String   @id @default(uuid())
  userId            String
  modelRunId        String?
  purpose           String   @db.VarChar(32)
  operationKey      String   @db.VarChar(128)
  inputHash         String   @db.Char(64)
  executionSnapshot Json
  state             String   @default("dispatched") @db.VarChar(16)
  answers           Json?
  failureCode       String?  @db.VarChar(128)
  createdAt         DateTime @default(now())
  settledAt         DateTime?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  modelRun          ModelRun? @relation(fields: [userId, modelRunId], references: [userId, id], onDelete: Cascade, onUpdate: Restrict)
  usageEvent        UsageEvent?

  @@unique([userId, purpose, operationKey])
  @@index([userId, createdAt])
  @@index([userId, modelRunId])
}

model Project {
  attachmentUploads   AttachmentUpload[]
  id                      String                          @id @default(uuid())
  name                    String
  description             String                          @default("")
  status                  ProjectStatus                   @default(ACTIVE)
  instructions            String                          @default("")
  instructionsRevision    Int                             @default(1)
  policy                  Json                            @default("{}")
  policyRevision          Int                             @default(1)
  defaults                Json                            @default("{}")
  accessRevision          Int                             @default(1)
  memoryEnabled           Boolean                         @default(false)
  memoryPolicy            Json                            @default("{\"automatic\":\"OFF\"}")
  memoryRevision          Int                             @default(0)
  publicSharingEnabled    Boolean                         @default(false)
  createdByUserId         String?
  createdByDisplayName    String
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt
  archivedAt              DateTime?
  deletionRequestedAt     DateTime?
  deletionLastAttemptAt   DateTime?
  deletionLastErrorCode   String?
  deletionClaimToken      String?
  deletionClaimExpiresAt  DateTime?
  assistantBindings       ProjectAssistantBinding[]
  attachments             Attachment[]
  auditEvents             ProjectAuditEvent[]
  chats                   Chat[]
  createdBy               User?                           @relation("ProjectCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  folders                 ProjectFolder[]
  grants                  ProjectGrant[]
  knowledgeBaseBindings   ProjectKnowledgeBaseBinding[]
  knowledgeSourceBindings ProjectKnowledgeSourceBinding[]
  mcpBindings             ProjectMcpBinding[]
  memoryFacts             ProjectMemoryFact[]
  memoryFactVersions      ProjectMemoryFactVersion[]
  memoryProposals         ProjectMemoryProposal[]
  memoryRunItems          ProjectMemoryRunItem[]
  modelBindings           ProjectModelBinding[]
  runBindings             ProjectRunBinding[]
  searchBindings          ProjectSearchBinding[]
  skillBindings           ProjectSkillBinding[]
  events                  ProjectEvent[]
  sharedSnapshots         SharedChatSnapshot[]
  usageEvents             UsageEvent[]

  @@index([createdByUserId])
  @@index([status, updatedAt])
}

model ProjectKnowledgeSourceBinding {
  projectId     String
  sourceId      String
  addedByUserId String?
  createdAt     DateTime        @default(now())
  addedBy       User?           @relation("ProjectKnowledgeSourceBindingAdder", fields: [addedByUserId], references: [id], onDelete: SetNull)
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source        KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([projectId, sourceId])
  @@index([addedByUserId])
  @@index([sourceId])
}

model ProjectGrant {
  id              String      @id @default(uuid())
  projectId       String
  userId          String?
  groupId         String?
  role            ProjectRole
  createdByUserId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdBy       User?       @relation("ProjectGrantCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  group           Group?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@unique([projectId, groupId])
  @@index([createdByUserId])
  @@index([groupId, projectId])
  @@index([userId, projectId])
}

model ProjectFolder {
  id              String          @default(uuid())
  projectId       String
  parentId        String?
  name            String
  sortOrder       Int             @default(0)
  createdByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  chats           Chat[]
  children        ProjectFolder[] @relation("ProjectFolderHierarchy")
  createdBy       User?           @relation("ProjectFolderCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  parent          ProjectFolder?  @relation("ProjectFolderHierarchy", fields: [projectId, parentId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@unique([projectId, parentId, name])
  @@index([createdByUserId])
  @@index([projectId, parentId, sortOrder])
}

model ProjectModelBinding {
  projectId       String
  providerModelId String
  addedByUserId   String?
  createdAt       DateTime      @default(now())
  addedBy         User?         @relation("ProjectModelBindingAdder", fields: [addedByUserId], references: [id], onDelete: SetNull)
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  providerModel   ProviderModel @relation(fields: [providerModelId], references: [id], onDelete: Restrict)

  @@id([projectId, providerModelId])
  @@index([addedByUserId])
  @@index([providerModelId])
}

model ProjectSearchBinding {
  projectId      String
  searchOptionId String
  addedByUserId  String?
  createdAt      DateTime     @default(now())
  addedBy        User?        @relation("ProjectSearchBindingAdder", fields: [addedByUserId], references: [id], onDelete: SetNull)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  searchOption   SearchOption @relation(fields: [searchOptionId], references: [id], onDelete: Restrict)

  @@id([projectId, searchOptionId])
  @@index([addedByUserId])
  @@index([searchOptionId])
}

model ProjectMcpBinding {
  projectId     String
  serverId      String
  addedByUserId String?
  createdAt     DateTime  @default(now())
  addedBy       User?     @relation("ProjectMcpBindingAdder", fields: [addedByUserId], references: [id], onDelete: SetNull)
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  server        McpServer @relation(fields: [serverId], references: [id], onDelete: Restrict)

  @@id([projectId, serverId])
  @@index([addedByUserId])
  @@index([serverId])
}

model ProjectKnowledgeBaseBinding {
  id              String        @id @default(uuid())
  projectId       String
  knowledgeBaseId String
  addedByUserId   String?
  createdAt       DateTime      @default(now())
  addedBy         User?         @relation("ProjectKnowledgeBindingAdder", fields: [addedByUserId], references: [id], onDelete: SetNull)
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Restrict)
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, knowledgeBaseId])
  @@index([addedByUserId])
  @@index([knowledgeBaseId])
}

model ProjectAssistantBinding {
  id            String              @id @default(uuid())
  projectId     String
  assistantId   String
  addedByUserId String?
  createdAt     DateTime            @default(now())
  addedBy       User?               @relation("ProjectAssistantBindingAdder", fields: [addedByUserId], references: [id], onDelete: SetNull)
  assistant     AssistantDefinition @relation(fields: [assistantId], references: [id], onDelete: Restrict)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, assistantId])
  @@index([addedByUserId])
  @@index([assistantId])
}

/// Canonical Project authority for a published Skill. The approved Skill
/// revision is resolved at admission; accepted runs retain their exact
/// revision through ModelRunSkillBinding.
model ProjectSkillBinding {
  id            String          @id @default(uuid())
  projectId     String
  skillId       String
  addedByUserId String?
  createdAt     DateTime        @default(now())
  addedBy       User?           @relation("ProjectSkillBindingAdder", fields: [addedByUserId], references: [id], onDelete: SetNull)
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill         SkillDefinition @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([projectId, skillId])
  @@index([addedByUserId])
  @@index([skillId])
}

/// Durable, content-free Project change log. `sequence` is the opaque replay
/// cursor; safe projections are reconstructed from authoritative tables.
model ProjectEvent {
  sequence       BigInt   @id @default(autoincrement())
  projectId      String
  eventType      String   @db.VarChar(64)
  entityType     String?  @db.VarChar(64)
  entityId       String?  @db.VarChar(128)
  entityRevision Int?
  accessRevision Int?
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sequence])
  @@index([createdAt])
}

model ProjectAuditEvent {
  id               String   @id @default(uuid())
  projectId        String
  actorUserId      String?
  actorDisplayName String
  eventType        String
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())
  actor            User?    @relation("ProjectAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([projectId, createdAt, id])
}

model ProjectMemoryFact {
  id                   String                     @default(uuid())
  projectId            String
  currentVersionId     String?                    @unique
  state                ProjectMemoryFactState     @default(ACTIVE)
  createdByUserId      String?
  createdByDisplayName String
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  createdBy            User?                      @relation("ProjectMemoryFactCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  currentVersion       ProjectMemoryFactVersion?  @relation("ProjectMemoryCurrentVersion", fields: [projectId, id, currentVersionId], references: [projectId, factId, id], onDelete: Restrict, onUpdate: Restrict)
  project              Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposals            ProjectMemoryProposal[]
  runItems             ProjectMemoryRunItem[]
  versions             ProjectMemoryFactVersion[] @relation("ProjectMemoryFactVersions")

  @@id([projectId, id])
  @@unique([projectId, id, currentVersionId])
  @@index([createdByUserId])
  @@index([projectId, state, updatedAt])
}

model ProjectMemoryFactVersion {
  id                   String                 @default(uuid())
  projectId            String
  factId               String
  versionNumber        Int
  text                 String
  normalizedText       String
  validUntil           DateTime?
  sourceMessageId      String?
  sourceSnapshot       Json                   @default("{}")
  createdByUserId      String?
  createdByDisplayName String
  createdAt            DateTime               @default(now())
  createdBy            User?                  @relation("ProjectMemoryVersionAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  currentFor           ProjectMemoryFact?     @relation("ProjectMemoryCurrentVersion")
  fact                 ProjectMemoryFact      @relation("ProjectMemoryFactVersions", fields: [projectId, factId], references: [projectId, id], onDelete: Cascade, onUpdate: Restrict)
  project              Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runItems             ProjectMemoryRunItem[]

  @@id([projectId, factId, id])
  @@unique([projectId, factId, versionNumber])
  @@index([createdByUserId])
  @@index([projectId, createdAt])
}

model ProjectMemoryProposal {
  id                    String                     @id @default(uuid())
  projectId             String
  proposedText          String
  normalizedText        String
  sourceMessageId       String?
  sourceSnapshot        Json                       @default("{}")
  state                 ProjectMemoryProposalState @default(PENDING)
  proposedByUserId      String?
  proposedByDisplayName String
  reviewedByUserId      String?
  reviewedByDisplayName String?
  reviewedAt            DateTime?
  resultingFactId       String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  project               Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposedBy            User?                      @relation("ProjectMemoryProposalAuthor", fields: [proposedByUserId], references: [id], onDelete: SetNull)
  reviewedBy            User?                      @relation("ProjectMemoryProposalReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  resultingFact         ProjectMemoryFact?         @relation(fields: [projectId, resultingFactId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([projectId, state, createdAt])
  @@index([proposedByUserId])
  @@index([reviewedByUserId])
}

model ProjectRunBinding {
  modelRunId                   String                 @id
  projectId                    String
  initiatorUserId              String
  acceptedRole                 ProjectRole
  accessRevision               Int
  policyRevision               Int
  instructionsRevision         Int
  memoryRevision               Int
  personalMemoryDisabled       Boolean                @default(true)
  providerAdmissionFingerprint String?
  providerConnectionId         String?
  providerModelId              String?
  providerSearchPlan           Json?
  providerRequiresClientTools  Boolean                @default(false)
  sharedCredentialVersionIds   String[]               @default([])
  createdAt                    DateTime               @default(now())
  memoryItems                  ProjectMemoryRunItem[]
  modelRun                     ModelRun               @relation(fields: [modelRunId], references: [id], onDelete: Cascade)
  project                      Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, modelRunId])
  @@index([initiatorUserId])
  @@index([projectId, createdAt])
}

model ProjectMemoryRunItem {
  projectId           String
  projectRunBindingId String
  factId              String
  factVersionId       String
  ordinal             Int
  includedText        String
  createdAt           DateTime                 @default(now())
  binding             ProjectRunBinding        @relation(fields: [projectId, projectRunBindingId], references: [projectId, modelRunId], onDelete: Cascade, onUpdate: Restrict)
  fact                ProjectMemoryFact        @relation(fields: [projectId, factId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  factVersion         ProjectMemoryFactVersion @relation(fields: [projectId, factId, factVersionId], references: [projectId, factId, id], onDelete: Restrict, onUpdate: Restrict)
  project             Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@id([projectRunBindingId, factId])
  @@unique([projectRunBindingId, ordinal])
  @@index([projectId, factId, factVersionId])
}

model UserMemorySettings {
  userId                           String                         @id
  useMemoryFacts                   Boolean                        @default(true)
