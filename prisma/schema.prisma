  embeddingModel               ProviderModel               @relation(fields: [embeddingConnectionId, embeddingProviderModelId], references: [connectionId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeRunBinding_embeddingModel_fkey")
  indexGeneration              KnowledgeIndexGeneration    @relation(fields: [knowledgeBaseId, indexGenerationId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeRunBinding_generation_fkey")
