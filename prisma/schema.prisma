  @@unique([searchStrategyId, revisionNumber])
  @@unique([searchStrategyId, draftHash, validationFingerprint], map: "SearchIntegrationRevision_strategy_draft_validation_key")
  @@unique([searchStrategyId, id])
  @@index([providerModelId])
}

model Chat {
  id                              String               @id @default(uuid())
  userId                          String?
  projectId                       String?
  projectFolderId                 String?
  createdByUserId                 String?
  createdByDisplayName            String               @default("")
  folderId                        String?
  title                           String
  activeLeafMessageId             String?
  defaultProviderModelId          String?
  defaultKnowledgePlan            Json?
  memoryMode                      MemoryChatMode       @default(NORMAL)
  memoryBranchGeneration          Int                  @default(0)
  memorySourceRevision            Int                  @default(0)
  permanentDeletionAt             DateTime?
  permanentDeletionOperationId    String?              @unique
  temporaryRetentionPolicyVersion String?              @db.VarChar(64)
  temporaryRetentionDeadline      DateTime?
  pinned                          Boolean              @default(false)
  archived                        Boolean              @default(false)
  totalInputTokens                Int                  @default(0)
  totalOutputTokens               Int                  @default(0)
  totalReasoningTokens            Int                  @default(0)
  createdAt                       DateTime             @default(now())
  updatedAt                       DateTime             @updatedAt
  /// The migration uses PostgreSQL's column-scoped SET NULL so deleting the leaf clears only activeLeafMessageId, never Chat.id.
  activeLeafMessage               Message?             @relation("ChatActiveLeaf", fields: [id, activeLeafMessageId], references: [chatId, id], onDelete: SetNull, onUpdate: Restrict, map: "Chat_id_activeLeafMessageId_fkey")
  attachments                     Attachment[]
  createdBy                       User?                @relation("ProjectChatCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  folder                          Folder?              @relation(fields: [folderId], references: [id], onDelete: SetNull)
  defaultProviderModel            ProviderModel?       @relation("ChatDefaultProviderModel", fields: [defaultProviderModelId], references: [id], onDelete: Restrict)
  messages                        Message[]            @relation("ChatMessages")
  modelRuns                       ModelRun[]
  project                         Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectFolder                   ProjectFolder?       @relation(fields: [projectId, projectFolderId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  sharedSnapshots                 SharedChatSnapshot[]
  user                            User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, id])
  @@index([activeLeafMessageId])
  @@index([defaultProviderModelId])
  @@index([memoryMode, temporaryRetentionDeadline])
  @@index([projectId, archived, updatedAt])
  @@index([projectFolderId])
  @@index([userId, permanentDeletionAt])
  @@index([userId, archived, updatedAt])
}

model Message {
  id                     String        @id @default(uuid())
  chatId                 String
  role                   String
  parentMessageId        String?
  content                Json
  groundedAt             DateTime?
  groundingProvider      String?
  groundingStrategy      String?
  provider               String?
  modelId                String?
  status                 MessageStatus @default(complete)
  inputTokens            Int           @default(0)
  outputTokens           Int           @default(0)
  reasoningTokens        Int           @default(0)
  errorMessage           String?
  authorUserId           String?
  authorDisplayName      String?
  authorProjectRole      ProjectRole?
  branchSourceModelRunId String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  assistantModelRuns     ModelRun[]    @relation("AssistantMessageRun")
  author                 User?         @relation("ProjectMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  branchSourceModelRun   ModelRun?     @relation("BranchSourceModelRun", fields: [branchSourceModelRunId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  activeLeafForChats     Chat[]        @relation("ChatActiveLeaf")
  chat                   Chat          @relation("ChatMessages", fields: [chatId], references: [id], onDelete: Cascade)
  children               Message[]     @relation("MessageBranches")
  parent                 Message?      @relation("MessageBranches", fields: [chatId, parentMessageId], references: [chatId, id], onDelete: Restrict, onUpdate: Restrict, map: "Message_chatId_parentMessageId_fkey")
  userModelRuns          ModelRun[]    @relation("UserMessageRun")

  @@unique([chatId, id], map: "Message_chatId_id_key")
  @@index([chatId, parentMessageId])
  @@index([chatId, createdAt])
  @@index([authorUserId])
  @@index([branchSourceModelRunId])
  @@index([groundingProvider, groundedAt])
}

model ModelRun {
  id                          String                              @id @default(uuid())
  chatId                      String
  userId                      String
  userMessageId               String
  assistantMessageId          String?
  assistantId                 String?
  assistantRevisionId         String?
  provider                    String
  modelId                     String
  status                      ModelRunStatus
  normalizedRequest           Json?
  providerResponseId          String?
  inputTokens                 Int                                 @default(0)
  cachedInputTokens           Int                                 @default(0)
  cacheWriteInputTokens       Int                                 @default(0)
  outputTokens                Int                                 @default(0)
  reasoningTokens             Int                                 @default(0)
  totalTokens                 Int                                 @default(0)
  estimatedCostMicros         Int                                 @default(0)
  errorPayload                Json?
  toolLoopState               Json?
  createdAt                   DateTime                            @default(now())
  updatedAt                   DateTime                            @updatedAt
  assistantMessage            Message?                            @relation("AssistantMessageRun", fields: [assistantMessageId], references: [id], onDelete: SetNull)
  branchSourceMessages        Message[]                           @relation("BranchSourceModelRun")
  /// The composite relation proves the accepted revision belongs to the accepted definition; a check constraint keeps both columns present or absent together.
  assistantRevision           AssistantRevision?                  @relation("ModelRunAssistantRevision", fields: [assistantId, assistantRevisionId], references: [assistantId, id], onDelete: Restrict, onUpdate: Restrict, map: "ModelRun_assistantRevision_fkey")
  chat                        Chat                                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  events                      ModelRunEvent[]
  mcpRunBindings              McpRunBinding[]
  knowledgeRunBindings        KnowledgeRunBinding[]
  knowledgeRunProfileBindings KnowledgeRunProfileBinding[]
  knowledgeRunSourceBindings  KnowledgeRunSourceBinding[]
  knowledgeRunScope           KnowledgeRunScope?
  knowledgeRetrievalSession   KnowledgeRetrievalSession?
  knowledgeRuns               KnowledgeRun[]
  knowledgeBudgetReservations KnowledgeBudgetReservation[]
  knowledgeProviderAttempts   KnowledgeProviderAttempt[]
  knowledgeDispatchManifests  KnowledgeEvidenceDispatchManifest[]
  memoryHistoryRuns           MemoryHistoryRun[]
  memoryToolEgressReceipts    MemoryToolEgressReceipt[]
  providerRunBindings         ProviderRunBinding[]
  projectRunBinding           ProjectRunBinding?
  searchRuns                  SearchRun[]
  skillRunBindings            ModelRunSkillBinding[]
  toolCalls                   ModelRunToolCall[]
  userMessage                 Message                             @relation("UserMessageRun", fields: [userMessageId], references: [id], onDelete: Restrict)
  usageEvents                 UsageEvent[]

  @@unique([userId, id])
  @@unique([userId, chatId, id])
  @@index([assistantId, assistantRevisionId])
  @@index([chatId, createdAt])
  @@index([provider, modelId])
  @@index([status])
  @@index([userId, createdAt])
}

model ModelRunSkillBinding {
