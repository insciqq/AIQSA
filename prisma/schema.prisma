model User {
  attachmentUploads                  AttachmentUpload[]
  runFollowups RunFollowup[]
  announcementReads AnnouncementRead[]
  artifacts Artifact[]
  artifactPublications ArtifactPublication[]
  artifactBlobs ArtifactBlob[]
  instructionPresets InstructionPreset[]
  chatContinuations ChatContinuation[]
  scheduledTasks ScheduledTask[]
  answerReviewSessions AnswerReviewSession[] @relation("AnswerReviewInitiator")
  answerProblemReports AnswerProblemReport[]
  signInRefusals SignInRefusal[]
  telegramLink TelegramLink?
  telegramLinkCodes TelegramLinkCode[]
  telegramScheduledDeliveries TelegramScheduledDelivery[]
  telegramBotControlUpdates TelegramBotControl[] @relation("TelegramBotControlUpdater")
  id                                  String                             @id @default(uuid())
  email                               String?                            @unique
  displayName                         String
  role                                UserRole                           @default(user)
  /// The external sign-in source (`<provider>:<source>`) that granted the admin role; null
  /// when the role is manual. Only that source demotes, and a manual role change clears it.
  roleManagedBy                       String?
  status                              UserStatus                         @default(pending)
  scimExternalId                      String?                            @unique
  /// When SCIM last asked to deactivate the account; with `disabled`, SCIM may reactivate it.
  /// With `active` (only an administrator no other one could replace) sign-in stays refused.
  scimDeactivatedAt                   DateTime?
  createdAt                           DateTime                           @default(now())
  updatedAt                           DateTime                           @updatedAt
  accessGrants                        AccessGrant[]
  attachments                         Attachment[]
  authAccessRulesCreated              AuthAccessRule[]                   @relation("AuthAccessRuleCreator")
  authFlowTokens                      AuthFlowToken[]
  authIdentities                      AuthIdentity[]
  authInvitesAccepted                 AuthInvite[]                       @relation("AuthInviteAcceptedUser")
  authInvitesCreated                  AuthInvite[]                       @relation("AuthInviteCreator")
  authScimTokensCreated               AuthScimToken[]                    @relation("AuthScimTokenCreator")
  authSessions                        AuthSession[]
  authSessionsRevoked                 AuthSession[]                      @relation("AuthSessionRevoker")
  authSignInMethodActivations         AuthSignInMethodSetting[]          @relation("AuthSignInMethodSettingActivator")
  authSignInMethodEdits               AuthSignInMethodSetting[]          @relation("AuthSignInMethodSettingUpdater")
  authSignInPolicyUpdates             AuthSignInPolicy[]                 @relation("AuthSignInPolicyUpdater")
  authTotpFactor                      AuthTotpFactor?
  browserPushSubscriptions            BrowserPushSubscription[]
  connectDevices                      ConnectDevice[]
  connectPairingApprovals             ConnectPairing[]                   @relation("ConnectPairingApprover")
  connectPolicyUpdates                ConnectPolicy[]                    @relation("ConnectPolicyUpdater")
  assistantDefinitions                AssistantDefinition[]              @relation("AssistantDefinitionOwner")
  assistantListingRequests            AssistantListingRequest[]          @relation("AssistantListingRequester")
  assistantListingReviews             AssistantListingRequest[]          @relation("AssistantListingReviewer")
  assistantPins                       AssistantPin[]
  assistantPublications               AssistantPublication[]             @relation("AssistantPublicationPublisher")
  chats                               Chat[]
  folders                             Folder[]
  groups                              UserGroup[]
  memoryEgressPolicyUpdates           MemoryEgressAdminPolicy[]          @relation("MemoryEgressAdminPolicyUpdater")
  inboundMcpOAuthGrants               InboundMcpOAuthGrant[]
  skillStoreOperations                SkillStoreOperation[]
  mcpHubDispatches                    McpHubDispatch[]
  mcpHubDiscoveryAttempts             McpHubDiscoveryAttempt[]
  optionalDecisionAttempts           OptionalDecisionAttempt[]
  mcpGrants                           McpGrant[]
  mcpToolGrants                       McpToolUserGrant[]
  mcpActivationJobs                   McpActivationJob[]
  mcpOAuthConnections                 McpOAuthConnection[]
  mcpOwnedServers                     McpServer[]               @relation("McpServerOwner")
  mcpUserServers                      McpUserServer[]
  mcpToolConsents                     McpToolConsent[]
  mcpToolApprovals                    McpToolApproval[]
  modelPolicyUpdates                  ModelPolicy[]                      @relation("ModelPolicyUpdater")
  providerCredentialAssignments       ProviderUserCredentialAssignment[]
  projectAttachmentsUploaded          Attachment[]                       @relation("ProjectAttachmentUploader")
  projectChatsCreated                 Chat[]                             @relation("ProjectChatCreator")
  projectMessagesAuthored             Message[]                          @relation("ProjectMessageAuthor")
  searchPolicyUpdates                 SearchPolicy[]                     @relation("SearchPolicyUpdater")
  settings                            UserSettings?
  sharedSnapshots                     SharedChatSnapshot[]
  skillDefinitions                    SkillDefinition[]                  @relation("SkillDefinitionOwner")
  subagentDefinitions                 SubagentDefinition[]               @relation("SubagentDefinitionOwner")
  skillPublications                   SkillPublication[]                 @relation("SkillPublicationPublisher")
  skillRevisionsAuthored              SkillRevision[]                    @relation("SkillRevisionAuthor")
  skillShareRequests                  SkillShareRequest[]                @relation("SkillShareRequester")
  skillShareReviews                   SkillShareRequest[]                @relation("SkillShareReviewer")
  skillPreferences                    UserSkillPreference[]
  smtpActivations                     SmtpControl[]                      @relation("SmtpControlActivator")
  smtpConfigurationEdits              SmtpControl[]                      @relation("SmtpControlUpdater")
  systemModelPolicyUpdates            SystemModelPolicy[]                @relation("SystemModelPolicyUpdater")
