  maxToolCalls    Int      @default(80)
  tokenBudget     Int      @default(2000000)
  maxOutputTokens Int      @default(16384)
  version         Int      @default(1)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       User?    @relation("AgentPolicyUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

/// Installation usage limits: a pooled monthly cap for everyone plus per-user
/// defaults, in USD micro-dollars and messages. Null means not set.
model UsageLimitPolicy {
  id                  String   @id
  monthlyCapMicros    BigInt?
  monthlyBudgetMicros BigInt?
  messagesPerHour     Int?
  messagesPerDay      Int?
  version             Int      @default(1)
  updatedByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  updatedBy           User?    @relation("UsageLimitPolicyUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

/// A group's per-member allowance or one user's override: exactly one target.
/// Only a user override may be `exempt`; a row that sets nothing is deleted.
model UsageLimit {
  id                  String   @id @default(uuid())
  groupId             String?  @unique
  userId              String?  @unique
  exempt              Boolean  @default(false)
  monthlyBudgetMicros BigInt?
  messagesPerHour     Int?
  messagesPerDay      Int?
  /// Optimistic concurrency token for administrator saves. Every insert and
  /// change takes the next value of one sequence, so a row removed and created
  /// again never repeats a version that a stale draft still holds.
  version             Int      @default(autoincrement())
  updatedByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  group               Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user                User?    @relation("UsageLimitUser", fields: [userId], references: [id], onDelete: Cascade)
  updatedBy           User?    @relation("UsageLimitUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

/// One admitted interactive run (a send, edit or regeneration; never a
/// scheduled run or the continuation of an accepted one), written with the run
/// and kept 25 hours for the message limits. Unlike ModelRun it survives chat
/// and branch deletion, so deleting chats cannot reset a limit.
model UsageMessageAdmission {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum UsageLimitAlertKind {
  installation_cap_near
  installation_cap_reached
  user_budget_reached
}

enum UsageLimitAlertState {
  claimed
  delivered
  undelivered
}

/// One budget alert to administrators per UTC month, threshold and user
/// (`userId` only for `user_budget_reached`; the unique index treats NULLs as
/// equal). The row is the claim, inserted before sending, so replicas and
/// restarts send an alert at most once. `claimed` is in flight or
/// crash-ambiguous and never retried; `undelivered` means no administrator
/// received it on any channel, so a later check may claim it again.
model UsageLimitAlert {
  id          String               @id @default(uuid())
  periodStart DateTime
  kind        UsageLimitAlertKind
  userId      String?
  state       UsageLimitAlertState @default(claimed)
  attempts    Int                  @default(1)
  claimedAt   DateTime
  settledAt   DateTime?
  user        User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([periodStart, kind, userId])
  @@index([userId])
}

