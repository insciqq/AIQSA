  imageParamsJson         Json           @default("{}")
  imageProviderModel      ProviderModel? @relation("ImageGenerationProviderModel", fields: [imageProviderModelId], references: [id], onDelete: Restrict)
  imagePublication        PublishedImageModel? @relation("DefaultImageModel", fields: [imageProviderModelId], references: [providerModelId], onDelete: Restrict, map: "SystemModelPolicy_imagePublication_fkey")
  id                      String         @id
  chatTitleProviderModelId String?
  chatTitleReasoningEffort String?        @db.VarChar(32)
  /// A saved choice, including explicit Off, closes first-setup title adoption.
  chatTitleConfiguredAt   DateTime?
  chatPdfNativeProviderModelId String?
  chatPdfNativeReasoningEffort String? @db.VarChar(32)
  visionProviderModelId   String?
  visionReasoningEffort   String?        @db.VarChar(32)
  chatPdfProviderModelId   String?
  chatPdfReasoningEffort   String?        @db.VarChar(32)
  chatPdfProcessingMode    ChatPdfProcessingMode @default(PREFER_CHAT_MODEL)
  chatPdfFallbackMethod    ChatPdfFallbackMethod @default(PAGE_IMAGES)
  /// MCP semantic routing and the existing generative reranker compatibility path.
  providerModelId         String?
  rerankerProviderModelId String?
  /// Set only by an explicit administrator save or clear of the reranker role.
  rerankerConfiguredAt    DateTime?
  decisionProviderModelId String?
  /// Explicit saves and clears prevent later automatic role adoption.
  decisionConfiguredAt    DateTime?
  /// Per-feature administrator overrides; defaults require independent qualification.
  decisionFeaturesJson    Json           @default("{}")
  /// Speech to text: a connection and an upstream model id, no ProviderModel row.
  /// Set only by a passing administrator Test & save; the tested default-key
  /// version binds the evidence, so a replaced key needs a new test.
  speechToTextConnectionId        String?
  speechToTextModelId             String?   @db.VarChar(256)
  speechToTextCredentialVersionId String?
  /// Set by every explicit save or clear; also the role's own concurrency fence.
  speechToTextConfiguredAt        DateTime?
  /// Existing installations are marked pending by the forward migration only.
  decisionAdoptionVersion Int            @default(1)
  /// Claimed before external verification; restarts never replay ambiguous probes.
  decisionAdoptionReason String?         @db.VarChar(32)
  reasoningEffort         String?        @db.VarChar(32)
  version                 Int            @default(1)
  updatedByUserId         String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  chatTitleProviderModel  ProviderModel? @relation("ChatTitleProviderModel", fields: [chatTitleProviderModelId], references: [id], onDelete: Restrict)
  chatPdfNativeProviderModel ProviderModel? @relation("ChatPdfNativeProviderModel", fields: [chatPdfNativeProviderModelId], references: [id], onDelete: Restrict)
  visionProviderModel     ProviderModel? @relation("VisionProviderModel", fields: [visionProviderModelId], references: [id], onDelete: Restrict)
  chatPdfProviderModel    ProviderModel? @relation("ChatPdfProviderModel", fields: [chatPdfProviderModelId], references: [id], onDelete: Restrict)
  providerModel           ProviderModel? @relation("SystemUtilityProviderModel", fields: [providerModelId], references: [id], onDelete: Restrict)
  rerankerProviderModel   ProviderModel? @relation("MemoryRerankerProviderModel", fields: [rerankerProviderModelId], references: [id], onDelete: Restrict)
  decisionProviderModel   ProviderModel? @relation("SemanticDecisionProviderModel", fields: [decisionProviderModelId], references: [id], onDelete: Restrict)
  updatedBy               User?          @relation("SystemModelPolicyUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([imageProviderModelId])
  @@index([providerModelId])
  @@index([rerankerProviderModelId])
  @@index([decisionProviderModelId])
  @@index([chatTitleProviderModelId])
  @@index([visionProviderModelId])
  @@index([chatPdfProviderModelId])
  @@index([chatPdfNativeProviderModelId])
  @@index([updatedByUserId])
}

