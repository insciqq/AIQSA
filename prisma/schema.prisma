}

/// The state of a sub-agent turn, and so of its thread on a branch (`lib/contracts/subagents.ts`): `running` and
/// `waiting` (for the user, such as a browser handoff) are active; every other state is final.
enum SubagentTurnState {
  running
  waiting
  done
  stopped
  failed
  interrupted
}

/// How a `done` sub-agent turn ended; `blocked` carries a stable reason (`SubagentTurn.reasonCode`).
enum SubagentOutcome {
  done
  partial
  blocked
}

/// Where a sub-agent turn's model or effort came from: the parent run's binding, the custom sub-agent, or the call.
enum SubagentBindingSource {
  parent
  type
