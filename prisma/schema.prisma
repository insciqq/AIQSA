  estimatedCandidates      Int
  estimatedRetrievedTokens Int
  estimatedEmbeddingCalls  Int
  estimatedLatencyMs       Int
  estimatedCostMicros      Int
  actualCandidates         Int?
  actualRetrievedTokens    Int?
  actualEmbeddingCalls     Int?
  actualLatencyMs          Int?
  actualCostMicros         Int?
  leaseToken               String?                         @db.VarChar(128)
  leaseExpiresAt           DateTime?
  dispatchAttemptKey       String?                         @db.VarChar(128)
