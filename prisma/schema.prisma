model Chat {
  artifactBindings  ArtifactChatBinding[]
  continuations      ChatContinuation[] @relation("SourceChatContinuation")
  continuationSource ChatContinuation?  @relation("ContinuedChat")
  continuationWorkspaceSeeds ChatContinuationWorkspaceSeed[] @relation("ContinuationWorkspaceSeedSource")
  receivedWorkspaceSeeds ChatContinuationWorkspaceSeed[] @relation("ContinuationWorkspaceSeedDestination")
  id                              String               @id @default(uuid())
  userId                          String?
  projectId                       String?
  projectFolderId                 String?
  createdByUserId                 String?
  createdByDisplayName            String               @default("")
  folderId                        String?
  title                           String
  titleRevision                   Int                  @default(0)
  titleGeneration                 ChatTitleGeneration?
  activeLeafMessageId             String?
  defaultProviderModelId          String?
  defaultKnowledgePlan            Json?
  defaultSearchPlan               Json?
  /// Lookups by Assistant use a SQL partial index over bound chats.
  assistantId                     String?
  /// Per-chat changes to adjustable Assistant rows; a present key means changed for this chat.
  assistantOverrides              Json?
  memoryMode                      MemoryChatMode       @default(NORMAL)
  memoryBranchGeneration          Int                  @default(0)
  memorySourceRevision            Int                  @default(0)
  /// Set on an imported chat and copied to its continuations and branch copies.
  /// A SQL check keeps every such chat Excluded from Memory.
  importSource                    ChatImportSource?
  /// SHA-256 of the source conversation identity (for AIQSA documents, of their
  /// canonical content). A SQL partial unique index over (userId, importSource,
  /// importSourceKey) for chats not pending deletion makes a re-import
  /// "already imported"; copies never carry it.
  importSourceKey                 String?              @db.Char(64)
  /// The source's chat-level model label, for display only.
  importSourceModel               String?              @db.VarChar(128)
  permanentDeletionAt             DateTime?
  permanentDeletionOperationId    String?              @unique
  temporaryRetentionPolicyVersion String?              @db.VarChar(64)
  temporaryRetentionDeadline      DateTime?
  pinned                          Boolean              @default(false)
  archived                        Boolean              @default(false)
  /// The scheduled task whose run created this chat: only such chats fall
  /// under that task's history retention. Deleting the task makes it an
  /// ordinary chat (the migration's column-scoped SET NULL).
  scheduledTaskId                 String?
  /// The owner renamed this chat or restored it from the archive; a scheduled
  /// task's history retention keeps such a chat.
  ownerKeptAt                     DateTime?
  workspaceEnabled                Boolean              @default(false)
  /// The chat's automatic answer review (`AnswerReviewAutoConfig`); null is off.
  answerReviewConfig              Json?
  totalInputTokens                Int                  @default(0)
  totalOutputTokens               Int                  @default(0)
  totalReasoningTokens            Int                  @default(0)
  createdAt                       DateTime             @default(now())
  updatedAt                       DateTime             @updatedAt
  /// The migration uses PostgreSQL's column-scoped SET NULL so deleting the leaf clears only activeLeafMessageId, never Chat.id.
  activeLeafMessage               Message?             @relation("ChatActiveLeaf", fields: [id, activeLeafMessageId], references: [chatId, id], onDelete: SetNull, onUpdate: Restrict, map: "Chat_id_activeLeafMessageId_fkey")
  assistant                       AssistantDefinition? @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  attachments                     Attachment[]
  createdBy                       User?                @relation("ProjectChatCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  folder                          Folder?              @relation(fields: [folderId], references: [id], onDelete: SetNull)
  defaultProviderModel            ProviderModel?       @relation("ChatDefaultProviderModel", fields: [defaultProviderModelId], references: [id], onDelete: Restrict)
  messages                        Message[]            @relation("ChatMessages")
  memoryToolEvents                MemoryToolEvent[]
  modelRuns                       ModelRun[]
  project                         Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectFolder                   ProjectFolder?       @relation(fields: [projectId, projectFolderId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  sharedSnapshots                 SharedChatSnapshot[]
  user                            User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceSession                WorkspaceSession?
  scheduledTasks                  ScheduledTask[]           @relation("ScheduledTaskChat")
  scheduledTaskOccurrences        ScheduledTaskOccurrence[]
  /// The migration uses column-scoped SET NULL so task deletion never clears userId.
  scheduledTask                   ScheduledTask?            @relation("ScheduledTaskCreatedChats", fields: [userId, scheduledTaskId], references: [userId, id], onDelete: SetNull, onUpdate: Restrict)
  scheduledTaskCarryovers         ScheduledTaskCarryover[]
  answerReviewSessions            AnswerReviewSession[]

  @@unique([userId, id])
  @@index([activeLeafMessageId])
  @@index([defaultProviderModelId])
  @@index([scheduledTaskId])
  @@index([memoryMode, temporaryRetentionDeadline])
  @@index([projectId, archived, updatedAt])
  @@index([projectFolderId])
  @@index([userId, permanentDeletionAt])
  @@index([userId, archived, updatedAt])
  @@index([userId, assistantId, updatedAt])
}

