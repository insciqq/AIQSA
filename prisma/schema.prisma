enum ScheduledTaskScheduleKind {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  HOURLY
}

enum ScheduledTaskChatMode {
  NEW
  SAME
}

enum ScheduledTaskKind {
  STANDARD
  MONITORING
}

enum ScheduledTaskStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum ScheduledTaskOccurrenceState {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

/// A personal prompt the scheduler posts into chats (an automation). Schedule
/// columns are wall-clock values in `timeZone`; lib/domain/scheduledTaskSchedule.ts
/// computes `nextRunAt`, which is null unless ACTIVE and while the schedule is
/// off. Model identity is revalidated at save and run, never a foreign key.
/// `revision` changes on every owner mutation and on runner status transitions
/// (auto-pause, once completion, a monitoring goal), not on bookkeeping
/// (`nextRunAt`, the counters, `chatId` with its epoch and period, the baseline
/// and its carried copy).
model ScheduledTask {
  id                         String                    @id @default(uuid())
  userId                     String
  title                      String                    @db.VarChar(120)
  prompt                     String
  /// SHA-256 digests of the prompt's normalized http(s) links its runs may read
  /// with `fetch_url`: every link of an owner-written prompt, only already
  /// user-authorized ones of a tool-written prompt (`scheduledPromptUrlDigests`).
  /// Replaced with every write of the prompt; at most 100.
  promptUrlDigests           String[]                  @default([])
  /// The automation runs on its schedule. Off, `nextRunAt` stays null and the
  /// schedule columns only keep the editor's values, which never fire. At least
  /// one trigger is on.
  scheduleEnabled            Boolean                   @default(true)
  /// Every event its webhook (`ScheduledTaskWebhook`) accepts runs the
  /// automation. Rows older than the switch stay off.
  webhookEnabled             Boolean                   @default(false)
  scheduleKind               ScheduledTaskScheduleKind
  /// Local wall-clock minute of the day, 0..1439; HOURLY: the window start (0 for the whole day).
  timeOfDayMinutes           Int
  /// ISO weekdays, Monday = bit 0 .. Sunday = bit 6; 0 unless WEEKLY or HOURLY.
  daysOfWeekMask             Int                       @default(0)
  /// 1..31 for MONTHLY, clamped to the month's last day; otherwise null.
  dayOfMonth                 Int?
  /// Local `YYYY-MM-DD` for ONCE; otherwise null.
  onceLocalDate              String?                   @db.VarChar(10)
  /// HOURLY only: the nominal interval, 1, 2, 3, 4, 6, 8 or 12 hours.
  everyHours                 Int?
  /// HOURLY only: the inclusive window end after `timeOfDayMinutes`; null runs through the end of the day.
  untilMinutes               Int?
  timeZone                   String                    @db.VarChar(64)
  modelId                    String                    @db.VarChar(256)
  provider                   String                    @db.VarChar(256)
  searchEnabled              Boolean                   @default(false)
  emailNotify                Boolean                   @default(false)
  /// Results go to the owner's linked Telegram chat with their content (`TelegramScheduledDelivery`).
  telegramNotify             Boolean                   @default(false)
  /// The owner's MCP tools and Skills, both in Auto mode; needs a tool-calling model.
  toolsEnabled               Boolean                   @default(false)
  /// The task chat's Workspace; needs a tool-calling model. A run never changes an existing chat's switch.
  workspaceEnabled           Boolean                   @default(false)
  /// Runs read the owner's Memory without ever adding to it. New tasks are
  /// created with it on; rows older than the switch stay off.
  memoryEnabled              Boolean                   @default(false)
  /// Skill ids every run loads at their current revision besides the Auto
  /// catalog: at most 4, unique, only with `toolsEnabled`. Plain identifiers,
  /// rechecked against the owner's available Skills at save and every run; a
  /// lost one pauses the task (`skill_unavailable`), never a foreign key.
  pinnedSkillIds             String[]                  @default([])
  /// NEW starts a chat for every run; SAME continues the task's chat (always for
  /// HOURLY and MONITORING) and starts a new one each calendar month.
  chatMode                  ScheduledTaskChatMode     @default(NEW)
  /// Days a chat the task created is kept after its last run once it is no
  /// longer the task's chat: 30, 90 or 365; null keeps it forever. The owner
  /// API, the editor and the chat tools give new tasks 90; rows older than the
  /// field stay null, so nothing that existed before it is deleted.
  historyRetentionDays       Int?
  /// Old task chats the history retention deleted; a content-free count.
  historyDeletedChats        Int                       @default(0)
  /// MONITORING runs are checks that report through a built-in tool whether
  /// anything changed; checks without news stay hidden and silent.
  kind                       ScheduledTaskKind         @default(STANDARD)
  status                     ScheduledTaskStatus       @default(ACTIVE)
  /// Stable code of an automatic pause; null for owner pauses and other states.
  pauseReason                String?                   @db.VarChar(64)
  /// Stable code of a runner completion (`goal_reached`); null for a once
  /// task's single run and in other states.
  completionReason           String?                   @db.VarChar(64)
  nextRunAt                  DateTime?
  /// The newest chat a run used; deleting the chat clears only this column.
  chatId                     String?
  /// Bumped whenever a run's admission moves the task to another chat and
  /// frozen on the occurrence it links: a link succeeds only under the epoch
  /// the runner read, and a settlement writes the baseline only under its own.
  chatEpoch                  Int                       @default(0)
  /// The calendar month (`YYYY-MM`, task zone) whose runs the current chat
  /// takes; a same-chat run of a later month starts a new chat. Null until a
  /// run links (and for chats older than the field, which adopt their month).
  chatPeriod                 String?                   @db.VarChar(7)
  consecutiveFailures        Int                       @default(0)
  /// Scheduled runs in a row that completed without a relevant source; reset by a complete run or an owner edit.
  consecutiveIncompleteRuns  Int                       @default(0)
  /// Scheduled monitoring checks in a row whose model reported no outcome.
  consecutiveMissingVerdicts Int                       @default(0)
  revision                  Int                       @default(1)
  /// Bumped with the revision when the prompt, the schedule kind or the task
  /// kind changes; frozen on accepted occurrences and runs.
  generation                 Int                       @default(1)
  /// The newest shown completed result of the current generation in the
  /// current chat: what the next same-chat run sees besides the prompt. Plain
  /// identifiers, rechecked against the run's chat path at every admission;
  /// all four or none. A rotation clears them (its copy carries the result).
  baselineRunId              String?
  baselineUserMessageId      String?
  baselineAssistantMessageId String?
  baselineGeneration         Int?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The migration uses column-scoped SET NULL so chat deletion never clears userId.
  chat                Chat?                     @relation("ScheduledTaskChat", fields: [userId, chatId], references: [userId, id], onDelete: SetNull, onUpdate: Restrict)
  occurrences         ScheduledTaskOccurrence[]
  createdChats        Chat[]                    @relation("ScheduledTaskCreatedChats")
  carryover           ScheduledTaskCarryover?
  workspaceSeeds      ChatContinuationWorkspaceSeed[]
  webhook             ScheduledTaskWebhook?
  webhookEvents       ScheduledTaskWebhookEvent[]

  @@unique([userId, id])
  @@index([status, nextRunAt])
  @@index([userId, createdAt])
  @@index([chatId])
}

/// One scheduled instant or manual request of a task, filled by the runner.
/// Content-free: identifiers, timestamps and stable codes only.
model ScheduledTaskOccurrence {
  id             String                       @id @default(uuid())
  taskId         String
  userId         String
  /// `schedule`, `manual` or `webhook`.
  trigger        String                       @db.VarChar(16)
  /// The scheduled instant, the time of a manual request, or for a webhook
  /// occurrence its event's `receivedAt`, which is unique per task, so
  /// `[taskId, trigger, scheduledFor]` stays unique for webhook occurrences too.
  scheduledFor   DateTime
  state          ScheduledTaskOccurrenceState @default(PENDING)
  reasonCode     String?                      @db.VarChar(64)
  chatId         String?
  userMessageId  String?
  runId          String?
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  /// Set exactly when the state is COMPLETED, FAILED or SKIPPED.
  finishedAt     DateTime?
  notifiedAt     DateTime?
  /// The task generation frozen when a run accepted this occurrence.
  taskGeneration Int?
  /// The task revision a run accepted this occurrence under; a goal completes
  /// the task only while it is unchanged.
  taskRevision   Int?
  /// The task's chat epoch after the run's admission linked this occurrence.
  chatEpoch      Int?
  /// A monitoring check's model-reported outcome (`update`, `no_update` or
  /// `goal_reached`); the last report of the run wins, null when it never reported.
  verdict        String?                      @db.VarChar(16)
  /// A settled result the owner has not seen yet: a finished answer or a failure that paused the task.
  unseenAt       DateTime?
  /// Frozen when a run accepted this occurrence: the relevant personal sources its Auto
  /// plan could not offer, `[{ serverId, name, reason, relied }]`; null when none was
  /// missing. Such a run is incomplete. Display names only, never tool content.
  unavailableSources Json?
  /// When the occurrence first waited for a scheduled Workspace slot; kept after
  /// the wait ends, for the administrator's content-free capacity counts.
  workspaceWaitStartedAt DateTime?
  createdAt      DateTime                     @default(now())
  task           ScheduledTask                @relation(fields: [userId, taskId], references: [userId, id], onDelete: Cascade, onUpdate: Restrict)
  /// The migration uses column-scoped SET NULL for chat and run references.
  chat           Chat?                        @relation(fields: [userId, chatId], references: [userId, id], onDelete: SetNull, onUpdate: Restrict)
  userMessage    Message?                     @relation(fields: [userMessageId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  run            ModelRun?                    @relation(fields: [userId, runId], references: [userId, id], onDelete: SetNull, onUpdate: Restrict)
  browserPushDelivery BrowserPushDelivery?
  telegramDelivery    TelegramScheduledDelivery?
  webhookEvent        ScheduledTaskWebhookEvent?

  @@unique([taskId, trigger, scheduledFor])
  /// The task-consistent key a webhook event's link references.
  @@unique([taskId, id])
  @@index([taskId, scheduledFor])
  @@index([state, leaseExpiresAt])
  @@index([chatId])
  @@index([runId])
  @@index([userMessageId])
}

/// A same-chat task's previous shown result carried into the chat its monthly
/// rotation started: a bounded frozen copy of the answer text (the prompt is
/// the task's own for the same generation) with the servers it relied on,
/// owned by the task's owner. Written in the run creation that starts the new
/// chat, never as message ids of the old chat; a run sees it only while its
/// epoch and generation are current and its source answer is still there.
/// It goes once the new chat has its own shown result, with the task, and
/// with its source answer or chat.
model ScheduledTaskCarryover {
  taskId                   String                 @id
  userId                   String
  /// The task's chat epoch the copy was frozen for: the chat that rotation started.
  chatEpoch                Int
  /// The generation of the copied result; another generation never sees it.
  taskGeneration           Int
  sourceChatId             String
  sourceAssistantMessageId String
  answerText               String
  /// Personal MCP servers the copied result called or relied on, as source
  /// health judges a previous result; plain identifiers.
  reliedServerIds          String[]               @default([])
  createdAt                DateTime               @default(now())
  task                     ScheduledTask          @relation(fields: [userId, taskId], references: [userId, id], onDelete: Cascade, onUpdate: Restrict)
  sourceChat               Chat                   @relation(fields: [userId, sourceChatId], references: [userId, id], onDelete: Cascade, onUpdate: Restrict)
  sourceAnswer             Message                @relation(fields: [sourceChatId, sourceAssistantMessageId], references: [chatId, id], onDelete: Cascade, onUpdate: Restrict, map: "ScheduledTaskCarryover_source_answer_fkey")

  /// The owner-consistent key of the one-to-one task relation.
  @@unique([userId, taskId])
  @@index([sourceChatId, sourceAssistantMessageId], map: "ScheduledTaskCarryover_source_answer_idx")
}

/// An automation's webhook: the public address senders post events to and the
/// hash of its one bearer token. Created the first time the webhook trigger is
/// turned on and kept while it is off, so the address stays the same; it goes
/// with the automation and its owner.
model ScheduledTaskWebhook {
  taskId        String        @id
  userId        String
  /// Random, server-generated base64url (`SCHEDULED_TASK_WEBHOOK_PUBLIC_ID_BYTES`);
  /// never the task id. The endpoint's only path parameter.
  publicId      String        @unique @db.VarChar(22)
  /// Hex SHA-256 of the whole token (`SCHEDULED_TASK_WEBHOOK_TOKEN_PREFIX` and its
  /// random part); null until the owner first gets one. Rotation replaces it with
  /// `tokenIssuedAt`. The plaintext is never stored.
  tokenHash     String?       @db.Char(64)
  tokenIssuedAt DateTime?
  /// When the endpoint last accepted an event.
  lastEventAt   DateTime?
  createdAt     DateTime      @default(now())
  task          ScheduledTask @relation(fields: [userId, taskId], references: [userId, id], onDelete: Cascade, onUpdate: Restrict)

  /// The owner-consistent key of the one-to-one task relation.
  @@unique([userId, taskId])
}

enum ScheduledTaskWebhookEventState {
  QUEUED
  ADMITTED
  DISCARDED
}

/// One event a webhook accepted. QUEUED holds the body until its occurrence's
/// run is admitted (ADMITTED: the body then lives only in that chat) or it can
/// no longer run (DISCARDED); either clears the body. Bodyless rows stay for
/// deduplication and the rate cap (`SCHEDULED_TASK_WEBHOOK_EVENT_RETENTION_MS`)
/// and go with the automation and its owner.
model ScheduledTaskWebhookEvent {
  id           String                         @id @default(uuid())
  taskId       String
  userId       String
  /// The later of the acceptance time and the task's previous event plus one
  /// millisecond, written under the task row lock: unique per task, the queue's
  /// order and its occurrence's `scheduledFor`.
  receivedAt   DateTime
  /// The sender's delivery key (`X-Gitlab-Event-UUID`, `X-GitHub-Delivery` or
  /// `Idempotency-Key`); a repeat is not accepted again while the row is kept.
  dedupeKey    String?                        @db.VarChar(200)
  /// The `X-Gitlab-Event` or `X-GitHub-Event` header as sent; untrusted.
  eventName    String?                        @db.VarChar(100)
  /// The request's media type, lowercased, without parameters.
  contentType  String?                        @db.VarChar(100)
  /// The event text (JSON pretty-printed), set exactly while QUEUED.
  bodyText     String?
  state        ScheduledTaskWebhookEventState @default(QUEUED)
  /// The occurrence of the same task the event became; the migration uses
  /// column-scoped SET NULL, so pruning the occurrence history keeps the row.
  occurrenceId String?
  task         ScheduledTask                  @relation(fields: [userId, taskId], references: [userId, id], onDelete: Cascade, onUpdate: Restrict)
  occurrence   ScheduledTaskOccurrence?       @relation(fields: [taskId, occurrenceId], references: [taskId, id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([taskId, receivedAt])
  @@unique([taskId, dedupeKey])
  /// At most one event per occurrence: the link names an occurrence of the same task.
  @@unique([taskId, occurrenceId])
  @@index([taskId, state, receivedAt])
  @@index([receivedAt])
}

/// The installation's VAPID key pair for browser push, created on first use.
/// The private key is an `AIQSA_ENCRYPTION_KEY` envelope.
model BrowserPushVapidKey {
  id                 String   @id
  publicKey          String   @db.VarChar(128)
  privateKeyEnvelope String
  createdAt          DateTime @default(now())
}

/// One browser push subscription of one signed-in device. It is bound to the
/// session that registered it and leaves with that session's revocation.
model BrowserPushSubscription {
  id            String      @id @default(uuid())
  userId        String
  sessionId     String
  endpoint      String      @unique @db.VarChar(2048)
  p256dh        String      @db.VarChar(128)
  auth          String      @db.VarChar(64)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  failureCount  Int         @default(0)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       AuthSession @relation(fields: [userId, sessionId], references: [userId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId, updatedAt])
  @@index([sessionId])
}

/// At most one browser push per run or scheduled occurrence: the claim row is
/// written before any delivery.
model BrowserPushDelivery {
  id           String                   @id
  runId        String?                  @unique
  occurrenceId String?                  @unique
  claimedAt    DateTime                 @default(now())
  run          ModelRun?                @relation(fields: [runId], references: [id], onDelete: Cascade)
  occurrence   ScheduledTaskOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
}

/// The installation switch for AIQSA Connect, off until an administrator turns it on.
model ConnectPolicy {
  id              String   @id
  enabled         Boolean  @default(false)
  version         Int      @default(1)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       User?    @relation("ConnectPolicyUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

/// A computer paired with its owner's account for AIQSA Connect. Only the
/// SHA-256 of its bearer token is stored; deleting the row revokes it.
/// Terminal sessions and their output never reach the database.
model ConnectDevice {
  id            String    @id @default(uuid())
  userId        String
  name          String    @db.VarChar(64)
  hostname      String    @db.VarChar(255)
  os            String    @db.VarChar(16)
  arch          String    @db.VarChar(16)
  clientVersion String    @db.VarChar(64)
  tokenHash     String    @unique @db.Char(64)
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A pending device pairing: the computer polls with its secret until the
/// signed-in owner approves or denies the code it shows. Only hashes of the
/// code and the poll secret are stored; the first poll after approval creates
/// the device and consumes the pairing.
model ConnectPairing {
  id             String    @id @default(uuid())
  userCodeHash   String    @unique @db.Char(64)
  pollSecretHash String    @db.Char(64)
  name           String    @db.VarChar(64)
  hostname       String    @db.VarChar(255)
  os             String    @db.VarChar(16)
  arch           String    @db.VarChar(16)
  clientVersion  String    @db.VarChar(64)
  approvedUserId String?
  deniedAt       DateTime?
  consumedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  approvedUser   User?     @relation("ConnectPairingApprover", fields: [approvedUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt, consumedAt])
  @@index([approvedUserId])
}

/// Operator health telemetry: hourly totals of this installation's validated,
/// content-free log records per process role, event, level and version.
/// Dimensions hold only allowlisted bounded record fields (outcomes, codes,
/// statuses, provider connection and model ids, route templates), never user,
/// run, job or trace identities, request data or payloads.
model TelemetryCounter {
  bucketStart     DateTime
  role            String   @db.VarChar(32)
  event           String   @db.VarChar(64)
  level           String   @db.VarChar(8)
  appVersion      String   @db.VarChar(64)
  dimensionHash   String   @db.Char(64)
  dimensions      Json
  count           BigInt
  valueSum        BigInt
  durationCount   BigInt
  durationSumMs   BigInt
  durationMaxMs   BigInt?
  durationBuckets BigInt[]
  firstSeenAt     DateTime
  lastSeenAt      DateTime

  @@id([bucketStart, role, event, level, appVersion, dimensionHash])
  @@index([event, bucketStart])
}

/// Operator health telemetry: a rate-limited, retention-bounded sample of
/// recent error and fatal log records, holding only the validated record's
/// content-free fields.
model TelemetryIncident {
  id           String   @id @default(uuid())
  occurredAt   DateTime
  role         String   @db.VarChar(32)
  event        String   @db.VarChar(64)
  level        String   @db.VarChar(8)
  appVersion   String   @db.VarChar(64)
  instanceId   String   @db.Char(32)
  code         String?  @db.VarChar(128)
  subsystem    String?  @db.VarChar(64)
  connectionId String?  @db.VarChar(128)
  runId        String?  @db.VarChar(128)
  traceId      String?  @db.Char(32)
  /// The user the record's request, run or job belonged to. No foreign key:
  /// account deletion clears it, and a write never fails on a deleted account.
  userId       String?  @db.VarChar(128)
  details      Json

  @@index([occurredAt, id])
  @@index([runId])
  @@index([traceId])
  @@index([userId])
}

enum TelegramUpdateReceiptState {
  claimed
  done
  failed
}

/// Server-owned kinds of inline buttons (`TELEGRAM_CALLBACK_KINDS`).
enum TelegramCallbackKind {
  approval_allow_once
  approval_allow_server
  approval_deny
  select_chat
  select_assistant
  select_model
  model_page
  toggle_search
  toggle_workspace
  // The removed Codex Agent's toggle: its old buttons have no handler and answer as expired.
  toggle_agent
  stop_run
  unlink_confirm
  open_settings
}

enum TelegramRunDeliveryState {
  pending
  claimed
  delivered
  failed
  unknown
}

enum TelegramScheduledDeliveryState {
  pending
  sent
  failed
  unknown
  skipped
}

/// Telegram Connect: the installation's one bot. The administrator's switch and
/// access mode, the write-only bot token as an `AIQSA_ENCRYPTION_KEY` envelope
/// bound to its generation, the bot's identity, the durable long-poll offset and
/// content-free poll health. Checks keep the row a singleton and the token,
/// generation and bot identity consistent.
model TelegramBotControl {
  id              String    @id
  enabled         Boolean   @default(false)
  /// False opens Telegram to every active user; true only to active members of the listed groups.
  restricted      Boolean   @default(false)
  tokenEnvelope   String?
  /// Bumped with every saved token, whose envelope it binds; zero before the first one.
  tokenGeneration Int       @default(0)
  botId           BigInt?
  botUsername     String?   @db.VarChar(64)
  /// The next `getUpdates` offset of `botId`, advanced only once the updates before it are claimed.
  updateOffset    BigInt?
  lastPollAt      DateTime?
  lastSuccessAt   DateTime?
  lastFailureAt   DateTime?
  lastFailureCode String?   @db.VarChar(64)
  version         Int       @default(1)
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  updatedBy       User?     @relation("TelegramBotControlUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

/// A group whose active members may use Telegram while the bot is restricted.
model TelegramBotGroup {
  groupId   String   @id
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

/// A one-time code linking the Telegram account that opens the bot's deep link to
/// the account and live session that created it. Only its SHA-256 hash is kept.
model TelegramLinkCode {
  id            String      @id @default(uuid())
  userId        String
  authSessionId String
  botId         BigInt
  codeHash      String      @unique @db.Char(64)
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  authSession   AuthSession @relation(fields: [userId, authSessionId], references: [userId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([expiresAt, consumedAt])
  @@index([userId, authSessionId])
}

/// A user's Telegram account: one per user, and one user per Telegram account of a
/// bot. Its username and display name live only here and leave with it.
model TelegramLink {
  id                 String               @id @default(uuid())
  userId             String               @unique
  botId              BigInt
  telegramUserId     BigInt
  /// The private chat with the bot; a check keeps it positive.
  telegramChatId     BigInt
  telegramUsername   String?              @db.VarChar(64)
  displayName        String?              @db.VarChar(128)
  /// The AIQSA chat the next message continues; deleting that chat clears only this column.
  currentChatId      String?
  pendingAssistantId String?
  selectedModelId    String?              @db.VarChar(256)
  selectedProvider   String?              @db.VarChar(256)
  searchEnabled      Boolean              @default(true)
  workspaceEnabled   Boolean              @default(false)
  /// Retired with the Codex Agent (operator decision 2026-10-23): nothing reads
  /// or writes it, and a later release drops it once no running app selects it.
  agentEnabled       Boolean              @default(false)
  linkedAt           DateTime             @default(now())
  lastSeenAt         DateTime             @default(now())
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The migration uses column-scoped SET NULL so chat deletion never clears userId.
  currentChat        Chat?                @relation("TelegramLinkCurrentChat", fields: [userId, currentChatId], references: [userId, id], onDelete: SetNull, onUpdate: Restrict)
  pendingAssistant   AssistantDefinition? @relation(fields: [pendingAssistantId], references: [id], onDelete: SetNull)
  callbacks          TelegramCallback[]
  messageRefs        TelegramMessageRef[]
  runLinks           TelegramRunLink[]

  @@unique([id, userId])
  @@unique([botId, telegramUserId])
  @@index([botId, telegramChatId])
  @@index([pendingAssistantId])
}

/// One update the poller claimed before handling it; a claimed update is never
/// handled again, even after a restart. Content-free.
model TelegramUpdateReceipt {
  botId      BigInt
  updateId   BigInt
  /// The update type (`message`, `callback_query`, …, `other`, `invalid`).
  kind       String                     @db.VarChar(32)
  state      TelegramUpdateReceiptState @default(claimed)
  receivedAt DateTime                   @default(now())

  @@id([botId, updateId])
  @@index([receivedAt])
}

/// One inline button; its callback data is `c:` and this id (128 random bits).
/// The payload holds identifiers only.
model TelegramCallback {
  id         String               @id @db.Char(22)
  linkId     String
  kind       TelegramCallbackKind
  payload    Json
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime             @default(now())
  link       TelegramLink         @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([expiresAt])
}

/// A bot message carrying an AIQSA chat's content, so a reply to it continues that chat.
model TelegramMessageRef {
  botId             BigInt
  telegramChatId    BigInt
  telegramMessageId BigInt
  linkId            String
  userId            String
  chatId            String
  messageId         String?
  createdAt         DateTime     @default(now())
  link              TelegramLink @relation(fields: [linkId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict)
  chat              Chat         @relation(fields: [userId, chatId], references: [userId, id], onDelete: Cascade, onUpdate: Restrict)
  message           Message?     @relation(fields: [chatId, messageId], references: [chatId, id], onDelete: Cascade, onUpdate: Restrict)

  @@id([botId, telegramChatId, telegramMessageId])
  @@index([linkId, userId])
  @@index([userId, chatId])
  @@index([chatId, messageId])
  @@index([createdAt])
}

/// A run a Telegram message started: the chat its answer goes to and whether it
/// was delivered. Runs never carry Telegram columns themselves.
model TelegramRunLink {
  runId           String                   @id
  userId          String
  linkId          String
  telegramChatId  BigInt
  draftId         Int
  statusMessageId BigInt?
  deliveryState   TelegramRunDeliveryState @default(pending)
  deliveredAt     DateTime?
  createdAt       DateTime                 @default(now())
  run             ModelRun                 @relation(fields: [userId, runId], references: [userId, id], onDelete: Cascade, onUpdate: Restrict)
  link            TelegramLink             @relation(fields: [linkId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Restrict)

  @@index([linkId, userId])
  @@index([deliveryState, createdAt])
}

/// The durable outbox of scheduled task results bound for Telegram: one row per occurrence.
model TelegramScheduledDelivery {
  id              String                         @id @default(uuid())
  occurrenceId    String                         @unique
  userId          String
  state           TelegramScheduledDeliveryState @default(pending)
  attempts        Int                            @default(0)
  nextAttemptAt   DateTime                       @default(now())
  lastFailureCode String?                        @db.VarChar(64)
  createdAt       DateTime                       @default(now())
  sentAt          DateTime?
  occurrence      ScheduledTaskOccurrence        @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  user            User                           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, nextAttemptAt])
  @@index([userId])
  @@index([createdAt])
}
