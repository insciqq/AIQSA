  embeddingCredentialVersion   ProviderCredentialVersion     @relation(fields: [embeddingCredentialId, embeddingCredentialVersionId], references: [credentialId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeRunProfileBinding_credentialVersion_fkey")
  embeddingModel               ProviderModel                 @relation(fields: [embeddingConnectionId, embeddingProviderModelId], references: [connectionId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeRunProfileBinding_embeddingModel_fkey")
