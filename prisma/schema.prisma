model McpUserServer {
  id                         String                 @id @default(uuid())
  serverId                   String
  userId                     String
  enabled                    Boolean                @default(false)
  personalConfigEnvelope     String?
  personalConfigVersion      Int                    @default(0)
  /// Tools the owner switched off; every other upstream tool is available.
  /// Bounded by a CHECK (cardinality <= 1024) in the migration.
  userDisabledToolNames      String[]               @default([])
  discoveredInventory        Json?
  discoveredRevisionId       String?
  discoveredOAuthConnectionId String?
  desiredRuntimeGenerationId String?                @unique
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  desiredRuntimeGeneration   McpRuntimeGeneration?  @relation("McpDesiredRuntimeGeneration", fields: [desiredRuntimeGenerationId], references: [id], onDelete: SetNull)
  discoveredOAuthConnection  McpOAuthConnection?    @relation("McpUserServerDiscoveredOAuthConnection", fields: [discoveredOAuthConnectionId], references: [id], onDelete: SetNull)
  discoveredRevision         McpRevision?           @relation("McpUserServerDiscoveredRevision", fields: [discoveredRevisionId], references: [id], onDelete: SetNull)
  runtimeGenerations         McpRuntimeGeneration[] @relation("McpUserRuntimeGenerations")
  server                     McpServer              @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user                       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([userId, enabled])
  @@index([discoveredOAuthConnectionId])
  @@index([discoveredRevisionId])
}

/// "Always allow for this server": the user's standing consent to MCP tools
/// of one server (installation or personal, both `McpServer`) that may change
/// data. Interactive runs freeze the consents at admission, so a revocation
/// applies to runs admitted after it.
model McpToolConsent {
  id        String              @id @default(uuid())
  userId    String
  serverId  String
  scope     McpToolConsentScope @default(server_always)
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  server    McpServer           @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([serverId])
}

/// One MCP call refused for lack of its run initiator's approval: the card's
/// request and, once decided, the decision. An Allow once is a one-shot
/// approval: one later run of the same chat may dispatch one call with the
/// same server, tool, definition and canonical arguments before `expiresAt`;
/// a tool-loop call consumes it in its claim transaction. Content-free:
/// digests and display names, never arguments or results.
model McpToolApproval {
  id              String                   @id @default(uuid())
  userId          String
  chatId          String
  modelRunId      String
  /// The refused call of the run's tool loop or Agent gateway; null for guest code.
  toolCallId      String?
  source          McpToolApprovalSource
  serverId        String
  serverName      String                   @db.VarChar(160)
  /// The namespaced tool name the run called.
  toolName        String                   @db.VarChar(256)
  toolTitle       String                   @db.VarChar(160)
  definitionHash  String                   @db.Char(64)
  argumentsDigest String                   @db.Char(64)
  decision        McpToolApprovalDecision?
  decisionNonce   String?                  @db.VarChar(128)
  decidedAt       DateTime?
  expiresAt       DateTime?
  consumedAt      DateTime?
  consumedByRunId String?
  createdAt       DateTime                 @default(now())
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelRun        ModelRun                 @relation(fields: [userId, chatId, modelRunId], references: [userId, chatId, id], onDelete: Cascade, onUpdate: Restrict, map: "McpToolApproval_modelRun_fkey")
  toolCall        ModelRunToolCall?        @relation(fields: [modelRunId, toolCallId], references: [modelRunId, id], onDelete: NoAction, onUpdate: Restrict, map: "McpToolApproval_toolCall_fkey")
  server          McpServer                @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([modelRunId, createdAt])
  @@index([userId, chatId, serverId, toolName, argumentsDigest])
  @@index([modelRunId, toolCallId])
  @@index([serverId])
}

/// The installation-owned runtime Project runs use for one server: no user,
/// preference, OAuth identity or personal value. `requestedAt` records the last
/// Project demand, so member activity never decides its lifetime.
model McpSharedRuntime {
  serverId                   String                 @id
  desiredRuntimeGenerationId String?                @unique
  requestedAt                DateTime               @default(now())
  desiredRuntimeGeneration   McpRuntimeGeneration?  @relation("McpSharedDesiredRuntimeGeneration", fields: [desiredRuntimeGenerationId], references: [id], onDelete: SetNull)
  runtimeGenerations         McpRuntimeGeneration[] @relation("McpSharedRuntimeGenerations")
  server                     McpServer              @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model McpOAuthClient {
  id                     String               @id @default(uuid())
  registrationKey        String               @unique
  clientId               String
  clientMetadata         Json
  clientSecretEnvelope   String?
  clientSecretGeneration Int                  @default(0)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  connections            McpOAuthConnection[]
}

model McpOAuthConnection {
  id                    String                  @id @default(uuid())
  serverId              String
  userId                String
  oauthClientId         String?
  purpose               McpOAuthPurpose
  policyFingerprint     String
  state                 McpOAuthConnectionState @default(ready)
  tokenEnvelope         String?
  tokenGeneration       Int                     @default(0)
  externalAccountLabel  String?
  scopes                String[]                @default([])
  expiresAt             DateTime?
  disconnectRequestedAt DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  discoveredBy          McpUserServer[]         @relation("McpUserServerDiscoveredOAuthConnection")
  oauthClient           McpOAuthClient?         @relation(fields: [oauthClientId], references: [id], onDelete: Restrict)
  runtimeGenerations    McpRuntimeGeneration[]
  server                McpServer               @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

