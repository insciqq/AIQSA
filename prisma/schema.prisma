  embeddingCredential          ProviderCredential        @relation(fields: [embeddingConnectionId, embeddingCredentialId], references: [connectionId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeRunBinding_credential_fkey")
  embeddingCredentialVersion   ProviderCredentialVersion @relation(fields: [embeddingCredentialId, embeddingCredentialVersionId], references: [credentialId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeRunBinding_credentialVersion_fkey")
  embeddingModel               ProviderModel             @relation(fields: [embeddingConnectionId, embeddingProviderModelId], references: [connectionId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeRunBinding_embeddingModel_fkey")
  indexGeneration              KnowledgeIndexGeneration  @relation(fields: [knowledgeBaseId, indexGenerationId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeRunBinding_generation_fkey")
  knowledgeBase                KnowledgeBase             @relation(fields: [knowledgeBaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
