/// Private immutable selected-file evidence; it never implies attachment publication.
model WorkspaceSelectedCapture {
  id                   String   @id @db.Char(32)
  modelRunId           String
  workspaceSessionId   String
  runtimeSandboxId     String
  requestKey           String   @db.VarChar(128)
  requestHash          String   @db.Char(64)
  producerGeneration   Int
  producerOwner        String   @db.VarChar(160)
  selection            Json
  state                String   @default("CAPTURING") @db.VarChar(16)
  createdAt            DateTime @default(now())
  sealedAt             DateTime?
  releasedAt           DateTime?
  binding              WorkspaceRunBinding @relation(fields: [modelRunId, workspaceSessionId], references: [modelRunId, workspaceSessionId], onDelete: Cascade, onUpdate: Restrict, map: "WorkspaceSelectedCapture_binding_fkey")
  files                WorkspaceCapturedFile[]
  references           WorkspaceCaptureReference[]
  reads                WorkspaceCaptureReadLease[]
  checkpoints          WorkspaceOutputCheckpoint[]

  @@unique([modelRunId, requestKey])
  @@index([workspaceSessionId, state])
}

model WorkspaceCapturedFile {
  id                   String   @id @default(uuid())
  captureId            String   @db.Char(32)
  relativePath         String   @db.VarChar(512)
  byteSize             Int
  checksum             String   @db.Char(64)
  mimeType             String   @db.VarChar(255)
  storageKey           String?  @unique
  storageState         String   @default("NONE") @db.VarChar(16)
  storageToken         String?  @db.VarChar(64)
  storageLeaseExpiresAt DateTime?
