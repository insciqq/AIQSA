  sourceVersion   KnowledgeSourceVersion       @relation(fields: [sourceId, sourceVersionId, ownerUserId], references: [sourceId, id, ownerUserId], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeBaseSnapshotSource_version_owner_fkey")

