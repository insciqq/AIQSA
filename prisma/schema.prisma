  executionBindingIds String[]                    @default([])
  results             Json?
  providerResult      Json?
  resultHash          String?                     @db.VarChar(128)
  resultCount         Int                         @default(0)
  durationMs          Int?
  errorCode           String?                     @db.VarChar(128)
  retentionState      MemoryReceiptRetentionState @default(RETAINED)
  plaintextPurgedAt   DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @default(now()) @updatedAt
  completedAt         DateTime?
  modelRun            ModelRun                    @relation(fields: [userId, modelRunId], references: [userId, id], onDelete: Cascade, onUpdate: Restrict, map: "MemoryHistoryRun_modelRun_fkey")
  modelRunToolCall    ModelRunToolCall            @relation(fields: [modelRunId, modelRunToolCallId], references: [modelRunId, id], onDelete: Cascade, onUpdate: Restrict, map: "MemoryHistoryRun_toolCall_fkey")

  @@unique([userId, id])
  @@unique([userId, modelRunId, id])
  @@unique([modelRunId, invocationOrdinal])
  @@unique([modelRunId, modelRunToolCallId])
  @@index([userId, createdAt])
  @@index([userId, retentionState, createdAt])
  @@index([modelRunId, state])
}

model MemoryToolEgressReceipt {
  id                     String                        @id @default(uuid())
  userId                 String
  modelRunId             String
  modelRunToolCallId     String?
  requestOrdinal         Int
  mode                   MemoryToolEgressMode
  destinationKind        String                        @db.VarChar(64)
  destinationFingerprint String                        @db.VarChar(128)
  destinationSnapshot    Json
  requestEvidenceHash    String                        @db.VarChar(128)
  requestPreviewHash     String?                       @db.VarChar(128)
  dispatchState          MemoryToolEgressDispatchState @default(DISPATCHED)
  dispatchStartedAt      DateTime?
  dispatchCompletedAt    DateTime?
  errorCode              String?                       @db.VarChar(128)
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @default(now()) @updatedAt
  modelRun               ModelRun                      @relation(fields: [userId, modelRunId], references: [userId, id], onDelete: Cascade, onUpdate: Restrict, map: "MemoryToolEgressReceipt_modelRun_fkey")
  modelRunToolCall       ModelRunToolCall?             @relation(fields: [modelRunId, modelRunToolCallId], references: [modelRunId, id], onDelete: Cascade, onUpdate: Restrict, map: "MemoryToolEgressReceipt_toolCall_fkey")

  @@unique([userId, id])
  @@unique([userId, modelRunId, id])
  @@unique([modelRunId, requestOrdinal])
  @@unique([modelRunId, modelRunToolCallId])
  @@index([userId, dispatchState, createdAt])
  @@index([modelRunId, mode])
}
