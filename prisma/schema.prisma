}

/// Only the token hash is stored. Legacy single snapshots retain their bytes;
/// explicit sets reference immutable versions and share their render cache.
model ArtifactPublication {
  id                String                    @id @default(uuid())
  ownerUserId       String
  artifactId        String
  mode              ArtifactPublicationMode   @default(SINGLE)
  revision          Int                       @default(1)
  defaultVersionId  String?
  artifactVersionId String?
  tokenHash         String                    @unique @db.Char(64)
  bundleStorageKey  String?                   @unique @db.VarChar(512)
  publicManifest    Json?
  title             String?                   @db.VarChar(240)
  kind              ArtifactKind?
  checksum          String?                   @db.Char(64)
  byteSize          Int?
  status            ArtifactPublicationStatus @default(PENDING)
  expiresAt         DateTime?
  revokedAt         DateTime?
  createdAt         DateTime                  @default(now())
  owner             User                      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  artifact          Artifact                  @relation(fields: [ownerUserId, artifactId], references: [ownerUserId, id], onDelete: Cascade, onUpdate: Restrict)
  artifactVersion   ArtifactVersion?          @relation(fields: [artifactId, artifactVersionId], references: [artifactId, id], onDelete: Cascade, onUpdate: Restrict, map: "ArtifactPublication_version_artifact_match_fkey")
  members           ArtifactPublicationVersion[] @relation("ArtifactPublicationMembers")
  defaultMember     ArtifactPublicationVersion? @relation("ArtifactPublicationDefault", fields: [id, defaultVersionId], references: [publicationId, versionId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([artifactId, id])
  @@index([ownerUserId, createdAt])
  @@index([artifactId, createdAt])
  @@index([artifactVersionId])
  @@index([status, expiresAt])
}

model ArtifactPublicationVersion {
  publicationId String
  artifactId    String
  versionId     String
  position      Int
  publication   ArtifactPublication @relation("ArtifactPublicationMembers", fields: [artifactId, publicationId], references: [artifactId, id], onDelete: Cascade, onUpdate: Restrict)
  version       ArtifactVersion @relation(fields: [artifactId, versionId], references: [artifactId, id], onDelete: NoAction, onUpdate: Restrict)
  defaultFor    ArtifactPublication[] @relation("ArtifactPublicationDefault")

  @@id([publicationId, versionId])
  @@unique([publicationId, position])
  @@index([artifactId, versionId])
}

/// The exact artifact version available as bounded context in one personal chat.
/// A continuation copies this row to the destination chat; the artifact bytes
/// remain owned by ArtifactVersion and are never duplicated.
model ArtifactChatBinding {
  artifactId String
  chatId     String
  versionId  String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  artifact   Artifact        @relation(fields: [artifactId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  chat       Chat            @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  version    ArtifactVersion @relation(fields: [artifactId, versionId], references: [artifactId, id], onDelete: Cascade, onUpdate: Restrict, map: "ArtifactChatBinding_version_fkey")

  @@id([artifactId, chatId])
  @@index([chatId, updatedAt])
  @@index([versionId])
}

