model Announcement {
  id          String   @id @default(uuid())
  title       String
  body        String
  published   Boolean  @default(false)
  publishedAt DateTime?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reads       AnnouncementRead[]

  @@index([published, publishedAt, id])
  @@index([createdAt, id])
}

/// A personal generated browser artifact. V1 intentionally has no Project or group scope.
model Artifact {
  id               String                @id @default(uuid())
  ownerUserId      String
  sourceChatId     String?
  title            String                @db.VarChar(240)
  kind             ArtifactKind
  currentVersionId String?
  archivedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  owner            User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  versions         ArtifactVersion[]
  publications     ArtifactPublication[]
  chatBindings     ArtifactChatBinding[]

  @@unique([ownerUserId, id])
  @@index([ownerUserId, updatedAt])
  @@index([ownerUserId, archivedAt, updatedAt])
  @@index([sourceChatId])
}

/// Immutable validated source/bundle metadata. Bytes live in private object storage.
model ArtifactVersion {
  id               String                @id @default(uuid())
  artifactId       String
  versionNumber    Int
  title            String                @db.VarChar(240)
  kind             ArtifactKind
  entrypoint       String?               @db.VarChar(192)
  manifest         Json
  bundleStorageKey String                @unique @db.VarChar(512)
  checksum         String                @db.Char(64)
  byteSize         Int
  status           ArtifactVersionStatus @default(PENDING)
  sourceModelRunId String?
  sourceToolCallId String?               @unique
  failureCode      String?                @db.VarChar(64)
  createdAt        DateTime              @default(now())
  readyAt          DateTime?
  artifact         Artifact              @relation(fields: [artifactId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  publications     ArtifactPublication[]
  publicationMembers ArtifactPublicationVersion[]
  chatBindings     ArtifactChatBinding[]
  blobs            ArtifactVersionBlob[]
  renders          ArtifactRender[]

  @@unique([artifactId, versionNumber])
  @@unique([artifactId, id])
  @@index([artifactId, createdAt])
  @@index([sourceModelRunId])
  @@index([sourceModelRunId, sourceToolCallId])
  @@index([status, createdAt])
}

model ArtifactBlob {
  id          String                @id @default(uuid())
  ownerUserId String
  sha256      String                @db.Char(64)
  byteSize    Int
  storageKey  String                @unique @db.VarChar(512)
  createdAt   DateTime              @default(now())
  owner       User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  versions    ArtifactVersionBlob[]

  @@unique([ownerUserId, sha256])
}

model ArtifactVersionBlob {
  versionId String
  blobId    String
  path      String          @db.VarChar(192)
  version   ArtifactVersion @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  blob      ArtifactBlob    @relation(fields: [blobId], references: [id], onDelete: NoAction, onUpdate: Restrict)

  @@id([versionId, path])
  @@index([blobId])
}

/// One rendered page of a version per renderer version; the entry page is the empty path.
model ArtifactRender {
  id                 String          @id @default(uuid())
  versionId          String
  rendererVersion    Int
  page               String          @default("") @db.VarChar(192)
  renderedStorageKey String          @unique @db.VarChar(512)
  renderedChecksum   String          @db.Char(64)
  renderedByteSize   Int
  contentType        String          @db.VarChar(128)
  createdAt          DateTime        @default(now())
  version            ArtifactVersion @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([versionId, rendererVersion, page])
}

/// Only the token hash is stored. Legacy single snapshots retain their bytes;
/// explicit sets reference immutable versions and share their render cache.
model ArtifactPublication {
  id                String                    @id @default(uuid())
  ownerUserId       String
  artifactId        String
  mode              ArtifactPublicationMode   @default(SINGLE)
  revision          Int                       @default(1)
  defaultVersionId  String?
  artifactVersionId String?
