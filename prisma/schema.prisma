  @@unique([modelRunId, id])
  @@unique([modelRunId, ordinal])
  @@unique([modelRunId, profileRevisionId])
  @@index([profileRevisionId])
  @@index([embeddingConnectionId, embeddingProviderModelId], map: "KnowledgeRunProfileBinding_embedding_model_idx")
  @@index([embeddingCredentialId, embeddingCredentialVersionId], map: "KnowledgeRunProfileBinding_credential_version_idx")
