  followupMode                 String?                             @db.VarChar(16)
  followupRevision             Int                                 @default(0)
  followupBudgetTokens         Int                                 @default(0)
  followupClosedAt             DateTime?
  followupKnowledgeRevision    Int                                 @default(0)
  followupKnowledgeOffset      Int                                 @default(0)
  workspaceFollowup            WorkspaceFollowup?                  @relation("WaitingWorkspaceRun")
  dependentWorkspaceFollowups   WorkspaceFollowup[]                 @relation("PreviousWorkspaceRun")
  chatTitleGeneration          ChatTitleGeneration?
  chatPdfPreparation           ChatPdfRunPreparation?
  chatPdfAttachments           ChatPdfAttachmentPreparation[]
  knowledgeImageObservation    KnowledgeImageObservation?
  id                           String                              @id @default(uuid())
  chatId                       String
  userId                       String
  userMessageId                String
  assistantMessageId           String?
  assistantId                  String?
  assistantIdentity            Json?
  provider                     String
  modelId                      String
  status                       ModelRunStatus
  normalizedRequest            Json?
  providerResponseId           String?
  inputTokens                  Int?
  cachedInputTokens            Int?
  cacheWriteInputTokens        Int?
  outputTokens                 Int?
  reasoningTokens              Int?
  totalTokens                  Int?
  usageCompleteness             TokenUsageCompleteness              @default(UNAVAILABLE)
  estimatedCostMicros          Int?
  errorPayload                 Json?
  toolLoopState                Json?
  answerStartedAt              DateTime?
  answerCompletedAt            DateTime?
  /// Frozen completion accounting for recovery until the run settles.
  answerCompletionUsage        Json?
  workspaceWaitPending         Boolean                             @default(false)
  /// A scheduled task's run: its task, occurrence and task generation at acceptance.
  /// Plain values without relations, so they outlive the task and its history.
  scheduledTaskId              String?
  scheduledOccurrenceId        String?
  scheduledTaskGeneration      Int?
  /// A settled monitoring check's outcome (`ScheduledTaskCheckOutcome`): what the
  /// transcript collapses (`no_update`) after the occurrence history is pruned.
  scheduledOutcome             String?                             @db.VarChar(64)
  createdAt                    DateTime                            @default(now())
  updatedAt                    DateTime                            @updatedAt
  assistantMessage             Message?                            @relation("AssistantMessageRun", fields: [assistantMessageId], references: [id], onDelete: SetNull)
  branchSourceMessages         Message[]                           @relation("BranchSourceModelRun")
  /// Accepted identity is immutable; deleting the definition only detaches assistantId. Execution lives in the normalized request and exact bindings.
  assistant                    AssistantDefinition?                @relation(fields: [assistantId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  chat                         Chat                                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  events                       ModelRunEvent[]
  mcpRunBindings               McpRunBinding[]
  mcpToolApprovals             McpToolApproval[]
  knowledgeRunBindings         KnowledgeRunBinding[]
  knowledgeRunProfileBindings  KnowledgeRunProfileBinding[]
  knowledgeRunSourceBindings   KnowledgeRunSourceBinding[]
  knowledgeRunScope            KnowledgeRunScope?
  knowledgeRetrievalSession    KnowledgeRetrievalSession?
  knowledgeRuns                KnowledgeRun[]
  knowledgeBudgetReservations  KnowledgeBudgetReservation[]
  knowledgeProviderAttempts    KnowledgeProviderAttempt[]
  optionalDecisionAttempts     OptionalDecisionAttempt[]
  knowledgeDispatchManifests   KnowledgeEvidenceDispatchManifest[]
  memoryHistoryRuns            MemoryHistoryRun[]
  memoryToolEvents             MemoryToolEvent[]
  memoryToolEgressReceipts     MemoryToolEgressReceipt[]
  providerRunBindings          ProviderRunBinding[]
  projectRunBinding            ProjectRunBinding?
  searchRuns                   SearchRun[]
  skillRunBindings             ModelRunSkillBinding[]
  toolCalls                    ModelRunToolCall[]
  toolObservations             ToolObservation[]
  userMessage                  Message                             @relation("UserMessageRun", fields: [userMessageId], references: [id], onDelete: Restrict)
  usageEvents                  UsageEvent[]
  workspaceRunBinding          WorkspaceRunBinding?
  workspaceExecutions          WorkspaceExecution[]
  workspaceProducedAttachments Attachment[]                        @relation("WorkspaceProducedAttachment")
  workspaceCaptureReferences   WorkspaceCaptureReference[]
  scheduledTaskOccurrences     ScheduledTaskOccurrence[]
  browserPushDelivery          BrowserPushDelivery?
  problemReports               AnswerProblemReport[]

  @@unique([userId, id])
  @@unique([chatId, id], map: "ModelRun_chatId_id_key")
  @@unique([userId, chatId, id])
  @@index([assistantId, createdAt])
  @@index([assistantMessageId])
  @@index([chatId, createdAt])
  @@index([provider, modelId])
  @@index([status])
  @@index([userId, createdAt])
  @@index([userMessageId])
}

/// Ordered user clarifications of this exact task, independent of message DAG edges.
model RunFollowup {
  id              String   @id @default(uuid())
  chatId          String
  modelRunId      String
  ordinal         Int
  nonce           String   @db.VarChar(128)
  text            String
  authorUserId    String?
  authorName      String   @db.VarChar(256)
  createdAt       DateTime @default(now())
  deliveredAt     DateTime?
  precedingText   String?
  modelRun        ModelRun @relation(fields: [chatId, modelRunId], references: [chatId, id], onDelete: Cascade, onUpdate: Restrict)
  author          User?    @relation(fields: [authorUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([modelRunId, ordinal])
  @@unique([modelRunId, nonce])
  @@index([chatId, modelRunId])
  @@index([authorUserId])
}

/// One accepted next message waiting for its predecessor to retire Workspace authority.
model WorkspaceFollowup {
  modelRunId            String                 @id
  chatId                String
  predecessorRunId      String
  admissionKey          String                 @unique @db.Char(64)
  state                 WorkspaceFollowupState @default(waiting)
  snapshot              Json?
  admissionResult       Json?
  sourceRevisionAdvance Int                    @default(0)
  deadlineAt            DateTime
  claimToken            String?
  leaseExpiresAt        DateTime?
  errorCode             String?                @db.VarChar(64)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  modelRun              ModelRun               @relation("WaitingWorkspaceRun", fields: [chatId, modelRunId], references: [chatId, id], onDelete: Cascade, onUpdate: Restrict)
  predecessor           ModelRun               @relation("PreviousWorkspaceRun", fields: [chatId, predecessorRunId], references: [chatId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([chatId, modelRunId])
  @@index([state, createdAt])
  @@index([chatId, predecessorRunId])
}

model ModelRunSkillBinding {
  modelRunId String
