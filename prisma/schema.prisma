  @@index([serverId, userId, purpose, state])
}

model InboundMcpOAuthClient {
  id                  String                             @id @default(uuid())
  clientId            String                             @unique @db.VarChar(2048)
  clientName          String                             @db.VarChar(200)
  clientOrigin        String                             @db.VarChar(2048)
  clientUri           String?                            @db.VarChar(2048)
  redirectUris        String[]
  applicationType     InboundMcpOAuthApplicationType
  kind                InboundMcpOAuthClientKind
  metadataFingerprint String                             @db.VarChar(64)
  metadataExpiresAt   DateTime?
  lastUsedAt          DateTime?
  createdAt           DateTime                           @default(now())
  updatedAt           DateTime                           @updatedAt
  authorizationCodes  InboundMcpOAuthAuthorizationCode[]
  grants              InboundMcpOAuthGrant[]

  @@index([kind, lastUsedAt, createdAt])
  @@index([metadataExpiresAt])
}

model InboundMcpOAuthGrant {
  scopes             String[]                           @default([])
  resourcePath       String                             @default("/mcp") @db.VarChar(32)
  capability         String                             @default("memory:facts") @db.VarChar(32)
  id                 String                             @id @default(uuid())
  userId             String
  oauthClientId      String
  revision           Int                                @default(1)
  state              InboundMcpOAuthGrantState          @default(ACTIVE)
  connectedAt        DateTime                           @default(now())
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt
  authorizationCodes InboundMcpOAuthAuthorizationCode[]
  client             InboundMcpOAuthClient              @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  tokenFamilies      InboundMcpOAuthTokenFamily[]
  user               User                               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, oauthClientId])
  @@unique([userId, oauthClientId, resourcePath])
  @@unique([id, resourcePath, capability], map: "InboundMcpOAuthGrant_authority_key")
  @@unique([id, oauthClientId, resourcePath, capability], map: "InboundMcpOAuthGrant_client_authority_key")
  @@index([oauthClientId, state])
  @@index([userId, state, updatedAt])
}

model InboundMcpOAuthAuthorizationCode {
  scopes             String[]                           @default([])
  resourcePath  String                @default("/mcp") @db.VarChar(32)
  capability    String                @default("memory:facts") @db.VarChar(32)
  id            String                @id @default(uuid())
  codeHash      String                @unique @db.VarChar(64)
  grantId       String
  oauthClientId String
  grantRevision Int
  redirectUri   String                @db.VarChar(2048)
  codeChallenge String                @db.VarChar(43)
  issuer        String                @db.VarChar(2048)
  resource      String                @db.VarChar(2048)
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime              @default(now())
  client        InboundMcpOAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  grant         InboundMcpOAuthGrant  @relation(fields: [grantId, oauthClientId, resourcePath, capability], references: [id, oauthClientId, resourcePath, capability], onDelete: Cascade, map: "InboundMcpOAuthAuthorizationCode_authority_fkey")

  @@index([expiresAt, consumedAt])
  @@index([grantId, grantRevision])
  @@index([oauthClientId])
}

model InboundMcpOAuthTokenFamily {
  scopes             String[]                           @default([])
  resourcePath        String                 @default("/mcp") @db.VarChar(32)
  capability          String                 @default("memory:facts") @db.VarChar(32)
  id                  String                 @id @default(uuid())
  grantId             String
  grantRevision       Int
