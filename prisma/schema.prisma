model ModelRunToolCall {
  observation                ToolObservation?
  workspaceCheckpoint       WorkspaceOutputCheckpoint?
  visionAnalysis             VisionAnalysisAttempt?
  generatedImages            Attachment[]                @relation("ImageToolOutput")
  imageUsage                 UsageEvent?                 @relation("ImageToolUsage")
  id                         String                      @id @default(uuid())
  modelRunId                 String
  mcpRunBindingId            String?
  workspaceRunBindingId      String?
  roundIndex                 Int
  ordinal                    Int
  providerCallId             String
  toolName                   String
  arguments                  Json
  state                      ModelRunToolCallState       @default(pending)
  result                     Json?
  startedAt                  DateTime?
  completedAt                DateTime?
  usageAccountedAt           DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  mcpRunBinding              McpRunBinding?              @relation(fields: [mcpRunBindingId], references: [id], onDelete: SetNull)
  modelRun                   ModelRun                    @relation(fields: [modelRunId], references: [id], onDelete: Cascade)
  workspaceRunBinding        WorkspaceRunBinding?        @relation(fields: [workspaceRunBindingId], references: [modelRunId], onDelete: SetNull, onUpdate: Restrict)
  memoryHistoryRun           MemoryHistoryRun?
  memoryToolEvents           MemoryToolEvent[]
  workspaceExecution         WorkspaceExecution?
  skillBindings              ModelRunSkillBinding[]
  codeInvocations            WorkspaceCodeInvocation[]
  mcpToolApprovals           McpToolApproval[]
  subagentTurns              SubagentTurn[]
  /// The sub-agent thread that made the call (`SubagentThread.id`), with rounds of its own; null for the main agent.
  /// A plain value, as on `RunTranscriptItem`.
  subagentThreadId           String?
  /// The thread's turn (`SubagentTurn.id`) that made the call, a plain value: a thread may run two turns in one
  /// answer, and its rounds continue across them.
  subagentTurnId             String?

  /// Both NULLS NOT DISTINCT, so the main agent's keys stay unique per run
  /// (`20261029230300_model_run_tool_call_thread_ordinal_index`, `20261029230400_..._provider_call_index`).
  @@unique([modelRunId, subagentThreadId, roundIndex, providerCallId], map: "ModelRunToolCall_thread_round_provider_call_key")
  @@unique([modelRunId, subagentThreadId, roundIndex, ordinal], map: "ModelRunToolCall_thread_round_ordinal_key")
  @@unique([modelRunId, id])
  @@index([mcpRunBindingId])
  @@index([workspaceRunBindingId])
  @@index([modelRunId, state])
  @@index([updatedAt, id])
}

/// Exact accepted tool originals; model checkpoints retain only bounded projections.
model ToolObservation {
  id                String           @id @db.Char(32)
  modelRunId        String
  toolCallId        String           @unique
  formatVersion     Int              @default(1)
  sourceKind        String           @db.VarChar(16)
  sourceBinding     Json?
  executionReceipt  Json?
  state             String           @default("RESERVED") @db.VarChar(16)
  executionOutcome  String?          @db.VarChar(16)
  reservedBytes     Int
  byteSize          Int?
  checksum          String?          @db.Char(64)
  storageMode       String?          @db.VarChar(16)
  inlineText        String?
  storageKey        String?          @unique @db.VarChar(512)
  projection        Json?
  sourceTruncated   Boolean          @default(false)
  maskable          Boolean          @default(false)
