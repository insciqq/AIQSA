  usageEvents                         UsageEvent[]
  workspacePolicyUpdates              WorkspacePolicy[]                  @relation("WorkspacePolicyUpdater")
  usageLimit                          UsageLimit?                        @relation("UsageLimitUser")
  usageLimitUpdates                   UsageLimit[]                       @relation("UsageLimitUpdater")
  usageLimitPolicyUpdates             UsageLimitPolicy[]                 @relation("UsageLimitPolicyUpdater")
  usageLimitAlerts                    UsageLimitAlert[]
  usageMessageAdmissions              UsageMessageAdmission[]
  workspaceSecrets                    WorkspaceSecret[]
