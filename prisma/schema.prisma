  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  oauthClient           McpOAuthClient?         @relation(fields: [oauthClientId], references: [id], onDelete: Restrict)
  runtimeGenerations    McpRuntimeGeneration[]
  server                McpServer               @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([oauthClientId])
  @@index([serverId, userId, purpose, state])
}

model McpRuntimeGeneration {
  id                      String              @id @default(uuid())
  userServerId            String
  revisionId              String
  oauthConnectionId       String?
  fingerprint             String              @unique
  credentialSources       String[]            @default([])
  externalAccountLabel    String?
  effectiveConfigEnvelope String?
  runtimeHandle           Json?
  inventory               Json?
  inventoryUpdatedAt      DateTime?
  state                   McpRuntimeState     @default(starting)
  readinessCheckedAt      DateTime?
  errorCode               String?
  retryAt                 DateTime?
  attemptCount            Int                 @default(0)
  lastUsedAt              DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  desiredFor              McpUserServer?      @relation("McpDesiredRuntimeGeneration")
  oauthConnection         McpOAuthConnection? @relation(fields: [oauthConnectionId], references: [id], onDelete: Restrict)
  revision                McpRevision         @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  runBindings             McpRunBinding[]
  userServer              McpUserServer       @relation("McpUserRuntimeGenerations", fields: [userServerId], references: [id], onDelete: Cascade)

  @@index([oauthConnectionId])
  @@index([revisionId])
  @@index([state, retryAt])
  @@index([userServerId])
}

model McpRunBinding {
  id                           String                @id @default(uuid())
  modelRunId                   String
  runtimeGenerationId          String?
  runtimeGenerationFingerprint String
  createdAt                    DateTime              @default(now())
  modelRun                     ModelRun              @relation(fields: [modelRunId], references: [id], onDelete: Cascade)
  runtimeGeneration            McpRuntimeGeneration? @relation(fields: [runtimeGenerationId], references: [id], onDelete: SetNull)
  toolCalls                    ModelRunToolCall[]

  @@unique([modelRunId, runtimeGenerationFingerprint])
  @@index([runtimeGenerationId])
}

model ModelRunToolCall {
  id              String                @id @default(uuid())
  modelRunId      String
  mcpRunBindingId String?
  roundIndex      Int
  ordinal         Int
  providerCallId  String
  toolName        String
  arguments       Json
  state           ModelRunToolCallState @default(pending)
  result          Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  mcpRunBinding   McpRunBinding?        @relation(fields: [mcpRunBindingId], references: [id], onDelete: SetNull)
  modelRun        ModelRun              @relation(fields: [modelRunId], references: [id], onDelete: Cascade)
  knowledgeRun    KnowledgeRun?

  @@unique([modelRunId, roundIndex, providerCallId])
  @@unique([modelRunId, roundIndex, ordinal])
  @@unique([modelRunId, id])
  @@index([mcpRunBindingId])
  @@index([modelRunId, state])
}

model KnowledgeRun {
  id                 String              @id @default(uuid())
  modelRunId         String
  modelRunToolCallId String              @unique
  invocationOrdinal  Int
  query              String              @db.VarChar(500)
  outcome            KnowledgeRunOutcome
  fusion             String              @db.VarChar(32)
  candidateLimit     Int
  resultLimit        Int
  candidateCount     Int
  threshold          Float
  baseEvidence       Json
  results            Json
  providerText       String
  embeddingUsage     Json
  durationMs         Int
  failureCode        String?             @db.VarChar(128)
  rerankerBinding    Json?
  preRerankOrder     Json?
  postRerankOrder    Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  modelRun           ModelRun            @relation(fields: [modelRunId], references: [id], onDelete: Cascade)
  modelRunToolCall   ModelRunToolCall    @relation(fields: [modelRunId, modelRunToolCallId], references: [modelRunId, id], onDelete: Cascade, onUpdate: Restrict, map: "KnowledgeRun_toolCall_fkey")

  @@unique([modelRunId, modelRunToolCallId])
  @@index([modelRunId, createdAt])
}

model SearchRun {
  id               String                     @id @default(uuid())
  modelRunId       String
  strategyId       String
  searchRevisionId String?
  invocationId     String?
  query            String?
  provider         String
  modelId          String?
  requestPreview   Json
  artifacts        Json
  durationMs       Int?
  status           SearchRunStatus
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  modelRun         ModelRun                   @relation(fields: [modelRunId], references: [id], onDelete: Cascade)
  searchRevision   SearchIntegrationRevision? @relation(fields: [searchRevisionId], references: [id], onDelete: Restrict)

  @@unique([modelRunId, invocationId])
  @@index([strategyId])
  @@index([searchRevisionId])
}

model Attachment {
  id                  String                   @id @default(uuid())
  userId              String
  chatId              String?
  messageId           String?
  kind                String
  mimeType            String
  fileName            String
  storageKey          String
  checksum            String?
  status              AttachmentStatus         @default(ready)
  processingErrorCode String?                  @db.VarChar(64)
  byteSize            Int
  extractedText       String?
  metadata            Json
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @default(now()) @updatedAt
  chat                Chat?                    @relation(fields: [chatId], references: [id], onDelete: SetNull)
  processingJob       AttachmentProcessingJob?
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([messageId])
  @@index([storageKey])
}

model AttachmentProcessingJob {
  id            String     @id @default(uuid())
  attachmentId  String     @unique
  claimToken    String?
  claimedAt     DateTime?
  attemptCount  Int        @default(0)
  nextAttemptAt DateTime   @default(now())
  lastAttemptAt DateTime?
  lastErrorCode String?    @db.VarChar(64)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  attachment    Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@index([nextAttemptAt, claimedAt, createdAt])
}

model AttachmentDeletionJob {
  id            String    @id @default(uuid())
  storageKey    String    @unique
  claimToken    String?
  claimedAt     DateTime?
  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  lastErrorCode String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([claimedAt, createdAt])
}

model SharedChatSnapshot {
  id          String    @id @default(uuid())
  ownerUserId String
  chatId      String?
  slugHash    String    @unique
  title       String
  snapshot    Json
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  chat        Chat?     @relation(fields: [chatId], references: [id], onDelete: SetNull)
  owner       User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([ownerUserId, createdAt])
}

model UsageEvent {
  id                         String                    @id @default(uuid())
  userId                     String
  chatId                     String?
  modelRunId                 String?
  provider                   String
  modelId                    String
  providerModelId            String?
  knowledgeBaseId            String?
  knowledgeIndexGenerationId String?
  knowledgeDocumentVersionId String?
  knowledgeBatchIndex        Int?
  inputTokens                Int                       @default(0)
  cachedInputTokens          Int                       @default(0)
  cacheWriteInputTokens      Int                       @default(0)
  outputTokens               Int                       @default(0)
  reasoningTokens            Int                       @default(0)
  totalTokens                Int                       @default(0)
  estimatedCostMicros        Int                       @default(0)
  createdAt                  DateTime                  @default(now())
  knowledgeBase              KnowledgeBase?            @relation("KnowledgeUsageBase", fields: [knowledgeBaseId], references: [id], onDelete: Restrict)
  knowledgeDocumentVersion   KnowledgeDocumentVersion? @relation("KnowledgeUsageDocumentVersion", fields: [knowledgeBaseId, knowledgeDocumentVersionId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "UsageEvent_knowledgeDocumentVersion_fkey")
  knowledgeIndexGeneration   KnowledgeIndexGeneration? @relation("KnowledgeUsageGeneration", fields: [knowledgeBaseId, knowledgeIndexGenerationId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "UsageEvent_knowledgeIndexGeneration_fkey")
  modelRun                   ModelRun?                 @relation(fields: [modelRunId], references: [id], onDelete: SetNull)
  user                       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([knowledgeIndexGenerationId, knowledgeDocumentVersionId, knowledgeBatchIndex])
  @@index([userId, createdAt])
  @@index([provider, modelId])
  @@index([knowledgeBaseId, createdAt])
}
