  snapshot        KnowledgeBaseSnapshot        @relation(fields: [knowledgeBaseId, snapshotId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeBaseSnapshotSource_snapshot_fkey")
