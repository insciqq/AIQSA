/// Content-free, versioned maintenance checkpoint. Independent new evidence
/// may authorize another review; an unchanged source set never does. A
/// job-free BLOCKED/UNREVIEWABLE row records a fixed reason code only.
model MemoryMaintenanceReview {
  id                 String    @id @default(uuid())
  userId             String
  factVersionId      String
  memoryJobId        String?
  policyVersion      String    @db.VarChar(64)
  sourceSnapshotHash String    @db.Char(64)
  evidenceThrough    DateTime
  disposition        String    @default("PENDING") @db.VarChar(16)
  usefulness         String?   @db.VarChar(16)
  reasonCode         String?   @db.VarChar(32)
  createdAt          DateTime  @default(now())
  reviewedAt         DateTime?

  @@unique([userId, id])
  @@unique([userId, factVersionId, policyVersion, sourceSnapshotHash], map: "MemoryMaintenanceReview_source_key")
  @@index([userId, memoryJobId])
  @@index([userId, factVersionId, policyVersion, evidenceThrough], map: "MemoryMaintenanceReview_coverage_idx")
}

