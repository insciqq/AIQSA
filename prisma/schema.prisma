generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthAccessRuleKind {
  email
  domain
}

enum AuthFlowTokenPurpose {
  email_verification
  password_reset
  invite_acceptance
}

enum AuthIdentityProvider {
  password
  google
  yandex
}

enum UserRole {
  admin
  user
}

enum UserStatus {
  pending
  active
  disabled
  denied
}

enum MessageStatus {
  queued
  streaming
  complete
  cancelled
  error
}

enum ModelRunStatus {
  queued
  streaming
  in_progress
  complete
  cancelled
  error
}

enum SearchRunStatus {
  complete
  error
}

enum KnowledgeRunOutcome {
  complete
  zero_above_threshold
  base_empty
  base_indexing
  embedding_model_unavailable
}

enum AttachmentStatus {
  processing
  ready
  failed
}

enum McpOAuthConnectionState {
  ready
  reauthorization_required
  disconnecting
  disconnected
}

enum McpOAuthPurpose {
  user
  validation
}

enum McpRuntimeState {
  starting
  ready
  failed
  idle
  stopping
}

enum McpActivationStage {
  queued
  resolving
  preparing_runtime
  connecting
  discovering_tools
  publishing
  ready
  failed
}

enum ModelRunToolCallState {
  pending
  running
  complete
  error
  cancelled
}

enum ProviderUnassignedPolicy {
  use_default
  require_assignment
}

enum ProviderCredentialCheckStatus {
  available
  unavailable
}

enum ProviderRunRole {
  answer
  search
}

enum ProviderModelClass {
  answer
  embedding
}

enum ProviderCredentialSource {
  default
  group
  user
}

model User {
  id                            String                             @id @default(uuid())
  email                         String?                            @unique
  displayName                   String
  role                          UserRole                           @default(user)
  status                        UserStatus                         @default(pending)
  createdAt                     DateTime                           @default(now())
  updatedAt                     DateTime                           @updatedAt
  accessGrants                  AccessGrant[]
  attachments                   Attachment[]
  authAccessRulesCreated        AuthAccessRule[]                   @relation("AuthAccessRuleCreator")
  authFlowTokens                AuthFlowToken[]
  authIdentities                AuthIdentity[]
  authInvitesAccepted           AuthInvite[]                       @relation("AuthInviteAcceptedUser")
  authInvitesCreated            AuthInvite[]                       @relation("AuthInviteCreator")
  authSessions                  AuthSession[]
  authSessionsRevoked           AuthSession[]                      @relation("AuthSessionRevoker")
  assistantDefinitions          AssistantDefinition[]              @relation("AssistantDefinitionOwner")
  assistantPins                 AssistantPin[]
  assistantPublications         AssistantPublication[]             @relation("AssistantPublicationPublisher")
  assistantRevisionsAuthored    AssistantRevision[]                @relation("AssistantRevisionAuthor")
  chats                         Chat[]
  folders                       Folder[]
  groups                        UserGroup[]
  knowledgeBasePublications     KnowledgeBasePublication[]         @relation("KnowledgeBasePublicationPublisher")
  knowledgeBases                KnowledgeBase[]                    @relation("KnowledgeBaseOwner")
  knowledgePolicyUpdates        KnowledgePolicy[]                  @relation("KnowledgePolicyUpdater")
  mcpGrants                     McpGrant[]
  mcpActivationJobs             McpActivationJob[]
  mcpOAuthConnections           McpOAuthConnection[]
  mcpUserServers                McpUserServer[]
  modelPolicyUpdates            ModelPolicy[]                      @relation("ModelPolicyUpdater")
  modelRuns                     ModelRun[]
  providerCredentialAssignments ProviderUserCredentialAssignment[]
  searchPolicyUpdates           SearchPolicy[]                     @relation("SearchPolicyUpdater")
  settings                      UserSettings?
  sharedSnapshots               SharedChatSnapshot[]
  smtpActivations               SmtpControl[]                      @relation("SmtpControlActivator")
  smtpConfigurationEdits        SmtpControl[]                      @relation("SmtpControlUpdater")
  systemModelPolicyUpdates      SystemModelPolicy[]                @relation("SystemModelPolicyUpdater")
  usageEvents                   UsageEvent[]
}

model SmtpControl {
  id                           String    @id
  draftConfig                  Json?
  draftPasswordEnvelope        String?
  draftSecretGeneration        Int?
  draftVersion                 Int       @default(0)
  testedDraftVersion           Int?
  draftTestVersion             Int?
  draftTestAt                  DateTime?
  draftTestCode                String?
  activeConfig                 Json?
  activePasswordEnvelope       String?
  activeSecretGeneration       Int?
  activeVersion                Int       @default(0)
  enabled                      Boolean   @default(false)
  secretGenerationCounter      Int       @default(0)
  healthActiveVersion          Int?
  lastAttemptAt                DateTime?
  lastAcceptedAt               DateTime?
  lastFailureAt                DateTime?
  lastFailureCode              String?
  configurationUpdatedAt       DateTime?
  configurationUpdatedByUserId String?
  activatedAt                  DateTime?
  activatedByUserId            String?
  createdAt                    DateTime  @default(now())
  activatedBy                  User?     @relation("SmtpControlActivator", fields: [activatedByUserId], references: [id], onDelete: SetNull)
  configurationUpdatedBy       User?     @relation("SmtpControlUpdater", fields: [configurationUpdatedByUserId], references: [id], onDelete: SetNull)
}

model AuthIdentity {
  id                String               @id @default(uuid())
  userId            String
  provider          AuthIdentityProvider
  providerAccountId String
  normalizedEmail   String
  emailVerifiedAt   DateTime?
  passwordHash      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  flowTokens        AuthFlowToken[]
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([provider, normalizedEmail])
  @@index([normalizedEmail])
  @@index([userId])
}

model AuthSession {
  id                 String    @id @default(uuid())
  userId             String
  tokenHash          String    @unique
  expiresAt          DateTime
  revokedAt          DateTime?
  revokedByUserId    String?
  revokedReason      String?
  createdByIp        String?
  createdByUserAgent String?
  lastSeenAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  revokedBy          User?     @relation("AuthSessionRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([revokedAt])
  @@index([userId, expiresAt])
}

model AuthRateLimitBucket {
  keyHash      String   @id @db.Char(64)
  attemptCount Int
  resetAt      DateTime @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@index([resetAt])
}

model AuthAccessRule {
  id              String                @id @default(uuid())
  kind            AuthAccessRuleKind
  value           String
  enabled         Boolean               @default(true)
  createdByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  createdBy       User?                 @relation("AuthAccessRuleCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  defaultGroups   AuthAccessRuleGroup[]

  @@unique([kind, value])
  @@index([enabled])
}

model AuthAccessRuleGroup {
  accessRuleId String
  groupId      String
  role         String         @default("member")
  createdAt    DateTime       @default(now())
  accessRule   AuthAccessRule @relation(fields: [accessRuleId], references: [id], onDelete: Cascade)
  group        Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([accessRuleId, groupId])
  @@index([groupId])
}

model AuthInvite {
  id               String            @id @default(uuid())
  email            String
  normalizedEmail  String
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  createdByUserId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  acceptedBy       User?             @relation("AuthInviteAcceptedUser", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  createdBy        User?             @relation("AuthInviteCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  defaultGroups    AuthInviteGroup[]
  flowTokens       AuthFlowToken[]

  @@index([expiresAt])
  @@index([normalizedEmail])
  @@index([revokedAt])
}

model AuthInviteGroup {
  inviteId  String
  groupId   String
  role      String     @default("member")
  createdAt DateTime   @default(now())
  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invite    AuthInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@id([inviteId, groupId])
  @@index([groupId])
}

model AuthFlowToken {
  id              String               @id @default(uuid())
  purpose         AuthFlowTokenPurpose
  tokenHash       String               @unique
  userId          String?
  identityId      String?
  inviteId        String?
  normalizedEmail String?
  sentToEmail     String?
  expiresAt       DateTime
  consumedAt      DateTime?
  metadata        Json                 @default("{}")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  identity        AuthIdentity?        @relation(fields: [identityId], references: [id], onDelete: Cascade)
  invite          AuthInvite?          @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user            User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([inviteId])
  @@index([normalizedEmail])
  @@index([consumedAt])
  @@index([purpose, expiresAt])
  @@index([userId])
}

model Group {
  id                            String                              @id @default(uuid())
  name                          String                              @unique
  systemRole                    GroupSystemRole?                    @unique
  archivedAt                    DateTime?
  createdAt                     DateTime                            @default(now())
  updatedAt                     DateTime                            @updatedAt
  accessGrants                  AccessGrant[]
  assistantPublications         AssistantPublication[]
  authAccessRuleDefaults        AuthAccessRuleGroup[]
  authInviteDefaults            AuthInviteGroup[]
  knowledgeBasePublications     KnowledgeBasePublication[]
  mcpGrants                     McpGrant[]
  providerCredentialAssignments ProviderGroupCredentialAssignment[]
  users                         UserGroup[]

  @@index([archivedAt])
}

enum GroupSystemRole {
  full_access
}

model UserGroup {
  userId    String
  groupId   String
  role      String   @default("member")
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

model UserSettings {
  id                      String         @id @default(uuid())
  userId                  String         @unique
  defaultProviderModelId  String?
  defaultFolderId         String?
  defaultSearchStrategyId String         @default("openai-native-web-search")
  defaultSearchPlan       Json?
  defaultControlValues    Json           @default("{}")
  showCitations           Boolean        @default(true)
  showReasoningBlocks     Boolean        @default(false)
  showToolActivity        Boolean        @default(true)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultProviderModel    ProviderModel? @relation("UserDefaultProviderModel", fields: [defaultProviderModelId], references: [id], onDelete: Restrict)

  @@index([defaultProviderModelId])
}

model SearchPolicy {
  id              String   @id
  defaultPlan     Json     @default("{\"mode\":\"all_selected\",\"optionIds\":[]}")
  version         Int      @default(1)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       User?    @relation("SearchPolicyUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

model KnowledgePolicy {
  id              String   @id
  candidateLimit  Int      @default(40)
  resultLimit     Int      @default(8)
  scoreThreshold  Float    @default(0.01)
  version         Int      @default(1)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       User?    @relation("KnowledgePolicyUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

model ModelPolicy {
  id                     String         @id
  defaultProviderModelId String?
  version                Int            @default(1)
  updatedByUserId        String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  defaultProviderModel   ProviderModel? @relation("InstallationDefaultProviderModel", fields: [defaultProviderModelId], references: [id], onDelete: Restrict)
  updatedBy              User?          @relation("ModelPolicyUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([defaultProviderModelId])
  @@index([updatedByUserId])
}

model SystemModelPolicy {
  id              String         @id
  providerModelId String?
  version         Int            @default(1)
  updatedByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  providerModel   ProviderModel? @relation("SystemUtilityProviderModel", fields: [providerModelId], references: [id], onDelete: Restrict)
  updatedBy       User?          @relation("SystemModelPolicyUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([providerModelId])
  @@index([updatedByUserId])
}

model AccessGrant {
  id                   String              @id @default(uuid())
  userId               String?
  groupId              String?
  providerConnectionId String?
  providerModelId      String?
  searchStrategy       String?
  enabled              Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  group                Group?              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  providerConnection   ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: Restrict)
  providerModel        ProviderModel?      @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  user                 User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([providerConnectionId])
  @@index([providerModelId])
  @@index([searchStrategy])
  @@index([userId])
}

model Folder {
  id                   String   @id @default(uuid())
  userId               String
  parentId             String?
  name                 String
  projectMemory        String   @default("")
  defaultKnowledgePlan Json?
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  chats                Chat[]
  children             Folder[] @relation("FolderHierarchy")
  parent               Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, parentId, name])
  @@index([parentId])
  @@index([userId, sortOrder])
  @@index([userId, parentId, sortOrder])
}

enum AssistantPublicationScope {
  group
  installation
}

enum KnowledgeBasePublicationScope {
  group
  installation
}

enum KnowledgeDocumentIngestState {
  queued
  parsing
  chunking
  embedding
  ready
  failed
}

enum KnowledgeIndexGenerationStatus {
  building
  ready
  active
  retired
  failed
}

model AssistantDefinition {
  id                String                 @id @default(uuid())
  ownerUserId       String
  currentRevisionId String?                @unique
  version           Int                    @default(1)
  archivedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  /// The composite relation proves the current pointer targets a revision of this definition.
  currentRevision   AssistantRevision?     @relation("AssistantCurrentRevision", fields: [id, currentRevisionId], references: [assistantId, id], onDelete: Restrict, onUpdate: Restrict, map: "AssistantDefinition_currentRevision_fkey")
  owner             User                   @relation("AssistantDefinitionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  pins              AssistantPin[]
  publications      AssistantPublication[]
  revisions         AssistantRevision[]    @relation("AssistantRevisions")

  @@unique([id, currentRevisionId])
  @@index([ownerUserId, archivedAt])
}

model AssistantRevision {
  id               String                 @id @default(uuid())
  assistantId      String
  revisionNumber   Int
  schemaVersion    Int                    @default(1)
  name             String
  description      String                 @default("")
  category         String?
  avatar           Json
  providerModelId  String
  systemPrompt     String
  developerPrompt  String?
  runControls      Json                   @default("{}")
  searchPlan       Json
  mcpServerIds     String[]               @default([])
  knowledgeBaseIds String[]               @default([])
  starterPrompts   String[]               @default([])
  authorUserId     String?
  createdAt        DateTime               @default(now())
  assistant        AssistantDefinition    @relation("AssistantRevisions", fields: [assistantId], references: [id], onDelete: Restrict)
  author           User?                  @relation("AssistantRevisionAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  currentFor       AssistantDefinition?   @relation("AssistantCurrentRevision")
  modelRuns        ModelRun[]             @relation("ModelRunAssistantRevision")
  providerModel    ProviderModel          @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  publications     AssistantPublication[] @relation("AssistantPublicationRevision")

  @@unique([assistantId, revisionNumber])
  @@unique([assistantId, id])
  @@index([authorUserId])
  @@index([providerModelId])
}

model AssistantPublication {
  id                String                    @id @default(uuid())
  assistantId       String
  revisionId        String
  scope             AssistantPublicationScope
  groupId           String?
  publishedByUserId String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  assistant         AssistantDefinition       @relation(fields: [assistantId], references: [id], onDelete: Restrict)
  group             Group?                    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  publishedBy       User?                     @relation("AssistantPublicationPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  /// The composite relation proves the pinned revision belongs to the published definition.
  revision          AssistantRevision         @relation("AssistantPublicationRevision", fields: [assistantId, revisionId], references: [assistantId, id], onDelete: Restrict, onUpdate: Restrict, map: "AssistantPublication_revision_fkey")

  @@unique([assistantId, groupId])
  @@index([groupId])
  @@index([assistantId, scope])
  @@index([revisionId])
}

model AssistantPin {
  userId      String
  assistantId String
  createdAt   DateTime            @default(now())
  assistant   AssistantDefinition @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, assistantId])
  @@index([assistantId])
}

model KnowledgeBase {
  id                      String                     @id @default(uuid())
  ownerUserId             String
  name                    String
  description             String                     @default("")
  activeIndexGenerationId String?                    @unique
  contentRevision         Int                        @default(0)
  version                 Int                        @default(1)
  archivedAt              DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  /// The composite relation proves the active generation belongs to this base.
  activeIndexGeneration   KnowledgeIndexGeneration?  @relation("KnowledgeBaseActiveIndexGeneration", fields: [id, activeIndexGenerationId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeBase_activeIndexGeneration_fkey")
  documents               KnowledgeDocument[]
  indexGenerations        KnowledgeIndexGeneration[] @relation("KnowledgeBaseIndexGenerations")
  runBindings             KnowledgeRunBinding[]
  owner                   User                       @relation("KnowledgeBaseOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  publications            KnowledgeBasePublication[]
  usageEvents             UsageEvent[]               @relation("KnowledgeUsageBase")

  @@unique([id, activeIndexGenerationId])
  @@index([ownerUserId, archivedAt])
}

model KnowledgeIndexGeneration {
  id                       String                         @id @default(uuid())
  knowledgeBaseId          String
  embeddingProviderModelId String
  sourceIndexGenerationId  String?
  sourceBaseVersion        Int?
  targetContentRevision    Int?
  embeddingConfiguration   Json
  vectorSpaceFingerprint   String                         @db.Char(64)
  targetDimension          Int
  chunkingProfileVersion   Int
  indexedContentRevision   Int                            @default(0)
  status                   KnowledgeIndexGenerationStatus @default(building)
  lastErrorCode            String?                        @db.VarChar(64)
  readyAt                  DateTime?
  activatedAt              DateTime?
  retiredAt                DateTime?
  failedAt                 DateTime?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  activeFor                KnowledgeBase?                 @relation("KnowledgeBaseActiveIndexGeneration")
  chunks                   KnowledgeChunk[]
  derivedIndexGenerations  KnowledgeIndexGeneration[]     @relation("KnowledgeIndexGenerationSource")
  embeddingProviderModel   ProviderModel                  @relation(fields: [embeddingProviderModelId], references: [id], onDelete: Restrict)
  generationDocuments      KnowledgeGenerationDocument[]
  ingestDocumentVersions   KnowledgeDocumentVersion[]     @relation("KnowledgeDocumentVersionIngestGeneration")
  knowledgeBase            KnowledgeBase                  @relation("KnowledgeBaseIndexGenerations", fields: [knowledgeBaseId], references: [id], onDelete: Restrict)
  runBindings              KnowledgeRunBinding[]
  sourceIndexGeneration    KnowledgeIndexGeneration?      @relation("KnowledgeIndexGenerationSource", fields: [knowledgeBaseId, sourceIndexGenerationId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeIndexGeneration_source_fkey")
  usageEvents              UsageEvent[]                   @relation("KnowledgeUsageGeneration")

  @@unique([knowledgeBaseId, id])
  @@index([embeddingProviderModelId])
  @@index([knowledgeBaseId, status])
  @@index([sourceIndexGenerationId])
}

model KnowledgeDocument {
  id               String                     @id @default(uuid())
  knowledgeBaseId  String
  currentVersionId String?                    @unique
  archivedAt       DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  /// The composite relation proves the current pointer targets a version of this document.
  currentVersion   KnowledgeDocumentVersion?  @relation("KnowledgeDocumentCurrentVersion", fields: [id, currentVersionId], references: [documentId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeDocument_currentVersion_fkey")
  knowledgeBase    KnowledgeBase              @relation(fields: [knowledgeBaseId], references: [id], onDelete: Restrict)
  versions         KnowledgeDocumentVersion[] @relation("KnowledgeDocumentVersions")

  @@unique([knowledgeBaseId, id])
  @@unique([id, currentVersionId])
  @@index([knowledgeBaseId, archivedAt])
}

model KnowledgeDocumentVersion {
  id                       String                        @id @default(uuid())
  knowledgeBaseId          String
  documentId               String
  ingestGenerationId       String?
  versionNumber            Int
  fileName                 String
  mimeType                 String
  byteSize                 Int
  checksum                 String                        @db.Char(64)
  originalStorageKey       String?
  normalizedTextStorageKey String?
  normalizedTextByteSize   Int?
  normalizedTextChecksum   String?                       @db.Char(64)
  pageCount                Int?
  visibleFromRevision      Int?
  visibleUntilRevision     Int?
  ingestState              KnowledgeDocumentIngestState  @default(queued)
  ingestErrorCode          String?                       @db.VarChar(64)
  ingestClaimToken         String?                       @db.VarChar(128)
  ingestClaimedAt          DateTime?
  ingestAttemptCount       Int                           @default(0)
  ingestNextAttemptAt      DateTime                      @default(now())
  ingestChunkCount         Int?
  ingestEmbeddedChunkCount Int                           @default(0)
  ingestStartedAt          DateTime?
  ingestCompletedAt        DateTime?
  payloadPurgedAt          DateTime?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  chunks                   KnowledgeChunk[]
  currentFor               KnowledgeDocument?            @relation("KnowledgeDocumentCurrentVersion")
  document                 KnowledgeDocument             @relation("KnowledgeDocumentVersions", fields: [knowledgeBaseId, documentId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeDocumentVersion_document_fkey")
  generationDocuments      KnowledgeGenerationDocument[]
  ingestGeneration         KnowledgeIndexGeneration?     @relation("KnowledgeDocumentVersionIngestGeneration", fields: [knowledgeBaseId, ingestGenerationId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeDocumentVersion_ingestGeneration_fkey")
  usageEvents              UsageEvent[]                  @relation("KnowledgeUsageDocumentVersion")

  @@unique([documentId, versionNumber])
  @@unique([documentId, id])
  @@unique([knowledgeBaseId, id])
  @@index([knowledgeBaseId, ingestState, ingestNextAttemptAt])
  @@index([ingestGenerationId])
  @@index([originalStorageKey])
  @@index([normalizedTextStorageKey])
  @@index([knowledgeBaseId, visibleFromRevision, visibleUntilRevision])
}

model KnowledgeGenerationDocument {
  knowledgeBaseId    String
  indexGenerationId  String
  documentVersionId  String
  state              KnowledgeDocumentIngestState @default(queued)
  errorCode          String?                      @db.VarChar(64)
  claimToken         String?                      @db.VarChar(128)
  claimedAt          DateTime?
  attemptCount       Int                          @default(0)
  nextAttemptAt      DateTime                     @default(now())
  lastAttemptAt      DateTime?
  chunkCount         Int?
  embeddedChunkCount Int                          @default(0)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  documentVersion    KnowledgeDocumentVersion     @relation(fields: [knowledgeBaseId, documentVersionId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeGenerationDocument_version_fkey")
  indexGeneration    KnowledgeIndexGeneration     @relation(fields: [knowledgeBaseId, indexGenerationId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeGenerationDocument_generation_fkey")

  @@id([indexGenerationId, documentVersionId])
  @@index([state, nextAttemptAt, claimedAt, createdAt])
  @@index([knowledgeBaseId, documentVersionId])
}

model KnowledgeChunk {
  id                 String                   @id @default(uuid())
  knowledgeBaseId    String
  documentVersionId  String
  indexGenerationId  String
  chunkIndex         Int
  page               Int
  headingPath        String[]                 @default([])
  text               String
  embeddingDimension Int
  embedding          Unsupported("vector")?
  searchVector       Unsupported("tsvector")?
  createdAt          DateTime                 @default(now())
  documentVersion    KnowledgeDocumentVersion @relation(fields: [knowledgeBaseId, documentVersionId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeChunk_documentVersion_fkey")
