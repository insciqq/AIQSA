  v1GenerationMaps         KnowledgeV1GenerationArtifactMap[]

  @@unique([sourceVersionId, profileRevisionId])
  @@unique([sourceVersionId, id])
  @@index([profileRevisionId, state])
  @@index([state, nextAttemptAt, claimedAt, createdAt], map: "KnowledgeSourceIndexArtifact_queue_idx")
}

model KnowledgePdfProcessingAttempt {
  id                   String                             @id @default(uuid())
  sourceArtifactId     String
  sourceVersionId      String
  processingGeneration Int                                @default(0)
  batchIndex           Int
  mode                 KnowledgePdfProcessingMode
  pageStart            Int
  pageEnd              Int
  requestDigest        String                             @db.Char(64)
  state                KnowledgePdfProcessingAttemptState @default(reserved)
  resultText           String?
  resultChecksum       String?                            @db.Char(64)
  usage                Json?
  dispatchedAt         DateTime?
  settledAt            DateTime?
  createdAt            DateTime                           @default(now())
  updatedAt            DateTime                           @updatedAt
  sourceArtifact       KnowledgeSourceIndexArtifact       @relation(fields: [sourceVersionId, sourceArtifactId], references: [sourceVersionId, id], onDelete: Cascade, onUpdate: Restrict, map: "KnowledgePdfAttempt_source_artifact_fkey")
  usageEvent           UsageEvent?

  @@unique([sourceArtifactId, processingGeneration, batchIndex], map: "KnowledgePdfAttempt_artifact_generation_batch_key")
  @@index([sourceVersionId, sourceArtifactId], map: "KnowledgePdfAttempt_source_artifact_idx")
  @@index([state, updatedAt])
}

model KnowledgeHierarchicalIndexArtifact {
  id               String                          @id
  sourceArtifactId String
  sourceVersionId  String
  schemaVersion    Int
  derivationMode   String                          @db.VarChar(32)
  state            KnowledgeHierarchicalIndexState @default(building)
  checksum         String?                         @db.Char(64)
