  requestHash         String                             @db.Char(64)
  contractVersion     Int?
  evidenceReceiptHash String?                            @db.Char(64)
  acceptedRequest     Json?
  acceptedResult      Json?
  resultHash          String?                            @db.Char(64)
  resultAcceptedAt    DateTime?
  state               KnowledgeProviderAttemptState      @default(reserved)
  estimatedUsage      Json
  actualUsage         Json?
  providerResponseId  String?
  leaseToken          String?                            @db.VarChar(128)
  leaseExpiresAt      DateTime?
