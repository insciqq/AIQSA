/// Recovery-only staging for the single governed Dream synthesis call. The
/// decoded provider output and opaque source bindings are cleared atomically
/// after semantic apply; immutable pattern versions and relations then own the
/// durable result.
model MemorySynthesisExecution {
  id                   String    @id @default(uuid())
  userId               String
  memoryJobId          String
  executionBindingId   String
  inputHash            String    @db.VarChar(128)
  acceptedOutputHash   String    @db.VarChar(128)
  sourceSetFingerprint String    @db.VarChar(128)
  sourceSnapshotHash   String    @db.VarChar(128)
  acceptedOutput       Json?
  sourceBindings       Json?
  createdAt            DateTime  @default(now())
  appliedAt            DateTime?

  @@unique([userId, id])
  @@unique([userId, memoryJobId])
  @@unique([userId, executionBindingId])
  @@index([userId, appliedAt, createdAt])
}

/// Recovery-only staging for one strict automatic-fact extraction result.
/// Provider reasoning and raw response envelopes never enter this owner. The
/// decoded packet is cleared after every candidate has a durable outcome.
model MemoryFactExtractionExecution {
  id                       String    @id @default(uuid())
  userId                   String
  memoryJobId              String
  executionBindingId       String
  sourceMessageId          String
  sourceMessageContentHash String    @db.VarChar(128)
  inputHash                String    @db.VarChar(128)
  acceptedOutputHash       String    @db.VarChar(128)
  acceptedOutput           Json?
  contextBindings          Json?
  recoverableUntil         DateTime
  createdAt                DateTime  @default(now())
  appliedAt                DateTime?

  @@unique([userId, id])
  @@unique([userId, memoryJobId])
  @@unique([userId, executionBindingId])
  @@index([userId, appliedAt, recoverableUntil])
  @@index([userId, sourceMessageId, appliedAt])
}

/// Content-free idempotency and recovery evidence for each provider packet
/// ordinal, including candidates rejected by strict decoding.
model MemoryFactExtractionCandidateReceipt {
  id                     String                               @id
  userId                 String
  extractionExecutionId  String
  candidateOrdinal       Int
  candidateFingerprint   String                               @db.VarChar(128)
  outcome                MemoryFactExtractionCandidateOutcome @default(PENDING)
  reasonCode             String?                              @db.VarChar(64)
  resultingFactId        String?
  resultingFactVersionId String?
  resultingEvidenceId    String?
  createdAt              DateTime                             @default(now())
  updatedAt              DateTime                             @default(now()) @updatedAt

  @@unique([userId, id])
  @@unique([userId, extractionExecutionId, candidateOrdinal], map: "MemoryFactExtractReceipt_user_execution_ordinal_key")
  @@unique([userId, extractionExecutionId, candidateFingerprint], map: "MemoryFactExtractReceipt_user_execution_fingerprint_key")
  @@index([userId, outcome, updatedAt])
}

/// Durable, owner-scoped reservation for the single optional semantic call
/// shared by all ambiguity resolution originating from one source message.
/// The result contains only the strict decoded decision and execution receipt
/// metadata; source text is never copied here.
model MemoryAuxiliarySemanticCall {
  id                 String    @id
  userId             String
  sourceMessageId    String
  ownerJobId         String
  purpose            String    @db.VarChar(64)
  inputHash          String?   @db.VarChar(128)
  acceptedOutputHash String?   @db.VarChar(128)
  executionId        String?
  result             Json?
  createdAt          DateTime  @default(now())
  completedAt        DateTime?

  @@unique([userId, id])
  @@unique([userId, sourceMessageId])
  @@unique([userId, ownerJobId])
  @@index([userId, purpose, createdAt])
}

