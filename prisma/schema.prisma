/// Owned by exactly one of a member's preference (`userServerId`) or the
/// server's shared Project runtime (`sharedServerId`); a SQL check enforces it.
model McpRuntimeGeneration {
  id                      String              @id @default(uuid())
  userServerId            String?
  sharedServerId          String?
  revisionId              String
  oauthConnectionId       String?
  fingerprint             String              @unique
  credentialSources       String[]            @default([])
  externalAccountLabel    String?
  effectiveConfigEnvelope String?
  inventory               Json?
  inventoryUpdatedAt      DateTime?
  state                   McpRuntimeState     @default(starting)
  readinessCheckedAt      DateTime?
  errorCode               String?
  retryAt                 DateTime?
  attemptCount            Int                 @default(0)
  lastUsedAt              DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  desiredFor              McpUserServer?      @relation("McpDesiredRuntimeGeneration")
  oauthConnection         McpOAuthConnection? @relation(fields: [oauthConnectionId], references: [id], onDelete: Restrict)
  revision                McpRevision         @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  runBindings             McpRunBinding[]
  sharedDesiredFor        McpSharedRuntime?   @relation("McpSharedDesiredRuntimeGeneration")
  sharedRuntime           McpSharedRuntime?   @relation("McpSharedRuntimeGenerations", fields: [sharedServerId], references: [serverId], onDelete: Cascade)
  userServer              McpUserServer?      @relation("McpUserRuntimeGenerations", fields: [userServerId], references: [id], onDelete: Cascade)

  @@index([oauthConnectionId])
  @@index([revisionId])
  @@index([sharedServerId])
  @@index([state, retryAt])
  @@index([userServerId])
}

model McpRunBinding {
