  cleanupJob       WorkspaceCleanupJob?
  executions       WorkspaceExecution[]
  runBindings      WorkspaceRunBinding[]

  @@index([state, expiresAt])
  @@index([state, lastActiveAt])
}

model WorkspaceCleanupJob {
  id                 String                @id @default(uuid())
  workspaceSessionId String                @unique
  sandboxName        String
  runtimeSandboxId   String?
  state              WorkspaceCleanupState @default(PENDING)
  claimToken         String?
  claimedAt          DateTime?
  attemptCount       Int                   @default(0)
  nextAttemptAt      DateTime              @default(now())
  lastAttemptAt      DateTime?
  lastErrorCode      String?               @db.VarChar(64)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  workspaceSession   WorkspaceSession      @relation(fields: [workspaceSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([nextAttemptAt, claimedAt, createdAt])
  @@index([state, nextAttemptAt])
}

model Message {
  continuations ChatContinuation[] @relation("SourceMessageContinuation")
  id                     String            @id @default(uuid())
  chatId                 String
  role                   String
  parentMessageId        String?
  content                Json
  provider               String?
  modelId                String?
  status                 MessageStatus     @default(complete)
  inputTokens            Int?
  outputTokens           Int?
  reasoningTokens        Int?
  errorMessage           String?
  authorUserId           String?
  authorDisplayName      String?
  authorProjectRole      ProjectRole?
  branchSourceModelRunId String?
  branchFollowups        Json?
  /// A user message a scheduled task posted (its prompt, possibly model-written). Set
  /// with the scheduled run and kept by branch copies: every answer to it stays out
  /// of Personal Memory and never creates a scheduled task.
  scheduledTaskPrompt    Boolean           @default(false)
  /// A user message the server wrote (`MessageSystemTurnKind`); a CHECK keeps it on user messages.
  systemTurnKind         MessageSystemTurnKind?
  /// A step of an answer review session: its server-written turn and that
  /// turn's answer. Deleting the session clears only this column.
  answerReviewSessionId  String?
  /// The step's round and ordinal in it (reviewers first, then the revision),
  /// set on its turn only: one turn per step, a unique claim.
  answerReviewRound      Int?
  answerReviewStep       Int?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  assistantModelRuns     ModelRun[]        @relation("AssistantMessageRun")
  author                 User?             @relation("ProjectMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  branchSourceModelRun   ModelRun?         @relation("BranchSourceModelRun", fields: [branchSourceModelRunId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  activeLeafForChats     Chat[]            @relation("ChatActiveLeaf")
  chat                   Chat              @relation("ChatMessages", fields: [chatId], references: [id], onDelete: Cascade)
  children               Message[]         @relation("MessageBranches")
  parent                 Message?          @relation("MessageBranches", fields: [chatId, parentMessageId], references: [chatId, id], onDelete: Restrict, onUpdate: Restrict, map: "Message_chatId_parentMessageId_fkey")
  memoryToolEvents       MemoryToolEvent[]
  userModelRuns          ModelRun[]        @relation("UserMessageRun")
  scheduledTaskOccurrences ScheduledTaskOccurrence[]
  scheduledTaskCarryovers  ScheduledTaskCarryover[]
  /// The migration uses column-scoped SET NULL so deleting a session never clears chatId.
  answerReviewSession      AnswerReviewSession? @relation("AnswerReviewSessionMessages", fields: [chatId, answerReviewSessionId], references: [chatId, id], onDelete: SetNull, onUpdate: Restrict, map: "Message_chatId_answerReviewSessionId_fkey")
  answerReviewSources      AnswerReviewSession[] @relation("AnswerReviewSource")
  problemReports           AnswerProblemReport[]

  @@unique([chatId, id], map: "Message_chatId_id_key")
  @@unique([answerReviewSessionId, answerReviewRound, answerReviewStep])
  @@index([chatId, parentMessageId])
  @@index([chatId, createdAt])
  @@index([authorUserId])
  @@index([branchSourceModelRunId])
}

/// Cross-model answer review of one answer: reviewer models critique it and
/// its author model revises it, each step an ordinary run of a turn the
/// server writes (`Message.answerReviewSessionId`). Model references are
/// frozen `{ provider, modelId, name }` catalog identities with their display
/// snapshot; `reviewers` holds the current round's one or two, in order.
model AnswerReviewSession {
  id                       String                  @id @default(uuid())
  chatId                   String
  /// The initiator, who alone starts steps; null once the account is deleted.
  userId                   String?
  sourceAssistantMessageId String
  mode                     AnswerReviewMode
  authorModel              Json
  reviewers                Json
  /// Null for a manual session: the user adds rounds.
  maxRounds                Int?
  round                    Int                     @default(1)
  state                    AnswerReviewState       @default(running)
  stopReason               AnswerReviewStopReason?
  /// Automatic only: the controls the user's send froze for every step (its
  /// Search, MCP, Workspace, Skills and time zone, with each reviewer's
  /// Search as the composer reconciled it for that model).
  controls                 Json?
  /// Automatic only: the driver handled the session's end (its one
  /// notification) after it stopped running; at most once.
  endNotifiedAt            DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  chat                     Chat                    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  /// A deleted initiator leaves the session and its steps, read-only, in their chat.
  user                     User?                   @relation("AnswerReviewInitiator", fields: [userId], references: [id], onDelete: SetNull)
  sourceAssistantMessage   Message                 @relation("AnswerReviewSource", fields: [chatId, sourceAssistantMessageId], references: [chatId, id], onDelete: Cascade, onUpdate: Restrict, map: "AnswerReviewSession_source_fkey")
  messages                 Message[]               @relation("AnswerReviewSessionMessages")

  @@unique([chatId, id])
  @@unique([chatId, sourceAssistantMessageId])
  @@index([chatId, state])
  @@index([mode, state])
  @@index([userId])
}

/// A user's report that a persisted answer went wrong, for administrators
/// (Control Center Health): one per user and answer, updated in place. It
/// holds a reason and the user's optional comment, never the question or the
/// answer. The application prunes it 90 days after its last change.
model AnswerProblemReport {
  id        String                    @id @default(uuid())
  chatId    String
  messageId String
  /// The answer's run, for the administrator's run lookup. The migration uses
  /// column-scoped SET NULL so deleting the run never clears chatId.
  runId     String?
  userId    String
  reason    AnswerProblemReportReason
  /// User text only administrators see; never logged or sent to telemetry.
  comment   String?                   @db.VarChar(1000)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  message   Message                   @relation(fields: [chatId, messageId], references: [chatId, id], onDelete: Cascade, onUpdate: Restrict, map: "AnswerProblemReport_message_fkey")
  run       ModelRun?                 @relation(fields: [chatId, runId], references: [chatId, id], onDelete: SetNull, onUpdate: Restrict, map: "AnswerProblemReport_run_fkey")
  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([chatId, runId])
  @@index([updatedAt])
  @@index([userId])
}

/// Content-free claim/result identity. Provider work is never replayed automatically.
model ChatContinuation {
  workspaceSeed     ChatContinuationWorkspaceSeed?
  steps             ChatContinuationStep[]
  id                String   @id @default(uuid())
  sourceChatId      String
  sourceMessageId   String
  snapshotUpdatedAt DateTime
  actorUserId       String?
  attemptId         String   @unique
  requestedProviderModelId String?
  leaseExpiresAt    DateTime?
  cancelRequestedAt DateTime?
  completedParts    Int      @default(0)
  progressStage     String   @default("preparing") @db.VarChar(16)
  status            String   @db.VarChar(16)
  errorCode         String?  @db.VarChar(64)
  newChatId         String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  actor             User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  sourceChat        Chat     @relation("SourceChatContinuation", fields: [sourceChatId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  sourceMessage     Message  @relation("SourceMessageContinuation", fields: [sourceChatId, sourceMessageId], references: [chatId, id], onDelete: Cascade, onUpdate: Restrict)
  newChat           Chat?    @relation("ContinuedChat", fields: [newChatId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([sourceChatId, sourceMessageId, snapshotUpdatedAt], map: "ChatContinuation_source_snapshot_key")
  @@index([actorUserId])
}

/// Settled summary fragments support recovery without repeating paid requests.
/// The owning source lifecycle deletes these private derived contents.
model ChatContinuationStep {
  id             String   @id @default(uuid())
  continuationId String
  attemptId      String
  requestHash    String   @db.VarChar(64)
  status         String   @db.VarChar(16)
  summary        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  continuation   ChatContinuation @relation(fields: [continuationId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([continuationId, requestHash])
}

/// Private Workspace archive captured for one continuation claim. It is never
/// exposed as a conversation attachment or model input.
model ChatContinuationWorkspaceSeed {
  id               String                              @id @default(uuid())
  continuationId   String?                             @unique
  sourceChatId     String?
  newChatId        String?                             @unique
  status           ChatContinuationWorkspaceSeedStatus @default(CAPTURING)
  failureCode      String?                             @db.VarChar(64)
  storageKey       String?
  checksum         String?                             @db.Char(64)
  byteSize         Int?
  attemptCount     Int                                 @default(0)
  leaseToken       String?                             @db.VarChar(64)
  leaseExpiresAt   DateTime?
  restoreStartedAt DateTime?
  /// A scheduled task's monthly rotation captured this seed from the task's
  /// previous chat. Until it is restored the task's scheduled runs in the new
  /// chat fail closed instead of opening an empty project, and the source disk
  /// keeps its retention pin. Deleting the task leaves an ordinary seed.
  scheduledTaskId  String?
  createdAt        DateTime                            @default(now())
  updatedAt        DateTime                            @updatedAt
  continuation     ChatContinuation?                   @relation(fields: [continuationId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  sourceChat       Chat?                               @relation("ContinuationWorkspaceSeedSource", fields: [sourceChatId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  newChat          Chat?                               @relation("ContinuationWorkspaceSeedDestination", fields: [newChatId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  scheduledTask    ScheduledTask?                      @relation(fields: [scheduledTaskId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([status, leaseExpiresAt])
  @@index([sourceChatId, status])
  @@index([newChatId, status])
  @@index([scheduledTaskId, status])
}

enum ChatTitleGenerationStatus {
