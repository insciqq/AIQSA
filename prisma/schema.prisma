  @@unique([userId, memoryReviewId, sourceMessageId, sourceMessageContentHash, sourceStartOffset, sourceEndOffset], map: "MemoryMaintenanceSuppression_span_key")
  @@index([userId, sourceMessageId])
}

/// Recovery-only staging for one strict automatic-fact extraction result.
/// Provider reasoning and raw response envelopes never enter this owner. The
