  updatedAt            DateTime            @updatedAt
  group                Group?              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  providerConnection   ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: Restrict)
  providerModel        ProviderModel?      @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  user                 User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([providerConnectionId])
  @@index([providerModelId])
  @@index([searchStrategy])
  @@index([userId])
}

model Folder {
  id                   String   @id @default(uuid())
  userId               String
  parentId             String?
  name                 String
  projectMemory        String   @default("")
  defaultKnowledgePlan Json?
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  chats                Chat[]
  children             Folder[] @relation("FolderHierarchy")
  parent               Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, parentId, name])
  @@unique([userId, id])
  @@index([parentId])
  @@index([userId, sortOrder])
  @@index([userId, parentId, sortOrder])
}

enum AssistantPublicationScope {
  group
  installation
}

enum SkillPublicationScope {
  group
  installation
}

enum SkillShareRequestState {
  pending
  approved
  rejected
  withdrawn
  superseded
}

enum AssistantListingRequestState {
  pending
  approved
  rejected
  withdrawn
  superseded
}

enum AssistantRowPolicy {
  fixed
  adjustable
}

enum AssistantMcpMode {
  inherit
  off
  exact
}

enum SkillsMode {
  auto
  off
}

enum AssistantSkillMode {
  pinned
  available
}

enum ModelRunSkillMode {
  pinned
  loaded
}

enum KnowledgeBasePublicationScope {
  group
  installation
}

enum KnowledgeDocumentIngestState {
  queued
  parsing
  chunking
  embedding
  ready
  failed
}

enum KnowledgeIndexGenerationStatus {
  building
  ready
  active
  retired
  failed
}

enum KnowledgeIndexProfileExecutionAuthority {
  installation
  legacy_user
}

enum KnowledgeIndexProfilePreflightStatus {
  ready
  failed
}

enum KnowledgePdfProcessingMode {
  local
  system_model_direct_pdf
  system_model_vision
}

enum KnowledgePdfProcessingAttemptState {
  reserved
  dispatched
  settled
  ambiguous
}

enum KnowledgeSourceArtifactState {
  pending
  processing
  ready
  failed
}

enum KnowledgeSourceArtifactProcessingStage {
  queued
  parsing
  chunking
  embedding
}

enum KnowledgeHierarchicalIndexState {
  building
  ready
  failed
}

enum KnowledgeSearchProjectionState {
  PENDING
  BUILDING
  READY
  RETRY_WAIT
  FAILED
  DELETING
  DELETED
}

enum KnowledgeExactEntryKind {
  date
  filename
  heading
  identifier
  number
  tag
  title
}

enum KnowledgeUploadTransport {
  PROXY
  MULTIPART
}

enum KnowledgeUploadItemState {
  QUEUED
  UPLOADING
  STORED
  PROCESSING
  NEEDS_ATTENTION
  CANCELLED
  REUSED
}

enum KnowledgeDeletionTargetType {
  SOURCE
  BASE
}

enum KnowledgeDeletionState {
  PENDING
  RUNNING
  RETRY_WAIT
  BLOCKED_REQUIRES_ADMIN
  SUCCEEDED
}

enum KnowledgeDeletionObjectDisposition {
  PENDING
  DELETED
  RETAINED
}

model AssistantDefinition {
  id                String                    @id @default(uuid())
  ownerUserId       String
  version           Int                       @default(1)
  archivedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  name               String
  description        String                    @default("")
  category           String?
  avatar             Json
  /// Null means Inherit; a fixed model row requires a concrete model.
  providerModelId    String?
  systemPrompt       String
  /// Retired and merged into systemPrompt; kept only for previous-release writers.
  developerPrompt    String?
  answerRules        String?
  responseReminder   String                    @default("")
  skillsMode         SkillsMode                @default(auto)
  runControls        Json                      @default("{}")
  searchPlan         Json
  mcpMode            AssistantMcpMode          @default(off)
  mcpServerIds       String[]                  @default([])
  knowledgeSelection Json                      @default("{\"baseIds\":[],\"mode\":\"none\",\"sourceIds\":[],\"version\":1}")
  starterPrompts     String[]                  @default([])
  modelPolicy        AssistantRowPolicy        @default(fixed)
  /// An empty control set is never fixed, so the column default matches runControls.
  controlsPolicy     AssistantRowPolicy        @default(adjustable)
  searchPolicy       AssistantRowPolicy        @default(fixed)
  toolsPolicy        AssistantRowPolicy        @default(fixed)
  knowledgePolicy    AssistantRowPolicy        @default(fixed)
  skillsPolicy       AssistantRowPolicy        @default(fixed)
  owner              User                      @relation("AssistantDefinitionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  providerModel      ProviderModel?            @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  boundChats         Chat[]
  defaultForSettings UserSettings[]            @relation("UserDefaultAssistant")
  listingRequests    AssistantListingRequest[]
  pins               AssistantPin[]
  projectBindings    ProjectAssistantBinding[]
  publications       AssistantPublication[]
  skillLinks         AssistantSkill[]
  modelRuns          ModelRun[]

  @@unique([ownerUserId, id])
  @@index([ownerUserId, archivedAt])
  @@index([providerModelId])
}

model AssistantPublication {
  id                String                    @id @default(uuid())
  assistantId       String
  scope             AssistantPublicationScope
  groupId           String?
  publishedByUserId String?
  /// Installation scope only; unique among Featured publications through a SQL partial index.
  featuredOrder     Int?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  assistant         AssistantDefinition       @relation(fields: [assistantId], references: [id], onDelete: Restrict)
  group             Group?                    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  publishedBy       User?                     @relation("AssistantPublicationPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  @@unique([assistantId, groupId])
  @@index([groupId])
  @@index([assistantId, scope])
}

model AssistantPin {
  userId      String
  assistantId String
  createdAt   DateTime            @default(now())
  assistant   AssistantDefinition @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, assistantId])
  @@index([assistantId])
}

model SkillDefinition {
  id                     String                   @id @default(uuid())
  ownerUserId            String
  currentRevisionId      String?                  @unique
  sharedRevisionId       String?                  @unique
  importSourceJson       Json?
  version                Int                      @default(1)
  archivedAt             DateTime?
  deletedAt              DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  /// The composite relation proves the current pointer targets a revision of this definition.
  currentRevision        SkillRevision?           @relation("SkillCurrentRevision", fields: [id, currentRevisionId], references: [skillId, id], onDelete: Restrict, onUpdate: Restrict, map: "SkillDefinition_currentRevision_fkey")
  sharedRevision         SkillRevision?           @relation("SkillSharedRevision", fields: [id, sharedRevisionId], references: [skillId, id], onDelete: Restrict, onUpdate: Restrict, map: "SkillDefinition_sharedRevision_fkey")
  owner                  User                     @relation("SkillDefinitionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  assistantLinks         AssistantSkill[]
  publications           SkillPublication[]
  projectBindings        ProjectSkillBinding[]
  revisions              SkillRevision[]          @relation("SkillRevisions")
  shareRequests          SkillShareRequest[]
  preferences            UserSkillPreference[]

  @@unique([id, currentRevisionId])
  @@unique([id, sharedRevisionId])
  @@unique([ownerUserId, id])
  @@index([ownerUserId, archivedAt])
  @@index([deletedAt, updatedAt, id])
}

model SkillRevision {
  id               String                 @id @default(uuid())
  skillId          String
  revisionNumber   Int
  schemaVersion    Int                    @default(1)
  name             String
  description      String                 @default("")
  instructions     String
  frontmatterJson  Json?
  bundleDigest     String                 @default("")
  fileCount        Int                    @default(0)
  bundleByteSize   Int                    @default(0)
  hasExecutables   Boolean                @default(false)
  /// Staged binary objects are never selected before checksum settlement.
  bundleReady      Boolean                @default(true)
  authorUserId     String?
  createdAt        DateTime               @default(now())
  skill            SkillDefinition        @relation("SkillRevisions", fields: [skillId], references: [id], onDelete: Restrict)
  author           User?                  @relation("SkillRevisionAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  currentFor       SkillDefinition?       @relation("SkillCurrentRevision")
  sharedFor        SkillDefinition?       @relation("SkillSharedRevision")
  modelRunBindings ModelRunSkillBinding[]
  files            SkillRevisionFile[]
  shareRequests    SkillShareRequest[]

  @@unique([skillId, revisionNumber])
  @@unique([skillId, id])
  @@index([authorUserId])
}

model SkillRevisionFile {
  revisionId  String
  skillId     String
  path        String
  byteSize    Int
  checksum    String
  kind        String
  executable  Boolean       @default(false)
  textContent String?
  storageKey  String?
  revision    SkillRevision @relation(fields: [skillId, revisionId], references: [skillId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([revisionId, path])
  @@index([skillId, revisionId])
  @@index([storageKey])
}

model SkillPublication {
  id                String                @id @default(uuid())
  skillId           String
  scope             SkillPublicationScope
  groupId           String?
  publishedByUserId String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  skill             SkillDefinition       @relation(fields: [skillId], references: [id], onDelete: Restrict)
  group             Group?                @relation(fields: [groupId], references: [id], onDelete: Restrict)
  publishedBy       User?                 @relation("SkillPublicationPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  @@unique([skillId, groupId])
  @@index([groupId])
  @@index([skillId, scope])
}

model SkillShareRequest {
  id                String                 @id @default(uuid())
  skillId           String
  revisionId        String
  requestedByUserId String
  state             SkillShareRequestState @default(pending)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime               @default(now())
  skill             SkillDefinition        @relation(fields: [requestedByUserId, skillId], references: [ownerUserId, id], onDelete: Restrict, onUpdate: Restrict)
  revision          SkillRevision          @relation(fields: [skillId, revisionId], references: [skillId, id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy       User                   @relation("SkillShareRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy        User?                  @relation("SkillShareReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([state, createdAt, id])
  @@index([skillId, createdAt, id])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
}

/// One pending request per Assistant (SQL partial unique index); decided rows are frozen by a guard trigger.
model AssistantListingRequest {
  id                String                       @id @default(uuid())
  assistantId       String
  requestedByUserId String
  state             AssistantListingRequestState @default(pending)
  definitionVersion Int
  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime                     @default(now())
  assistant         AssistantDefinition          @relation(fields: [requestedByUserId, assistantId], references: [ownerUserId, id], onDelete: Cascade, onUpdate: Restrict)
  requestedBy       User                         @relation("AssistantListingRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy        User?                        @relation("AssistantListingReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([state, createdAt, id])
  @@index([assistantId, createdAt, id])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
}

model AssistantSkill {
  assistantId String
  skillId     String
  ordinal     Int
  mode        AssistantSkillMode @default(pinned)
  assistant   AssistantDefinition @relation(fields: [assistantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  skill       SkillDefinition     @relation(fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([assistantId, skillId])
  @@unique([assistantId, ordinal])
  @@index([skillId])
}

model UserSkillPreference {
  userId    String
  skillId   String
  enabled   Boolean
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  skill     SkillDefinition @relation(fields: [skillId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([userId, skillId])
  @@index([skillId])
}

model KnowledgeIndexProfile {
  id               String                          @id
  activeRevisionId String?                         @unique
  version          Int                             @default(1)
  updatedByUserId  String?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  /// The composite relation proves the active revision belongs to this installation profile.
  activeRevision   KnowledgeIndexProfileRevision?  @relation("KnowledgeIndexProfileActiveRevision", fields: [id, activeRevisionId], references: [profileId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeIndexProfile_activeRevision_fkey")
  revisions        KnowledgeIndexProfileRevision[] @relation("KnowledgeIndexProfileRevisions")
  updatedBy        User?                           @relation("KnowledgeIndexProfileUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([id, activeRevisionId])
  @@index([updatedByUserId])
}

model KnowledgeIndexProfileRevision {
  id                          String                                  @id @default(uuid())
  profileId                   String
  revisionNumber              Int
  embeddingProviderModelId    String
  embeddingConfiguration      Json
  vectorSpaceFingerprint      String                                  @db.Char(64)
  targetDimension             Int
  chunkingProfileVersion      Int
  pdfProcessingMode           KnowledgePdfProcessingMode              @default(local)
  pdfParserProfileVersion     Int                                     @default(1)
  pdfSystemModelPolicyVersion Int?
  pdfSystemModelSnapshot      Json?
  executionAuthority          KnowledgeIndexProfileExecutionAuthority
  profileConfiguration        Json
  egressPolicy                Json
  preflightStatus             KnowledgeIndexProfilePreflightStatus
  preflightErrorCode          String?                                 @db.VarChar(64)
  preflightCheckedAt          DateTime
  activatedAt                 DateTime
  createdAt                   DateTime                                @default(now())
  activeFor                   KnowledgeIndexProfile?                  @relation("KnowledgeIndexProfileActiveRevision")
  embeddingProviderModel      ProviderModel                           @relation(fields: [embeddingProviderModelId], references: [id], onDelete: Restrict)
  baseSnapshots               KnowledgeBaseSnapshot[]
  generations                 KnowledgeIndexGeneration[]
  profile                     KnowledgeIndexProfile                   @relation("KnowledgeIndexProfileRevisions", fields: [profileId], references: [id], onDelete: Restrict)
  sourceArtifacts             KnowledgeSourceIndexArtifact[]
  runProfileBindings          KnowledgeRunProfileBinding[]

  @@unique([profileId, revisionNumber])
  @@unique([profileId, id])
  @@index([embeddingProviderModelId])
  @@index([profileId, activatedAt])
}

model KnowledgeBase {
  id                      String                         @id @default(uuid())
  ownerUserId             String
  name                    String
  description             String                         @default("")
  activeIndexGenerationId String?                        @unique
  contentRevision         Int                            @default(0)
  sourceRevision          Int                            @default(0)
  version                 Int                            @default(1)
  archivedAt              DateTime?
  trashedAt               DateTime?
  deletionRequestedAt     DateTime?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  /// The composite relation proves the active generation belongs to this base.
  activeIndexGeneration   KnowledgeIndexGeneration?      @relation("KnowledgeBaseActiveIndexGeneration", fields: [id, activeIndexGenerationId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeBase_activeIndexGeneration_fkey")
  documents               KnowledgeDocument[]
  documentVersions        KnowledgeDocumentVersion[]     @relation("KnowledgeDocumentVersionOwner")
  generationDocuments     KnowledgeGenerationDocument[]  @relation("KnowledgeGenerationDocumentOwner")
  indexGenerations        KnowledgeIndexGeneration[]     @relation("KnowledgeBaseIndexGenerations")
  runBindings             KnowledgeRunBinding[]
  owner                   User                           @relation("KnowledgeBaseOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  projectBindings         ProjectKnowledgeBaseBinding[]
  publications            KnowledgeBasePublication[]
  sourceMemberships       KnowledgeBaseSource[]
  sourceSnapshots         KnowledgeBaseSnapshot[]
  usageEvents             UsageEvent[]                   @relation("KnowledgeUsageBase")
  uploadBatches           KnowledgeUploadBatch[]
  v1DocumentSourceMaps    KnowledgeV1DocumentSourceMap[]

  @@unique([id, activeIndexGenerationId])
  @@unique([id, ownerUserId])
  @@index([ownerUserId, trashedAt, archivedAt])
  @@index([trashedAt, deletionRequestedAt, id])
}

model KnowledgeUploadBatch {
  id              String                @id @default(uuid())
  ownerUserId     String
  knowledgeBaseId String
  clientBatchId   String                @db.VarChar(128)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  items           KnowledgeUploadItem[]
  knowledgeBase   KnowledgeBase         @relation(fields: [knowledgeBaseId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeUploadBatch_base_owner_fkey")
  owner           User                  @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([ownerUserId, clientBatchId])
  @@unique([id, ownerUserId])
  @@index([knowledgeBaseId, updatedAt, id])
  @@index([ownerUserId, updatedAt, id])
}

model KnowledgeUploadItem {
  id                 String                        @id @default(uuid())
  batchId            String
  clientFileId       String                        @db.VarChar(128)
  attemptNumber      Int                           @default(1)
  fileName           String
  declaredMimeType   String
  normalizedMimeType String
  declaredByteSize   Int
  checksumHint       String?                       @db.Char(64)
  storageKey         String?
  transport          KnowledgeUploadTransport
  multipartUploadId  String?
  sessionExpiresAt   DateTime
  state              KnowledgeUploadItemState      @default(QUEUED)
  uploadedByteSize   Int                           @default(0)
  errorCode          String?                       @db.VarChar(64)
  sourceId           String?
  sourceVersionId    String?
  sourceArtifactId   String?
  documentId         String?
  documentVersionId  String?
  settledAt          DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  batch              KnowledgeUploadBatch          @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  parts              KnowledgeUploadPart[]
  sourceArtifact     KnowledgeSourceIndexArtifact? @relation("KnowledgeUploadItemSourceArtifact", fields: [sourceVersionId, sourceArtifactId], references: [sourceVersionId, id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([batchId, clientFileId])
  @@unique([batchId, id])
  @@index([storageKey])
  @@index([sourceId])
  @@index([sourceVersionId, sourceArtifactId], map: "KnowledgeUploadItem_source_artifact_idx")
  @@index([state, sessionExpiresAt, updatedAt, id])
}

model KnowledgeUploadPart {
  uploadItemId String
  partNumber   Int
  byteOffset   Int
  byteSize     Int
  etag         String?
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  uploadItem   KnowledgeUploadItem @relation(fields: [uploadItemId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([uploadItemId, partNumber])
  @@index([uploadItemId, completedAt, partNumber])
}

model KnowledgeIndexGeneration {
  id                       String                             @id @default(uuid())
  knowledgeBaseId          String
  profileRevisionId        String?
  embeddingProviderModelId String
  sourceIndexGenerationId  String?
  sourceBaseVersion        Int?
  targetContentRevision    Int?
  targetSourceRevision     Int?
  embeddingConfiguration   Json
  vectorSpaceFingerprint   String                             @db.Char(64)
  targetDimension          Int
  chunkingProfileVersion   Int
  indexedContentRevision   Int                                @default(0)
  status                   KnowledgeIndexGenerationStatus     @default(building)
  lastErrorCode            String?                            @db.VarChar(64)
  readyAt                  DateTime?
  activatedAt              DateTime?
  retiredAt                DateTime?
  failedAt                 DateTime?
  createdAt                DateTime                           @default(now())
  updatedAt                DateTime                           @updatedAt
  activeFor                KnowledgeBase?                     @relation("KnowledgeBaseActiveIndexGeneration")
  baseSnapshots            KnowledgeBaseSnapshot[]
  chunks                   KnowledgeChunk[]
  derivedIndexGenerations  KnowledgeIndexGeneration[]         @relation("KnowledgeIndexGenerationSource")
  embeddingProviderModel   ProviderModel                      @relation(fields: [embeddingProviderModelId], references: [id], onDelete: Restrict)
  generationDocuments      KnowledgeGenerationDocument[]
  ingestDocumentVersions   KnowledgeDocumentVersion[]         @relation("KnowledgeDocumentVersionIngestGeneration")
  knowledgeBase            KnowledgeBase                      @relation("KnowledgeBaseIndexGenerations", fields: [knowledgeBaseId], references: [id], onDelete: Restrict)
  profileRevision          KnowledgeIndexProfileRevision?     @relation(fields: [profileRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  runBindings              KnowledgeRunBinding[]
  sourceIndexGeneration    KnowledgeIndexGeneration?          @relation("KnowledgeIndexGenerationSource", fields: [knowledgeBaseId, sourceIndexGenerationId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeIndexGeneration_source_fkey")
  usageEvents              UsageEvent[]                       @relation("KnowledgeUsageGeneration")
  v1SourceArtifactMaps     KnowledgeV1GenerationArtifactMap[]

  @@unique([knowledgeBaseId, id])
  @@index([embeddingProviderModelId])
  @@index([knowledgeBaseId, status])
  @@index([profileRevisionId])
  @@index([profileRevisionId, status], map: "KnowledgeIndexGeneration_profile_status_idx")
  @@index([sourceIndexGenerationId])
}

model KnowledgeSource {
  id                  String                          @id @default(uuid())
  ownerUserId         String
  name                String
  description         String                          @default("")
  tags                String[]                        @default([])
  currentVersionId    String?                         @unique
  pendingVersionId    String?                         @unique
  version             Int                             @default(1)
  trashedAt           DateTime?
  deletionRequestedAt DateTime?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  baseMemberships     KnowledgeBaseSource[]
  currentVersion      KnowledgeSourceVersion?         @relation("KnowledgeSourceCurrentVersion", fields: [id, currentVersionId], references: [sourceId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeSource_currentVersion_fkey")
  owner               User                            @relation("KnowledgeSourceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  pendingVersion      KnowledgeSourceVersion?         @relation("KnowledgeSourcePendingVersion", fields: [id, pendingVersionId], references: [sourceId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeSource_pendingVersion_fkey")
  projectBindings     ProjectKnowledgeSourceBinding[]
  runSourceBindings   KnowledgeRunSourceBinding[]
  snapshotSources     KnowledgeBaseSnapshotSource[]
  v1DocumentMaps      KnowledgeV1DocumentSourceMap[]
  versions            KnowledgeSourceVersion[]        @relation("KnowledgeSourceVersions")

  @@unique([id, ownerUserId])
  @@unique([id, currentVersionId])
  @@unique([id, pendingVersionId])
  @@index([ownerUserId, trashedAt, name])
  @@index([trashedAt, deletionRequestedAt, id])
}

model KnowledgeDeletionJob {
  id              String                      @id @default(uuid())
  ownerUserId     String
  targetType      KnowledgeDeletionTargetType
  targetId        String
  state           KnowledgeDeletionState      @default(PENDING)
  manifestVersion Int                         @default(1)
  claimToken      String?
  claimedAt       DateTime?
  leaseExpiresAt  DateTime?
  attemptCount    Int                         @default(0)
  nextAttemptAt   DateTime                    @default(now())
  lastAttemptAt   DateTime?
  completedAt     DateTime?
  lastErrorCode   String?                     @db.VarChar(64)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  objects         KnowledgeDeletionObject[]

  @@unique([targetType, targetId])
  @@index([state, nextAttemptAt, leaseExpiresAt, createdAt, id])
  @@index([ownerUserId, state, createdAt, id])
}

model KnowledgeDeletionObject {
  knowledgeDeletionJobId String
  storageKey             String
  disposition            KnowledgeDeletionObjectDisposition @default(PENDING)
  settledAt              DateTime?
  createdAt              DateTime                           @default(now())
  updatedAt              DateTime                           @updatedAt
  job                    KnowledgeDeletionJob               @relation(fields: [knowledgeDeletionJobId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([knowledgeDeletionJobId, storageKey])
  @@index([storageKey, disposition])
}

model KnowledgeSourceVersion {
  id                 String                                @id @default(uuid())
  sourceId           String
  ownerUserId        String
  versionNumber      Int
  fileName           String
  mimeType           String
  byteSize           Int
  checksum           String                                @db.Char(64)
  originalStorageKey String?
  createdAt          DateTime                              @default(now())
  artifacts          KnowledgeSourceIndexArtifact[]
  currentFor         KnowledgeSource?                      @relation("KnowledgeSourceCurrentVersion")
  pendingFor         KnowledgeSource?                      @relation("KnowledgeSourcePendingVersion")
  runSourceBindings  KnowledgeRunSourceBinding[]
  snapshotSources    KnowledgeBaseSnapshotSource[]
  source             KnowledgeSource                       @relation("KnowledgeSourceVersions", fields: [sourceId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeSourceVersion_source_owner_fkey")
  v1VersionMaps      KnowledgeV1DocumentVersionSourceMap[]

  @@unique([sourceId, versionNumber])
  @@unique([sourceId, id])
  @@unique([id, ownerUserId])
  @@unique([sourceId, id, ownerUserId])
  @@index([originalStorageKey])
}

model KnowledgeSourceIndexArtifact {
  id                       String                                  @id @default(uuid())
  sourceVersionId          String
  profileRevisionId        String
  processingGeneration     Int                                     @default(0)
  state                    KnowledgeSourceArtifactState            @default(pending)
  processingStage          KnowledgeSourceArtifactProcessingStage?
  normalizedTextStorageKey String?
  normalizedTextByteSize   Int?
  normalizedTextChecksum   String?                                 @db.Char(64)
  pageCount                Int?
  chunkCount               Int?
  embeddedPassageCount     Int                                     @default(0)
  warningCodes             String[]                                @default([])
  errorCode                String?                                 @db.VarChar(64)
  claimToken               String?                                 @db.VarChar(128)
  claimedAt                DateTime?
  attemptCount             Int                                     @default(0)
  nextAttemptAt            DateTime                                @default(now())
  processingStartedAt      DateTime?
  readyAt                  DateTime?
  createdAt                DateTime                                @default(now())
  updatedAt                DateTime                                @updatedAt
  profileRevision          KnowledgeIndexProfileRevision           @relation(fields: [profileRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pdfProcessingAttempts    KnowledgePdfProcessingAttempt[]
  runSourceBindings        KnowledgeRunSourceBinding[]
  hierarchicalIndexes      KnowledgeHierarchicalIndexArtifact[]
  snapshotSources          KnowledgeBaseSnapshotSource[]
  sourceVersion            KnowledgeSourceVersion                  @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
