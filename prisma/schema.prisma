generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthAccessRuleKind {
  email
  domain
}

enum AuthFlowTokenPurpose {
  email_verification
  password_reset
  invite_acceptance
}

enum AuthIdentityProvider {
  password
  google
  yandex
}

enum UserRole {
  admin
  user
}

enum UserStatus {
  pending
  active
  disabled
  denied
}

enum MessageStatus {
  queued
  streaming
  complete
  cancelled
  error
}

enum ModelRunStatus {
  queued
  streaming
  in_progress
  complete
  cancelled
  error
}

enum SearchRunStatus {
  complete
  error
}

enum AttachmentStatus {
  ready
}

enum McpOAuthConnectionState {
  ready
  reauthorization_required
  disconnecting
  disconnected
}

enum McpOAuthPurpose {
  user
  validation
}

enum McpRuntimeState {
  starting
  ready
  failed
  idle
  stopping
}

enum McpActivationStage {
  queued
  resolving
  preparing_runtime
  connecting
  discovering_tools
  publishing
  ready
  failed
}

enum ModelRunToolCallState {
  pending
  running
  complete
  error
  cancelled
}

enum ProviderUnassignedPolicy {
  use_default
  require_assignment
}

enum ProviderCredentialCheckStatus {
  available
  unavailable
}

enum ProviderRunRole {
  answer
  search
}

enum ProviderCredentialSource {
  default
  group
  user
}

model User {
  id                            String                             @id @default(uuid())
  email                         String?                            @unique
  displayName                   String
  role                          UserRole                           @default(user)
  status                        UserStatus                         @default(pending)
  createdAt                     DateTime                           @default(now())
  updatedAt                     DateTime                           @updatedAt
  accessGrants                  AccessGrant[]
  attachments                   Attachment[]
  authAccessRulesCreated        AuthAccessRule[]                   @relation("AuthAccessRuleCreator")
  authFlowTokens                AuthFlowToken[]
  authIdentities                AuthIdentity[]
  authInvitesAccepted           AuthInvite[]                       @relation("AuthInviteAcceptedUser")
  authInvitesCreated            AuthInvite[]                       @relation("AuthInviteCreator")
  authSessions                  AuthSession[]
  authSessionsRevoked           AuthSession[]                      @relation("AuthSessionRevoker")
  chats                         Chat[]
  folders                       Folder[]
  groups                        UserGroup[]
  mcpGrants                     McpGrant[]
  mcpActivationJobs             McpActivationJob[]
  mcpOAuthConnections           McpOAuthConnection[]
  mcpUserServers                McpUserServer[]
  modelRuns                     ModelRun[]
  promptPresets                 PromptPreset[]
  providerCredentialAssignments ProviderUserCredentialAssignment[]
  runProfileUpdates             RunProfile[]                       @relation("RunProfileUpdater")
  settings                      UserSettings?
  sharedSnapshots               SharedChatSnapshot[]
  smtpActivations               SmtpControl[]                      @relation("SmtpControlActivator")
  smtpConfigurationEdits        SmtpControl[]                      @relation("SmtpControlUpdater")
  usageEvents                   UsageEvent[]
}

model SmtpControl {
  id                           String    @id
  draftConfig                  Json?
  draftPasswordEnvelope        String?
  draftSecretGeneration        Int?
  draftVersion                 Int       @default(0)
  testedDraftVersion           Int?
  draftTestVersion             Int?
  draftTestAt                  DateTime?
  draftTestCode                String?
  activeConfig                 Json?
  activePasswordEnvelope       String?
  activeSecretGeneration       Int?
  activeVersion                Int       @default(0)
  enabled                      Boolean   @default(false)
  secretGenerationCounter      Int       @default(0)
  healthActiveVersion          Int?
  lastAttemptAt                DateTime?
  lastAcceptedAt               DateTime?
  lastFailureAt                DateTime?
  lastFailureCode              String?
  configurationUpdatedAt       DateTime?
  configurationUpdatedByUserId String?
  activatedAt                  DateTime?
  activatedByUserId            String?
  createdAt                    DateTime  @default(now())
  activatedBy                  User?     @relation("SmtpControlActivator", fields: [activatedByUserId], references: [id], onDelete: SetNull)
  configurationUpdatedBy       User?     @relation("SmtpControlUpdater", fields: [configurationUpdatedByUserId], references: [id], onDelete: SetNull)
}

model AuthIdentity {
  id                String               @id @default(uuid())
  userId            String
  provider          AuthIdentityProvider
  providerAccountId String
  normalizedEmail   String
  emailVerifiedAt   DateTime?
  passwordHash      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  flowTokens        AuthFlowToken[]
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([provider, normalizedEmail])
  @@index([normalizedEmail])
  @@index([userId])
}

model AuthSession {
  id                 String    @id @default(uuid())
  userId             String
  tokenHash          String    @unique
  expiresAt          DateTime
  revokedAt          DateTime?
  revokedByUserId    String?
  revokedReason      String?
  createdByIp        String?
  createdByUserAgent String?
  lastSeenAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  revokedBy          User?     @relation("AuthSessionRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([revokedAt])
  @@index([userId, expiresAt])
}

model AuthAccessRule {
  id              String                @id @default(uuid())
  kind            AuthAccessRuleKind
  value           String
  enabled         Boolean               @default(true)
  createdByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  createdBy       User?                 @relation("AuthAccessRuleCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  defaultGroups   AuthAccessRuleGroup[]

  @@unique([kind, value])
  @@index([enabled])
}

model AuthAccessRuleGroup {
  accessRuleId String
  groupId      String
  role         String         @default("member")
  createdAt    DateTime       @default(now())
  accessRule   AuthAccessRule @relation(fields: [accessRuleId], references: [id], onDelete: Cascade)
  group        Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([accessRuleId, groupId])
  @@index([groupId])
}

model AuthInvite {
  id               String            @id @default(uuid())
  email            String
  normalizedEmail  String
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  createdByUserId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  acceptedBy       User?             @relation("AuthInviteAcceptedUser", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  createdBy        User?             @relation("AuthInviteCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  defaultGroups    AuthInviteGroup[]
  flowTokens       AuthFlowToken[]

  @@index([expiresAt])
  @@index([normalizedEmail])
  @@index([revokedAt])
}

model AuthInviteGroup {
  inviteId  String
  groupId   String
  role      String     @default("member")
  createdAt DateTime   @default(now())
  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invite    AuthInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@id([inviteId, groupId])
  @@index([groupId])
}

model AuthFlowToken {
  id              String               @id @default(uuid())
  purpose         AuthFlowTokenPurpose
  tokenHash       String               @unique
  userId          String?
  identityId      String?
  inviteId        String?
  normalizedEmail String?
  sentToEmail     String?
  expiresAt       DateTime
  consumedAt      DateTime?
  metadata        Json                 @default("{}")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  identity        AuthIdentity?        @relation(fields: [identityId], references: [id], onDelete: Cascade)
  invite          AuthInvite?          @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user            User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([inviteId])
  @@index([normalizedEmail])
  @@index([consumedAt])
  @@index([purpose, expiresAt])
  @@index([userId])
}

model Group {
  id                            String                              @id @default(uuid())
  name                          String                              @unique
  systemRole                    GroupSystemRole?                    @unique
  archivedAt                    DateTime?
  createdAt                     DateTime                            @default(now())
  updatedAt                     DateTime                            @updatedAt
  accessGrants                  AccessGrant[]
  authAccessRuleDefaults        AuthAccessRuleGroup[]
  authInviteDefaults            AuthInviteGroup[]
  mcpGrants                     McpGrant[]
  providerCredentialAssignments ProviderGroupCredentialAssignment[]
  users                         UserGroup[]

  @@index([archivedAt])
}

enum GroupSystemRole {
  full_access
}

model UserGroup {
  userId    String
  groupId   String
  role      String   @default("member")
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

model UserSettings {
  id                      String         @id @default(uuid())
  userId                  String         @unique
  defaultProviderModelId  String?
  defaultPromptPresetId   String?
  defaultFolderId         String?
  defaultSearchStrategyId String         @default("openai-native-web-search")
  defaultSearchPlan       Json           @default("{\"mode\":\"all_selected\",\"optionIds\":[]}")
  defaultControlValues    Json           @default("{}")
  showCitations           Boolean        @default(true)
  showReasoningBlocks     Boolean        @default(false)
  showToolActivity        Boolean        @default(true)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultProviderModel    ProviderModel? @relation("UserDefaultProviderModel", fields: [defaultProviderModelId], references: [id], onDelete: Restrict)

  @@index([defaultProviderModelId])
}

model AccessGrant {
  id                   String              @id @default(uuid())
  userId               String?
  groupId              String?
  providerConnectionId String?
  providerModelId      String?
  searchStrategy       String?
  enabled              Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  group                Group?              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  providerConnection   ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: Restrict)
  providerModel        ProviderModel?      @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  user                 User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([providerConnectionId])
  @@index([providerModelId])
  @@index([searchStrategy])
  @@index([userId])
}

model Folder {
  id            String   @id @default(uuid())
  userId        String
  parentId      String?
  name          String
  projectMemory String   @default("")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  chats         Chat[]
  children      Folder[] @relation("FolderHierarchy")
  parent        Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, parentId, name])
  @@index([parentId])
  @@index([userId, sortOrder])
  @@index([userId, parentId, sortOrder])
}

model PromptPreset {
  id              String    @id @default(uuid())
  userId          String
  name            String
  systemPrompt    String
  developerPrompt String?
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messages        Message[]
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model ProviderModel {
  id                     String                         @id @default(uuid())
  connectionId           String
  templateKey            String?                        @unique
  provider               String
  modelId                String
  displayName            String
  contextWindow          Int
  inputTokenPriceMicros  Int                            @default(0)
  outputTokenPriceMicros Int                            @default(0)
  supportsVision         Boolean                        @default(false)
  supportsPdf            Boolean                        @default(false)
  supportsReasoning      Boolean                        @default(false)
  supportsNativeSearch   Boolean                        @default(false)
  enabled                Boolean                        @default(true)
  draftConfig            Json                           @default("{}")
  draftVersion           Int                            @default(1)
  activeConfig           Json?
  activeVersion          Int                            @default(0)
  activatedAt            DateTime?
  capabilities           Json
  defaultParams          Json
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  accessGrants           AccessGrant[]
  activeCredentialChecks ProviderModelCredentialCheck[]
  connection             ProviderConnection             @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  draftChecks            ProviderDraftCheck[]
  providerRunBindings    ProviderRunBinding[]
  runProfiles            RunProfile[]
  searchStrategies       SearchStrategy[]
  searchRevisions        SearchIntegrationRevision[]
  chatDefaults           Chat[]                         @relation("ChatDefaultProviderModel")
  userDefaults           UserSettings[]                 @relation("UserDefaultProviderModel")

  @@unique([connectionId, id])
  @@index([provider, modelId])
  @@index([connectionId, enabled])
  @@index([provider, enabled])
}

model RunProfile {
  id              String         @id
  description     String
  enabled         Boolean        @default(false)
  providerModelId String?
  reasoningEffort String         @default("medium")
  reasoningMode   String         @default("standard")
  version         Int            @default(1)
  updatedByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  providerModel   ProviderModel? @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  updatedBy       User?          @relation("RunProfileUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([providerModelId])
  @@index([updatedByUserId])
}

model ProviderConnection {
  id                  String                   @id @default(uuid())
  templateKey         String?                  @unique
  displayName         String
  family              String
  enabled             Boolean                  @default(false)
  unassignedPolicy    ProviderUnassignedPolicy @default(use_default)
  defaultCredentialId String?
  draftConfig         Json                     @default("{}")
  draftVersion        Int                      @default(1)
  activeConfig        Json?
  activeVersion       Int                      @default(0)
  activatedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  accessGrants        AccessGrant[]
  credentials         ProviderCredential[]     @relation("ProviderConnectionCredentials")
  defaultCredential   ProviderCredential?      @relation("ProviderConnectionDefaultCredential", fields: [id, defaultCredentialId], references: [connectionId, id], onDelete: Restrict, onUpdate: Restrict, map: "ProviderConnection_defaultCredential_fkey")
  models              ProviderModel[]

  @@index([enabled])
}

model ProviderCredential {
  id                     String                              @id @default(uuid())
  connectionId           String
  label                  String
  enabled                Boolean                             @default(false)
  draftSecretEnvelope    String?
  draftVersion           Int                                 @default(0)
  activeVersionId        String?
  testedAt               DateTime?
  activatedAt            DateTime?
  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt
  activeCredentialChecks ProviderModelCredentialCheck[]
  activeVersion          ProviderCredentialVersion?          @relation("ProviderCredentialActiveVersion", fields: [id, activeVersionId], references: [credentialId, id], onDelete: Restrict, onUpdate: Restrict, map: "ProviderCredential_activeVersion_fkey")
  connection             ProviderConnection                  @relation("ProviderConnectionCredentials", fields: [connectionId], references: [id], onDelete: Restrict)
  defaultForConnections  ProviderConnection[]                @relation("ProviderConnectionDefaultCredential")
  draftChecks            ProviderDraftCheck[]
  groupAssignments       ProviderGroupCredentialAssignment[]
  userAssignments        ProviderUserCredentialAssignment[]
  providerRunBindings    ProviderRunBinding[]
  versions               ProviderCredentialVersion[]         @relation("ProviderCredentialVersions")

  @@unique([connectionId, id])
  @@unique([connectionId, label])
  @@unique([id, activeVersionId])
  @@index([connectionId, enabled])
}

model ProviderCredentialVersion {
  id                     String                         @id @default(uuid())
  credentialId           String
  version                Int
  secretEnvelope         String?
  testEvidence           Json
  testedAt               DateTime
  activatedAt            DateTime
  revokedAt              DateTime?
  createdAt              DateTime                       @default(now())
  activeFor              ProviderCredential?            @relation("ProviderCredentialActiveVersion")
  activeCredentialChecks ProviderModelCredentialCheck[]
  credential             ProviderCredential             @relation("ProviderCredentialVersions", fields: [credentialId], references: [id], onDelete: Restrict)
  draftChecks            ProviderDraftCheck[]
  providerRunBindings    ProviderRunBinding[]

  @@unique([credentialId, id])
  @@unique([credentialId, version])
  @@index([revokedAt])
}

model ProviderGroupCredentialAssignment {
  connectionId String
  groupId      String
  credentialId String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  credential   ProviderCredential @relation(fields: [connectionId, credentialId], references: [connectionId, id], onDelete: Restrict, onUpdate: Restrict, map: "ProviderGroupAssignment_credential_fkey")
  group        Group              @relation(fields: [groupId], references: [id], onDelete: Restrict, map: "ProviderGroupAssignment_group_fkey")

  @@id([connectionId, groupId])
  @@index([credentialId])
  @@index([groupId])
}

model ProviderUserCredentialAssignment {
  connectionId String
  userId       String
  credentialId String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  credential   ProviderCredential @relation(fields: [connectionId, credentialId], references: [connectionId, id], onDelete: Restrict, onUpdate: Restrict, map: "ProviderUserAssignment_credential_fkey")
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ProviderUserAssignment_user_fkey")

  @@id([connectionId, userId])
  @@index([credentialId])
  @@index([userId])
}

model ProviderDraftCheck {
  id                     String                        @id @default(uuid())
  fingerprint            String                        @unique
  connectionId           String
  providerModelId        String
  credentialId           String
  credentialVersionId    String?
  credentialDraftVersion Int?
  connectionDraftVersion Int
  modelDraftVersion      Int
  status                 ProviderCredentialCheckStatus
  evidence               Json?
  checkedAt              DateTime
  createdAt              DateTime                      @default(now())
  credential             ProviderCredential            @relation(fields: [connectionId, credentialId], references: [connectionId, id], onDelete: Cascade, onUpdate: Restrict, map: "ProviderDraftCheck_credential_fkey")
  credentialVersion      ProviderCredentialVersion?    @relation(fields: [credentialId, credentialVersionId], references: [credentialId, id], onDelete: Cascade, onUpdate: Restrict, map: "ProviderDraftCheck_version_fkey")
  model                  ProviderModel                 @relation(fields: [connectionId, providerModelId], references: [connectionId, id], onDelete: Cascade, onUpdate: Restrict, map: "ProviderDraftCheck_model_fkey")

  @@index([connectionId, providerModelId])
  @@index([credentialId, credentialVersionId])
}

model ProviderModelCredentialCheck {
  id                  String                        @id @default(uuid())
  connectionId        String
  providerModelId     String
  credentialId        String
  credentialVersionId String
  connectionVersion   Int
  modelVersion        Int
  status              ProviderCredentialCheckStatus
  evidence            Json?
  latestRefreshError  Json?
  checkedAt           DateTime
  refreshFailedAt     DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  credential          ProviderCredential            @relation(fields: [connectionId, credentialId], references: [connectionId, id], onDelete: Cascade, onUpdate: Restrict, map: "ProviderModelCredentialCheck_credential_fkey")
  credentialVersion   ProviderCredentialVersion     @relation(fields: [credentialId, credentialVersionId], references: [credentialId, id], onDelete: Cascade, onUpdate: Restrict, map: "ProviderModelCredentialCheck_version_fkey")
  model               ProviderModel                 @relation(fields: [connectionId, providerModelId], references: [connectionId, id], onDelete: Cascade, onUpdate: Restrict, map: "ProviderModelCredentialCheck_model_fkey")

  @@unique([providerModelId, credentialVersionId, connectionVersion, modelVersion], map: "ProviderModelCredentialCheck_tuple_key")
  @@index([connectionId, providerModelId], map: "ProviderModelCredentialCheck_connection_model_idx")
  @@index([credentialId, credentialVersionId], map: "ProviderModelCredentialCheck_credential_version_idx")
}

model ProviderRunBinding {
  id                  String                     @id @default(uuid())
  modelRunId          String
  bindingKey          String                     @default("answer")
  role                ProviderRunRole
  connectionId        String?
  providerModelId     String?
  credentialId        String?
  credentialVersionId String?
  credentialSource    ProviderCredentialSource
  executionSnapshot   Json
  recoverableUntil    DateTime?
  createdAt           DateTime                   @default(now())
  credential          ProviderCredential?        @relation(fields: [connectionId, credentialId], references: [connectionId, id], onDelete: Restrict, onUpdate: Restrict, map: "ProviderRunBinding_credential_fkey")
  credentialVersion   ProviderCredentialVersion? @relation(fields: [credentialId, credentialVersionId], references: [credentialId, id], onDelete: Restrict, onUpdate: Restrict, map: "ProviderRunBinding_version_fkey")
  model               ProviderModel?             @relation(fields: [connectionId, providerModelId], references: [connectionId, id], onDelete: Restrict, onUpdate: Restrict, map: "ProviderRunBinding_model_fkey")
  modelRun            ModelRun                   @relation(fields: [modelRunId], references: [id], onDelete: Cascade)

  @@unique([modelRunId, bindingKey])
  @@index([modelRunId, role])
  @@index([connectionId, providerModelId], map: "ProviderRunBinding_connection_model_idx")
  @@index([credentialId, credentialVersionId], map: "ProviderRunBinding_credential_version_idx")
  @@index([recoverableUntil])
}

model SearchStrategy {
  id                String                      @id @default(uuid())
  strategyId        String                      @unique
  provider          String
  modelId           String?
  providerModelId   String?
  displayName       String
  kind              String
  description       String
  enabled           Boolean                     @default(true)
  config            Json
  adapterKind       String                      @default("answer_provider_hosted")
  credentialMode    String                      @default("answer_provider")
  draft             Json                        @default("{}")
  draftVersion      Int                         @default(1)
  testedDraftHash   String?
  draftTestEvidence Json?
  activeRevisionId  String?                     @unique
  activatedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  activeRevision    SearchIntegrationRevision?  @relation("ActiveSearchRevision", fields: [id, activeRevisionId], references: [searchStrategyId, id], onDelete: Restrict, onUpdate: Restrict, map: "SearchStrategy_activeRevision_fkey")
  providerModel     ProviderModel?              @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  revisions         SearchIntegrationRevision[] @relation("SearchIntegrationRevisions")
  runBindings       SearchRunBinding[]

  @@unique([id, activeRevisionId])
  @@index([providerModelId])
  @@index([enabled, archivedAt])
}

model SearchIntegrationRevision {
  id                 String             @id @default(uuid())
  searchStrategyId   String
  revisionNumber     Int
  adapterKind        String
  credentialMode     String
  configuration      Json
  providerModelId    String?
  validationEvidence Json
  draftHash          String
  createdAt          DateTime           @default(now())
  activeFor          SearchStrategy?    @relation("ActiveSearchRevision")
  providerModel      ProviderModel?     @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  searchStrategy     SearchStrategy     @relation("SearchIntegrationRevisions", fields: [searchStrategyId], references: [id], onDelete: Restrict)
  runBindings        SearchRunBinding[]
  searchRuns         SearchRun[]

  @@unique([searchStrategyId, revisionNumber])
  @@unique([searchStrategyId, draftHash])
  @@unique([searchStrategyId, id])
  @@index([providerModelId])
}

model SearchRunBinding {
  id                  String                    @id @default(uuid())
  modelRunId          String
  searchStrategyId    String
  revisionId          String
  optionId            String
  ordinal             Int
  mode                String
  technicalBindingKey String?
  createdAt           DateTime                  @default(now())
  modelRun            ModelRun                  @relation(fields: [modelRunId], references: [id], onDelete: Cascade)
  revision            SearchIntegrationRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  searchStrategy      SearchStrategy            @relation(fields: [searchStrategyId], references: [id], onDelete: Restrict)

  @@unique([modelRunId, ordinal])
  @@unique([modelRunId, optionId])
  @@index([revisionId])
  @@index([searchStrategyId])
}

model Chat {
  id                     String               @id @default(uuid())
  userId                 String
  folderId               String?
  title                  String
  activeLeafMessageId    String?
  defaultProviderModelId String?
  defaultPromptPresetId  String?
  pinned                 Boolean              @default(false)
  archived               Boolean              @default(false)
  totalInputTokens       Int                  @default(0)
  totalOutputTokens      Int                  @default(0)
  totalReasoningTokens   Int                  @default(0)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  /// The migration uses PostgreSQL's column-scoped SET NULL so deleting the leaf clears only activeLeafMessageId, never Chat.id.
  activeLeafMessage      Message?             @relation("ChatActiveLeaf", fields: [id, activeLeafMessageId], references: [chatId, id], onDelete: SetNull, onUpdate: Restrict, map: "Chat_id_activeLeafMessageId_fkey")
  attachments            Attachment[]
  folder                 Folder?              @relation(fields: [folderId], references: [id], onDelete: SetNull)
  defaultProviderModel   ProviderModel?       @relation("ChatDefaultProviderModel", fields: [defaultProviderModelId], references: [id], onDelete: Restrict)
  messages               Message[]            @relation("ChatMessages")
  modelRuns              ModelRun[]
  sharedSnapshots        SharedChatSnapshot[]
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([activeLeafMessageId])
  @@index([defaultProviderModelId])
  @@index([userId, archived, updatedAt])
}

model Message {
  id                 String        @id @default(uuid())
  chatId             String
  role               String
  parentMessageId    String?
  content            Json
  groundedAt         DateTime?
  groundingProvider  String?
  groundingStrategy  String?
  provider           String?
  modelId            String?
  promptPresetId     String?
  status             MessageStatus @default(complete)
  inputTokens        Int           @default(0)
  outputTokens       Int           @default(0)
  reasoningTokens    Int           @default(0)
  errorMessage       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  assistantModelRuns ModelRun[]    @relation("AssistantMessageRun")
  activeLeafForChats Chat[]        @relation("ChatActiveLeaf")
  chat               Chat          @relation("ChatMessages", fields: [chatId], references: [id], onDelete: Cascade)
  children           Message[]     @relation("MessageBranches")
  parent             Message?      @relation("MessageBranches", fields: [chatId, parentMessageId], references: [chatId, id], onDelete: Restrict, onUpdate: Restrict, map: "Message_chatId_parentMessageId_fkey")
  promptPreset       PromptPreset? @relation(fields: [promptPresetId], references: [id], onDelete: SetNull)
  userModelRuns      ModelRun[]    @relation("UserMessageRun")

  @@unique([chatId, id], map: "Message_chatId_id_key")
  @@index([chatId, parentMessageId])
  @@index([chatId, createdAt])
  @@index([groundingProvider, groundedAt])
}

model ModelRun {
  id                           String               @id @default(uuid())
  chatId                       String
  userId                       String
  userMessageId                String
  assistantMessageId           String?
  provider                     String
  modelId                      String
  status                       ModelRunStatus
  normalizedRequest            Json
  providerRequestPreview       Json?
  providerResponseId           String?
  finalProviderResponsePreview Json?
  inputTokens                  Int                  @default(0)
  cachedInputTokens            Int                  @default(0)
  cacheWriteInputTokens        Int                  @default(0)
  outputTokens                 Int                  @default(0)
  reasoningTokens              Int                  @default(0)
  totalTokens                  Int                  @default(0)
  estimatedCostMicros          Int                  @default(0)
  errorPayload                 Json?
  toolLoopState                Json?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  assistantMessage             Message?             @relation("AssistantMessageRun", fields: [assistantMessageId], references: [id], onDelete: SetNull)
  chat                         Chat                 @relation(fields: [chatId], references: [id], onDelete: Cascade)
  events                       ModelRunEvent[]
  mcpRunBindings               McpRunBinding[]
  providerRunBindings          ProviderRunBinding[]
  searchRuns                   SearchRun[]
  searchRunBindings            SearchRunBinding[]
  toolCalls                    ModelRunToolCall[]
  user                         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userMessage                  Message              @relation("UserMessageRun", fields: [userMessageId], references: [id], onDelete: Restrict)
  usageEvents                  UsageEvent[]

  @@index([chatId, createdAt])
  @@index([provider, modelId])
  @@index([status])
  @@index([userId, createdAt])
}

model ModelRunEvent {
  id         String   @id @default(uuid())
  modelRunId String
  sequence   Int
  eventType  String
  payload    Json
  createdAt  DateTime @default(now())
  modelRun   ModelRun @relation(fields: [modelRunId], references: [id], onDelete: Cascade)

  @@unique([modelRunId, sequence])
}

model McpServer {
  id                   String               @id @default(uuid())
  namespace            String               @unique
  displayName          String
  description          String               @default("")
  enabled              Boolean              @default(false)
  archivedAt           DateTime?
  activeRevisionId     String?              @unique
  draft                Json                 @default("{}")
  testedDraftHash      String?
  draftTestEvidence    Json?
  sharedConfigEnvelope String?
  sharedConfigVersion  Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  activeRevision       McpRevision?         @relation("ActiveMcpRevision", fields: [activeRevisionId], references: [id], onDelete: SetNull)
  activationJob        McpActivationJob?
  grants               McpGrant[]
  oauthConnections     McpOAuthConnection[]
  revisions            McpRevision[]        @relation("McpServerRevisions")
  userServers          McpUserServer[]

  @@index([enabled, archivedAt])
}

model McpActivationJob {
  id                  String             @id @default(uuid())
  serverId            String             @unique
  draftHash           String
  sharedConfigVersion Int
  validationUserId    String?
  stage               McpActivationStage @default(queued)
  errorCode           String?
  issues              Json?
  leaseId             String?
  workloadToken       String             @unique
  requestedAt         DateTime           @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  updatedAt           DateTime           @updatedAt
  server              McpServer          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  validationUser      User?              @relation(fields: [validationUserId], references: [id], onDelete: SetNull)

  @@index([stage, updatedAt])
  @@index([validationUserId])
}

model McpRevision {
  id                 String                 @id @default(uuid())
  serverId           String
  revisionNumber     Int
  configuration      Json
  resolvedArtifact   Json?
  validationEvidence Json
  draftHash          String
  identityHash       String
  createdAt          DateTime               @default(now())
  activeFor          McpServer?             @relation("ActiveMcpRevision")
  runtimeGenerations McpRuntimeGeneration[]
  server             McpServer              @relation("McpServerRevisions", fields: [serverId], references: [id], onDelete: Restrict)

  @@unique([serverId, revisionNumber])
  @@unique([serverId, identityHash])
  @@index([serverId, draftHash])
  @@index([serverId, createdAt])
}

model McpGrant {
  id               String    @id @default(uuid())
  serverId         String
  userId           String?
  groupId          String?
  canUse           Boolean   @default(false)
  personalSlotKeys String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  group            Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  server           McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@unique([serverId, groupId])
  @@index([groupId])
  @@index([userId])
}

model McpUserServer {
  id                         String                 @id @default(uuid())
  serverId                   String
  userId                     String
  enabled                    Boolean                @default(false)
  personalConfigEnvelope     String?
  personalConfigVersion      Int                    @default(0)
  desiredRuntimeGenerationId String?                @unique
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  desiredRuntimeGeneration   McpRuntimeGeneration?  @relation("McpDesiredRuntimeGeneration", fields: [desiredRuntimeGenerationId], references: [id], onDelete: SetNull)
  runtimeGenerations         McpRuntimeGeneration[] @relation("McpUserRuntimeGenerations")
  server                     McpServer              @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user                       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([userId, enabled])
}

model McpOAuthClient {
  id                     String               @id @default(uuid())
  registrationKey        String               @unique
  clientId               String
  clientMetadata         Json
  clientSecretEnvelope   String?
  clientSecretGeneration Int                  @default(0)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  connections            McpOAuthConnection[]
}

model McpOAuthConnection {
  id                    String                  @id @default(uuid())
  serverId              String
  userId                String
  oauthClientId         String?
  purpose               McpOAuthPurpose
  policyFingerprint     String
  state                 McpOAuthConnectionState @default(ready)
  tokenEnvelope         String?
  tokenGeneration       Int                     @default(0)
  externalAccountLabel  String?
  scopes                String[]                @default([])
  expiresAt             DateTime?
  disconnectRequestedAt DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  oauthClient           McpOAuthClient?         @relation(fields: [oauthClientId], references: [id], onDelete: Restrict)
  runtimeGenerations    McpRuntimeGeneration[]
  server                McpServer               @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([oauthClientId])
  @@index([serverId, userId, purpose, state])
}

model McpRuntimeGeneration {
  id                      String              @id @default(uuid())
  userServerId            String
  revisionId              String
  oauthConnectionId       String?
  fingerprint             String              @unique
  credentialSources       String[]            @default([])
  externalAccountLabel    String?
  effectiveConfigEnvelope String?
  runtimeHandle           Json?
  inventory               Json?
  inventoryUpdatedAt      DateTime?
  state                   McpRuntimeState     @default(starting)
  readinessCheckedAt      DateTime?
  errorCode               String?
  retryAt                 DateTime?
  attemptCount            Int                 @default(0)
  lastUsedAt              DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  desiredFor              McpUserServer?      @relation("McpDesiredRuntimeGeneration")
  oauthConnection         McpOAuthConnection? @relation(fields: [oauthConnectionId], references: [id], onDelete: Restrict)
  revision                McpRevision         @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  runBindings             McpRunBinding[]
  userServer              McpUserServer       @relation("McpUserRuntimeGenerations", fields: [userServerId], references: [id], onDelete: Cascade)

  @@index([oauthConnectionId])
  @@index([revisionId])
  @@index([state, retryAt])
  @@index([userServerId])
}

model McpRunBinding {
  id                           String                @id @default(uuid())
  modelRunId                   String
  runtimeGenerationId          String?
  runtimeGenerationFingerprint String
  createdAt                    DateTime              @default(now())
  modelRun                     ModelRun              @relation(fields: [modelRunId], references: [id], onDelete: Cascade)
  runtimeGeneration            McpRuntimeGeneration? @relation(fields: [runtimeGenerationId], references: [id], onDelete: SetNull)
  toolCalls                    ModelRunToolCall[]

  @@unique([modelRunId, runtimeGenerationFingerprint])
  @@index([runtimeGenerationId])
}

model ModelRunToolCall {
  id              String                @id @default(uuid())
  modelRunId      String
  mcpRunBindingId String?
  roundIndex      Int
  ordinal         Int
  providerCallId  String
  toolName        String
  arguments       Json
  state           ModelRunToolCallState @default(pending)
  result          Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  mcpRunBinding   McpRunBinding?        @relation(fields: [mcpRunBindingId], references: [id], onDelete: SetNull)
  modelRun        ModelRun              @relation(fields: [modelRunId], references: [id], onDelete: Cascade)

  @@unique([modelRunId, roundIndex, providerCallId])
  @@unique([modelRunId, roundIndex, ordinal])
  @@index([mcpRunBindingId])
  @@index([modelRunId, state])
}

model SearchRun {
  id               String                     @id @default(uuid())
  modelRunId       String
  strategyId       String
  searchRevisionId String?
  invocationId     String?
  query            String?
  provider         String
  modelId          String?
  requestPreview   Json
  artifacts        Json
  durationMs       Int?
  status           SearchRunStatus
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  modelRun         ModelRun                   @relation(fields: [modelRunId], references: [id], onDelete: Cascade)
  searchRevision   SearchIntegrationRevision? @relation(fields: [searchRevisionId], references: [id], onDelete: Restrict)

  @@unique([modelRunId, invocationId])
  @@index([strategyId])
  @@index([searchRevisionId])
}

model Attachment {
  id            String           @id @default(uuid())
  userId        String
  chatId        String?
  messageId     String?
  kind          String
  mimeType      String
  fileName      String
  storageKey    String
  checksum      String?
  status        AttachmentStatus @default(ready)
  byteSize      Int
  extractedText String?
  metadata      Json
  createdAt     DateTime         @default(now())
  chat          Chat?            @relation(fields: [chatId], references: [id], onDelete: SetNull)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([messageId])
  @@index([storageKey])
}

model AttachmentDeletionJob {
  id            String    @id @default(uuid())
  storageKey    String    @unique
  claimToken    String?
  claimedAt     DateTime?
  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  lastErrorCode String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([claimedAt, createdAt])
}

model SharedChatSnapshot {
  id          String    @id @default(uuid())
  ownerUserId String
  chatId      String?
  slugHash    String    @unique
  title       String
  snapshot    Json
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  chat        Chat?     @relation(fields: [chatId], references: [id], onDelete: SetNull)
  owner       User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([ownerUserId, createdAt])
}

model UsageEvent {
  id                    String    @id @default(uuid())
  userId                String
  chatId                String?
  modelRunId            String?
  provider              String
  modelId               String
  inputTokens           Int       @default(0)
  cachedInputTokens     Int       @default(0)
  cacheWriteInputTokens Int       @default(0)
  outputTokens          Int       @default(0)
  reasoningTokens       Int       @default(0)
  totalTokens           Int       @default(0)
  estimatedCostMicros   Int       @default(0)
  createdAt             DateTime  @default(now())
  modelRun              ModelRun? @relation(fields: [modelRunId], references: [id], onDelete: SetNull)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([provider, modelId])
}
