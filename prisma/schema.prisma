  failureCode         String?                       @db.VarChar(128)
  dispatchedAt        DateTime                      @default(now())
  settledAt           DateTime?
  reservation         KnowledgeBudgetReservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
