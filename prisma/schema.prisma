  dispatchDeadlineAt DateTime?
  credentialVersionId String?
  status           ChatTitleGenerationStatus @default(pending)
  createdAt        DateTime                  @default(now())
  expiresAt        DateTime
  dispatchedAt     DateTime?
  finishedAt       DateTime?
  chat             Chat                      @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: Restrict)
