  @@unique([connectionId, label])
  @@unique([id, activeVersionId])
  @@index([connectionId, enabled])
}

model ProviderCredentialVersion {
  id                     String                         @id @default(uuid())
  credentialId           String
  version                Int
  secretEnvelope         String?
  testEvidence           Json
  testedAt               DateTime
  activatedAt            DateTime
