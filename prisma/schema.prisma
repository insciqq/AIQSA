/// Exact accepted tool originals; model checkpoints retain only bounded projections.
model ToolObservation {
  id                String           @id @db.Char(32)
  modelRunId        String
  toolCallId        String           @unique
  formatVersion     Int              @default(1)
  sourceKind        String           @db.VarChar(16)
  sourceBinding     Json?
  executionReceipt  Json?
  state             String           @default("RESERVED") @db.VarChar(16)
  executionOutcome  String?          @db.VarChar(16)
  reservedBytes     Int
  byteSize          Int?
  checksum          String?          @db.Char(64)
  storageMode       String?          @db.VarChar(16)
  inlineText        String?
  storageKey        String?          @unique @db.VarChar(512)
  projection        Json?
  sourceTruncated   Boolean          @default(false)
  maskable          Boolean          @default(false)
  leaseToken        String?          @db.Char(32)
  leaseExpiresAt    DateTime?
  failureCode       String?          @db.VarChar(64)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  modelRun          ModelRun         @relation(fields: [modelRunId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  toolCall          ModelRunToolCall @relation(fields: [modelRunId, toolCallId], references: [modelRunId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([modelRunId, toolCallId])
  @@index([modelRunId, createdAt])
  @@index([state, leaseExpiresAt])
}

model KnowledgeRun {
  id                     String                      @id @default(uuid())
  modelRunId             String
  modelRunToolCallId     String                      @unique
  retrievalSessionId     String?
  invocationOrdinal      Int
  operation              String                      @default("search") @db.VarChar(32)
  query                  String
  outcome                KnowledgeRunOutcome
  fusion                 String                      @db.VarChar(32)
  candidateLimit         Int
  resultLimit            Int
  candidateCount         Int
  baseEvidence           Json
  results                Json
  providerText           String
  embeddingUsage         Json
  durationMs             Int
  failureCode            String?                     @db.VarChar(128)
  budgetEvidence         Json                        @default("{}")
  lexicalBackendEvidence Json?
  readReceipt            Json?
  receiptVersion         Int?
  budgetReservationId    String?                     @unique
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  modelRun               ModelRun                    @relation(fields: [modelRunId], references: [id], onDelete: Cascade)
  modelRunToolCall       ModelRunToolCall            @relation(fields: [modelRunId, modelRunToolCallId], references: [modelRunId, id], onDelete: Cascade, onUpdate: Restrict, map: "KnowledgeRun_toolCall_fkey")
  retrievalSession       KnowledgeRetrievalSession?  @relation(fields: [retrievalSessionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  evidenceLinks          KnowledgeRunEvidence[]
  budgetReservation      KnowledgeBudgetReservation? @relation(fields: [modelRunId, modelRunToolCallId, budgetReservationId], references: [modelRunId, modelRunToolCallId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeRun_budgetReservation_fkey")

  @@unique([modelRunId, modelRunToolCallId])
  @@unique([modelRunId, budgetReservationId])
  @@unique([modelRunId, modelRunToolCallId, budgetReservationId])
  @@index([modelRunId, createdAt])
  @@index([retrievalSessionId])
  @@index([budgetReservationId])
}

model KnowledgeRunProfileBinding {
