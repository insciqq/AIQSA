  updatedAt           DateTime               @updatedAt
  grant               InboundMcpOAuthGrant   @relation(fields: [grantId, resourcePath, capability], references: [id, resourcePath, capability], onDelete: Cascade, map: "InboundMcpOAuthTokenFamily_authority_fkey")
  tokens              InboundMcpOAuthToken[]

  @@unique([id, resourcePath, capability], map: "InboundMcpOAuthTokenFamily_authority_key")
  @@index([grantId, grantRevision, revokedAt])
  @@index([inactivityExpiresAt, revokedAt])
}

model InboundMcpOAuthToken {
  scopes             String[]                           @default([])
  resourcePath String                     @default("/mcp") @db.VarChar(32)
  capability   String                     @default("memory:facts") @db.VarChar(32)
  id           String                     @id @default(uuid())
  familyId     String
  kind         InboundMcpOAuthTokenKind
  tokenHash    String                     @unique @db.VarChar(64)
