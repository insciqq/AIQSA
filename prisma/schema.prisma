  @@index([embeddingConnectionId, embeddingProviderModelId], map: "KnowledgeRunBinding_embedding_model_idx")
  @@index([embeddingCredentialId, embeddingCredentialVersionId], map: "KnowledgeRunBinding_credential_version_idx")
