model User {
  id                                  String                             @id @default(uuid())
  email                               String?                            @unique
  displayName                         String
  role                                UserRole                           @default(user)
  status                              UserStatus                         @default(pending)
  createdAt                           DateTime                           @default(now())
  updatedAt                           DateTime                           @updatedAt
  accessGrants                        AccessGrant[]
  attachments                         Attachment[]
  authAccessRulesCreated              AuthAccessRule[]                   @relation("AuthAccessRuleCreator")
  authFlowTokens                      AuthFlowToken[]
  authIdentities                      AuthIdentity[]
  authInvitesAccepted                 AuthInvite[]                       @relation("AuthInviteAcceptedUser")
  authInvitesCreated                  AuthInvite[]                       @relation("AuthInviteCreator")
  authSessions                        AuthSession[]
  authSessionsRevoked                 AuthSession[]                      @relation("AuthSessionRevoker")
  assistantDefinitions                AssistantDefinition[]              @relation("AssistantDefinitionOwner")
  assistantPins                       AssistantPin[]
  assistantPublications               AssistantPublication[]             @relation("AssistantPublicationPublisher")
  assistantRevisionsAuthored          AssistantRevision[]                @relation("AssistantRevisionAuthor")
  chats                               Chat[]
  folders                             Folder[]
  groups                              UserGroup[]
  knowledgeBasePublications           KnowledgeBasePublication[]         @relation("KnowledgeBasePublicationPublisher")
  knowledgeBases                      KnowledgeBase[]                    @relation("KnowledgeBaseOwner")
  knowledgeIndexProfileUpdates        KnowledgeIndexProfile[]            @relation("KnowledgeIndexProfileUpdater")
  knowledgeAnswerPolicyUpdates        KnowledgeAnswerPolicy[]            @relation("KnowledgeAnswerPolicyUpdater")
  knowledgeSources                    KnowledgeSource[]                  @relation("KnowledgeSourceOwner")
  knowledgeUploadBatches              KnowledgeUploadBatch[]
  memoryEgressPolicyUpdates           MemoryEgressAdminPolicy[]          @relation("MemoryEgressAdminPolicyUpdater")
  mcpGrants                           McpGrant[]
  mcpActivationJobs                   McpActivationJob[]
  mcpOAuthConnections                 McpOAuthConnection[]
  mcpUserServers                      McpUserServer[]
  modelPolicyUpdates                  ModelPolicy[]                      @relation("ModelPolicyUpdater")
  providerCredentialAssignments       ProviderUserCredentialAssignment[]
  projectAssistantBindingsAdded       ProjectAssistantBinding[]          @relation("ProjectAssistantBindingAdder")
  projectAttachmentsUploaded          Attachment[]                       @relation("ProjectAttachmentUploader")
  projectAuditEvents                  ProjectAuditEvent[]                @relation("ProjectAuditActor")
  projectChatsCreated                 Chat[]                             @relation("ProjectChatCreator")
  projectFoldersCreated               ProjectFolder[]                    @relation("ProjectFolderCreator")
  projectGrants                       ProjectGrant[]
  projectGrantsCreated                ProjectGrant[]                     @relation("ProjectGrantCreator")
  projectKnowledgeBindingsAdded       ProjectKnowledgeBaseBinding[]      @relation("ProjectKnowledgeBindingAdder")
  projectKnowledgeSourceBindingsAdded ProjectKnowledgeSourceBinding[]    @relation("ProjectKnowledgeSourceBindingAdder")
  projectMcpBindingsAdded             ProjectMcpBinding[]                @relation("ProjectMcpBindingAdder")
  projectMemoryFactsCreated           ProjectMemoryFact[]                @relation("ProjectMemoryFactCreator")
  projectMemoryProposals              ProjectMemoryProposal[]            @relation("ProjectMemoryProposalAuthor")
  projectMemoryProposalsReviewed      ProjectMemoryProposal[]            @relation("ProjectMemoryProposalReviewer")
  projectMemoryVersionsAuthored       ProjectMemoryFactVersion[]         @relation("ProjectMemoryVersionAuthor")
  projectMessagesAuthored             Message[]                          @relation("ProjectMessageAuthor")
  projectModelBindingsAdded           ProjectModelBinding[]              @relation("ProjectModelBindingAdder")
  projectSearchBindingsAdded          ProjectSearchBinding[]             @relation("ProjectSearchBindingAdder")
  projectSkillBindingsAdded           ProjectSkillBinding[]              @relation("ProjectSkillBindingAdder")
  projectsCreated                     Project[]                          @relation("ProjectCreator")
  searchPolicyUpdates                 SearchPolicy[]                     @relation("SearchPolicyUpdater")
  settings                            UserSettings?
  sharedSnapshots                     SharedChatSnapshot[]
  skillDefinitions                    SkillDefinition[]                  @relation("SkillDefinitionOwner")
  skillPublications                   SkillPublication[]                 @relation("SkillPublicationPublisher")
  skillRevisionsAuthored              SkillRevision[]                    @relation("SkillRevisionAuthor")
  smtpActivations                     SmtpControl[]                      @relation("SmtpControlActivator")
  smtpConfigurationEdits              SmtpControl[]                      @relation("SmtpControlUpdater")
  systemModelPolicyUpdates            SystemModelPolicy[]                @relation("SystemModelPolicyUpdater")
  usageEvents                         UsageEvent[]
}

model SmtpControl {
  id                           String    @id
  draftConfig                  Json?
  draftPasswordEnvelope        String?
  draftSecretGeneration        Int?
  draftVersion                 Int       @default(0)
  testedDraftVersion           Int?
  draftTestVersion             Int?
  draftTestAt                  DateTime?
  draftTestCode                String?
  activeConfig                 Json?
  activePasswordEnvelope       String?
  activeSecretGeneration       Int?
  activeVersion                Int       @default(0)
  enabled                      Boolean   @default(false)
  secretGenerationCounter      Int       @default(0)
  healthActiveVersion          Int?
  lastAttemptAt                DateTime?
  lastAcceptedAt               DateTime?
  lastFailureAt                DateTime?
  lastFailureCode              String?
  configurationUpdatedAt       DateTime?
  configurationUpdatedByUserId String?
  activatedAt                  DateTime?
  activatedByUserId            String?
  createdAt                    DateTime  @default(now())
  activatedBy                  User?     @relation("SmtpControlActivator", fields: [activatedByUserId], references: [id], onDelete: SetNull)
  configurationUpdatedBy       User?     @relation("SmtpControlUpdater", fields: [configurationUpdatedByUserId], references: [id], onDelete: SetNull)
}

model AuthIdentity {
  id                String               @id @default(uuid())
  userId            String
  provider          AuthIdentityProvider
  providerAccountId String
  normalizedEmail   String
  emailVerifiedAt   DateTime?
  passwordHash      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  flowTokens        AuthFlowToken[]
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([provider, normalizedEmail])
  @@index([normalizedEmail])
  @@index([userId])
}

model AuthSession {
  id                 String    @id @default(uuid())
  userId             String
  tokenHash          String    @unique
  expiresAt          DateTime
  revokedAt          DateTime?
  revokedByUserId    String?
  revokedReason      String?
  createdByIp        String?
  createdByUserAgent String?
  lastSeenAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  revokedBy          User?     @relation("AuthSessionRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([revokedAt])
  @@index([userId, expiresAt])
}

model AuthRateLimitBucket {
  keyHash      String   @id @db.Char(64)
  attemptCount Int
  resetAt      DateTime @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@index([resetAt])
}

model AuthAccessRule {
  id              String                @id @default(uuid())
  kind            AuthAccessRuleKind
  value           String
  enabled         Boolean               @default(true)
  createdByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  createdBy       User?                 @relation("AuthAccessRuleCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  defaultGroups   AuthAccessRuleGroup[]

  @@unique([kind, value])
  @@index([enabled])
}

model AuthAccessRuleGroup {
  accessRuleId String
  groupId      String
  role         String         @default("member")
  createdAt    DateTime       @default(now())
  accessRule   AuthAccessRule @relation(fields: [accessRuleId], references: [id], onDelete: Cascade)
  group        Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([accessRuleId, groupId])
  @@index([groupId])
}

model AuthInvite {
  id               String            @id @default(uuid())
  email            String
  normalizedEmail  String
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  createdByUserId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  acceptedBy       User?             @relation("AuthInviteAcceptedUser", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  createdBy        User?             @relation("AuthInviteCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  defaultGroups    AuthInviteGroup[]
  flowTokens       AuthFlowToken[]

  @@index([expiresAt])
  @@index([normalizedEmail])
  @@index([revokedAt])
}

model AuthInviteGroup {
  inviteId  String
  groupId   String
  role      String     @default("member")
  createdAt DateTime   @default(now())
  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invite    AuthInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@id([inviteId, groupId])
  @@index([groupId])
}

model AuthFlowToken {
  id              String               @id @default(uuid())
  purpose         AuthFlowTokenPurpose
  tokenHash       String               @unique
  userId          String?
  identityId      String?
  inviteId        String?
  normalizedEmail String?
  sentToEmail     String?
  expiresAt       DateTime
  consumedAt      DateTime?
  metadata        Json                 @default("{}")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  identity        AuthIdentity?        @relation(fields: [identityId], references: [id], onDelete: Cascade)
  invite          AuthInvite?          @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user            User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([inviteId])
  @@index([normalizedEmail])
  @@index([consumedAt])
  @@index([purpose, expiresAt])
  @@index([userId])
}

model Group {
  id                            String                              @id @default(uuid())
  name                          String                              @unique
  systemRole                    GroupSystemRole?                    @unique
  archivedAt                    DateTime?
  createdAt                     DateTime                            @default(now())
  updatedAt                     DateTime                            @updatedAt
  accessGrants                  AccessGrant[]
  assistantPublications         AssistantPublication[]
  authAccessRuleDefaults        AuthAccessRuleGroup[]
  authInviteDefaults            AuthInviteGroup[]
  knowledgeBasePublications     KnowledgeBasePublication[]
  mcpGrants                     McpGrant[]
  skillPublications             SkillPublication[]
  providerCredentialAssignments ProviderGroupCredentialAssignment[]
  projectGrants                 ProjectGrant[]
  users                         UserGroup[]

  @@index([archivedAt])
}

enum GroupSystemRole {
  full_access
}

model UserGroup {
  userId    String
  groupId   String
  role      String   @default("member")
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

model UserSettings {
  id                      String         @id @default(uuid())
  userId                  String         @unique
  defaultProviderModelId  String?
  defaultFolderId         String?
  defaultSearchStrategyId String         @default("openai-native-web-search")
  defaultSearchPlan       Json?
  defaultControlValues    Json           @default("{}")
  showCitations           Boolean        @default(true)
  showReasoningBlocks     Boolean        @default(false)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultProviderModel    ProviderModel? @relation("UserDefaultProviderModel", fields: [defaultProviderModelId], references: [id], onDelete: Restrict)

  @@index([defaultProviderModelId])
}

model SearchPolicy {
  id              String   @id
  defaultPlan     Json     @default("{\"mode\":\"all_selected\",\"optionIds\":[]}")
  version         Int      @default(1)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       User?    @relation("SearchPolicyUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

model ModelPolicy {
  id                             String         @id
  defaultProviderModelId         String?
  memoryAdmissionTimeoutSeconds  BigInt         @default(30)
  maxToolCalls                   BigInt         @default(20)
  maxToolRounds                  BigInt         @default(8)
  maxMcpToolsPerDiscovery        BigInt         @default(10)
  mcpAutoDiscoveryTimeoutSeconds BigInt         @default(60)
  version                        Int            @default(1)
  updatedByUserId                String?
  createdAt                      DateTime       @default(now())
  updatedAt                      DateTime       @updatedAt
  defaultProviderModel           ProviderModel? @relation("InstallationDefaultProviderModel", fields: [defaultProviderModelId], references: [id], onDelete: Restrict)
  updatedBy                      User?          @relation("ModelPolicyUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([defaultProviderModelId])
  @@index([updatedByUserId])
}

model SystemModelPolicy {
  id                      String         @id
  providerModelId         String?
  rerankerProviderModelId String?
  reasoningEffort         String?        @db.VarChar(32)
  version                 Int            @default(1)
  updatedByUserId         String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  providerModel           ProviderModel? @relation("SystemUtilityProviderModel", fields: [providerModelId], references: [id], onDelete: Restrict)
  rerankerProviderModel   ProviderModel? @relation("MemoryRerankerProviderModel", fields: [rerankerProviderModelId], references: [id], onDelete: Restrict)
  updatedBy               User?          @relation("SystemModelPolicyUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([providerModelId])
  @@index([rerankerProviderModelId])
  @@index([updatedByUserId])
}

model KnowledgeAnswerPolicy {
  id                       String   @id
  maximumKnowledgeSearches Int      @default(12)
  version                  Int      @default(1)
  updatedByUserId          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt
  updatedBy                User?    @relation("KnowledgeAnswerPolicyUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

model MemoryEgressAdminPolicy {
  id                    String    @id
  acceptedFingerprint   String?   @db.VarChar(128)
  acceptedPolicyVersion String?   @db.VarChar(64)
  acceptedDestinations  Json      @default("[]")
  acceptedAt            DateTime?
  acceptedByUserId      String?
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
  acceptedBy            User?     @relation("MemoryEgressAdminPolicyUpdater", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([acceptedByUserId])
}

model AccessGrant {
  id                   String              @id @default(uuid())
  userId               String?
  groupId              String?
  providerConnectionId String?
  providerModelId      String?
  searchStrategy       String?
  enabled              Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  group                Group?              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  providerConnection   ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: Restrict)
  providerModel        ProviderModel?      @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  user                 User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([providerConnectionId])
  @@index([providerModelId])
  @@index([searchStrategy])
  @@index([userId])
}

model Folder {
  id                   String   @id @default(uuid())
  userId               String
  parentId             String?
  name                 String
  projectMemory        String   @default("")
  defaultKnowledgePlan Json?
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  chats                Chat[]
  children             Folder[] @relation("FolderHierarchy")
  parent               Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, parentId, name])
  @@unique([userId, id])
  @@index([parentId])
  @@index([userId, sortOrder])
  @@index([userId, parentId, sortOrder])
}

enum AssistantPublicationScope {
  group
  installation
}

enum SkillPublicationScope {
  group
  installation
}

enum KnowledgeBasePublicationScope {
  group
  installation
}

enum KnowledgeDocumentIngestState {
  queued
  parsing
  chunking
  embedding
  ready
  failed
}

enum KnowledgeIndexGenerationStatus {
  building
  ready
  active
  retired
  failed
}

enum KnowledgeIndexProfileExecutionAuthority {
  installation
  legacy_user
}

enum KnowledgeIndexProfilePreflightStatus {
  ready
  failed
}

enum KnowledgePdfProcessingMode {
  local
  system_model_direct_pdf
  system_model_vision
}

enum KnowledgePdfProcessingAttemptState {
  reserved
  dispatched
  settled
  ambiguous
}

enum KnowledgeSourceArtifactState {
  pending
  processing
  ready
  failed
}

enum KnowledgeSourceArtifactProcessingStage {
  queued
  parsing
  chunking
  embedding
}

enum KnowledgeHierarchicalIndexState {
  building
  ready
  failed
}

enum KnowledgeExactEntryKind {
  date
  filename
  heading
  identifier
  number
  tag
  title
}

enum KnowledgeUploadTransport {
  PROXY
  MULTIPART
}

enum KnowledgeUploadItemState {
  QUEUED
  UPLOADING
  STORED
  PROCESSING
  NEEDS_ATTENTION
  CANCELLED
  REUSED
}

enum KnowledgeDeletionTargetType {
  SOURCE
  BASE
}

enum KnowledgeDeletionState {
  PENDING
  RUNNING
  RETRY_WAIT
  BLOCKED_REQUIRES_ADMIN
  SUCCEEDED
}

enum KnowledgeDeletionObjectDisposition {
  PENDING
  DELETED
  RETAINED
}

model AssistantDefinition {
  id                String                    @id @default(uuid())
  ownerUserId       String
  currentRevisionId String?                   @unique
  version           Int                       @default(1)
  archivedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  /// The composite relation proves the current pointer targets a revision of this definition.
  currentRevision   AssistantRevision?        @relation("AssistantCurrentRevision", fields: [id, currentRevisionId], references: [assistantId, id], onDelete: Restrict, onUpdate: Restrict, map: "AssistantDefinition_currentRevision_fkey")
  owner             User                      @relation("AssistantDefinitionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  pins              AssistantPin[]
  projectBindings   ProjectAssistantBinding[]
  publications      AssistantPublication[]
  revisions         AssistantRevision[]       @relation("AssistantRevisions")

  @@unique([id, currentRevisionId])
  @@unique([ownerUserId, id])
  @@index([ownerUserId, archivedAt])
}

model AssistantRevision {
  id                 String                    @id @default(uuid())
  assistantId        String
  revisionNumber     Int
  schemaVersion      Int                       @default(1)
  name               String
  description        String                    @default("")
  category           String?
  avatar             Json
  providerModelId    String
  systemPrompt       String
  developerPrompt    String?
  runControls        Json                      @default("{}")
  searchPlan         Json
  mcpServerIds       String[]                  @default([])
  knowledgeSelection Json                      @default("{\"baseIds\":[],\"mode\":\"none\",\"sourceIds\":[],\"version\":1}")
  starterPrompts     String[]                  @default([])
  authorUserId       String?
  createdAt          DateTime                  @default(now())
  assistant          AssistantDefinition       @relation("AssistantRevisions", fields: [assistantId], references: [id], onDelete: Restrict)
  author             User?                     @relation("AssistantRevisionAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  currentFor         AssistantDefinition?      @relation("AssistantCurrentRevision")
  modelRuns          ModelRun[]                @relation("ModelRunAssistantRevision")
  projectBindings    ProjectAssistantBinding[] @relation("ProjectAssistantBindingRevision")
  providerModel      ProviderModel             @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  publications       AssistantPublication[]    @relation("AssistantPublicationRevision")
  skillLinks         AssistantRevisionSkill[]

  @@unique([assistantId, revisionNumber])
  @@unique([assistantId, id])
  @@index([authorUserId])
  @@index([providerModelId])
}

model AssistantPublication {
  id                String                    @id @default(uuid())
  assistantId       String
  revisionId        String
  scope             AssistantPublicationScope
  groupId           String?
  publishedByUserId String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  assistant         AssistantDefinition       @relation(fields: [assistantId], references: [id], onDelete: Restrict)
  group             Group?                    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  publishedBy       User?                     @relation("AssistantPublicationPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  /// The composite relation proves the pinned revision belongs to the published definition.
  revision          AssistantRevision         @relation("AssistantPublicationRevision", fields: [assistantId, revisionId], references: [assistantId, id], onDelete: Restrict, onUpdate: Restrict, map: "AssistantPublication_revision_fkey")

  @@unique([assistantId, groupId])
  @@index([groupId])
  @@index([assistantId, scope])
  @@index([revisionId])
}

model AssistantPin {
  userId      String
  assistantId String
  createdAt   DateTime            @default(now())
  assistant   AssistantDefinition @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, assistantId])
  @@index([assistantId])
}

model SkillDefinition {
  id                     String                   @id @default(uuid())
  ownerUserId            String
  currentRevisionId      String?                  @unique
  version                Int                      @default(1)
  archivedAt             DateTime?
  deletedAt              DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  /// The composite relation proves the current pointer targets a revision of this definition.
  currentRevision        SkillRevision?           @relation("SkillCurrentRevision", fields: [id, currentRevisionId], references: [skillId, id], onDelete: Restrict, onUpdate: Restrict, map: "SkillDefinition_currentRevision_fkey")
  owner                  User                     @relation("SkillDefinitionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  assistantRevisionLinks AssistantRevisionSkill[]
  publications           SkillPublication[]
  projectBindings        ProjectSkillBinding[]
  revisions              SkillRevision[]          @relation("SkillRevisions")

  @@unique([id, currentRevisionId])
  @@unique([ownerUserId, id])
  @@index([ownerUserId, archivedAt])
  @@index([deletedAt, updatedAt, id])
}

model SkillRevision {
  id               String                 @id @default(uuid())
  skillId          String
  revisionNumber   Int
  schemaVersion    Int                    @default(1)
  name             String
  description      String                 @default("")
  instructions     String
  authorUserId     String?
  createdAt        DateTime               @default(now())
  skill            SkillDefinition        @relation("SkillRevisions", fields: [skillId], references: [id], onDelete: Restrict)
  author           User?                  @relation("SkillRevisionAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  currentFor       SkillDefinition?       @relation("SkillCurrentRevision")
  modelRunBindings ModelRunSkillBinding[]

  @@unique([skillId, revisionNumber])
  @@unique([skillId, id])
  @@index([authorUserId])
}

model SkillPublication {
  id                String                @id @default(uuid())
  skillId           String
  scope             SkillPublicationScope
  groupId           String?
  publishedByUserId String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  skill             SkillDefinition       @relation(fields: [skillId], references: [id], onDelete: Restrict)
  group             Group?                @relation(fields: [groupId], references: [id], onDelete: Restrict)
  publishedBy       User?                 @relation("SkillPublicationPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  @@unique([skillId, groupId])
  @@index([groupId])
  @@index([skillId, scope])
}

model AssistantRevisionSkill {
  assistantRevisionId String
  skillId             String
  ordinal             Int
  assistantRevision   AssistantRevision @relation(fields: [assistantRevisionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  skill               SkillDefinition   @relation(fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([assistantRevisionId, skillId])
  @@unique([assistantRevisionId, ordinal])
  @@index([skillId])
}

model KnowledgeIndexProfile {
  id               String                          @id
  activeRevisionId String?                         @unique
  version          Int                             @default(1)
  updatedByUserId  String?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  /// The composite relation proves the active revision belongs to this installation profile.
  activeRevision   KnowledgeIndexProfileRevision?  @relation("KnowledgeIndexProfileActiveRevision", fields: [id, activeRevisionId], references: [profileId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeIndexProfile_activeRevision_fkey")
  revisions        KnowledgeIndexProfileRevision[] @relation("KnowledgeIndexProfileRevisions")
  updatedBy        User?                           @relation("KnowledgeIndexProfileUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([id, activeRevisionId])
  @@index([updatedByUserId])
}

model KnowledgeIndexProfileRevision {
  id                          String                                  @id @default(uuid())
  profileId                   String
  revisionNumber              Int
  embeddingProviderModelId    String
  embeddingConfiguration      Json
  vectorSpaceFingerprint      String                                  @db.Char(64)
  targetDimension             Int
  chunkingProfileVersion      Int
  pdfProcessingMode           KnowledgePdfProcessingMode              @default(local)
  pdfParserProfileVersion     Int                                     @default(1)
  pdfSystemModelPolicyVersion Int?
  pdfSystemModelSnapshot      Json?
  executionAuthority          KnowledgeIndexProfileExecutionAuthority
  profileConfiguration        Json
  egressPolicy                Json
  preflightStatus             KnowledgeIndexProfilePreflightStatus
  preflightErrorCode          String?                                 @db.VarChar(64)
  preflightCheckedAt          DateTime
  activatedAt                 DateTime
  createdAt                   DateTime                                @default(now())
  activeFor                   KnowledgeIndexProfile?                  @relation("KnowledgeIndexProfileActiveRevision")
  embeddingProviderModel      ProviderModel                           @relation(fields: [embeddingProviderModelId], references: [id], onDelete: Restrict)
  baseSnapshots               KnowledgeBaseSnapshot[]
  generations                 KnowledgeIndexGeneration[]
  profile                     KnowledgeIndexProfile                   @relation("KnowledgeIndexProfileRevisions", fields: [profileId], references: [id], onDelete: Restrict)
  sourceArtifacts             KnowledgeSourceIndexArtifact[]
  runProfileBindings          KnowledgeRunProfileBinding[]

  @@unique([profileId, revisionNumber])
  @@unique([profileId, id])
  @@index([embeddingProviderModelId])
  @@index([profileId, activatedAt])
}

model KnowledgeBase {
  id                      String                         @id @default(uuid())
  ownerUserId             String
  name                    String
  description             String                         @default("")
  activeIndexGenerationId String?                        @unique
  contentRevision         Int                            @default(0)
  sourceRevision          Int                            @default(0)
  version                 Int                            @default(1)
  archivedAt              DateTime?
  trashedAt               DateTime?
  deletionRequestedAt     DateTime?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  /// The composite relation proves the active generation belongs to this base.
  activeIndexGeneration   KnowledgeIndexGeneration?      @relation("KnowledgeBaseActiveIndexGeneration", fields: [id, activeIndexGenerationId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeBase_activeIndexGeneration_fkey")
  documents               KnowledgeDocument[]
  documentVersions        KnowledgeDocumentVersion[]     @relation("KnowledgeDocumentVersionOwner")
  generationDocuments     KnowledgeGenerationDocument[]  @relation("KnowledgeGenerationDocumentOwner")
  indexGenerations        KnowledgeIndexGeneration[]     @relation("KnowledgeBaseIndexGenerations")
  runBindings             KnowledgeRunBinding[]
  owner                   User                           @relation("KnowledgeBaseOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  projectBindings         ProjectKnowledgeBaseBinding[]
  publications            KnowledgeBasePublication[]
  sourceMemberships       KnowledgeBaseSource[]
  sourceSnapshots         KnowledgeBaseSnapshot[]
  usageEvents             UsageEvent[]                   @relation("KnowledgeUsageBase")
  uploadBatches           KnowledgeUploadBatch[]
  v1DocumentSourceMaps    KnowledgeV1DocumentSourceMap[]

  @@unique([id, activeIndexGenerationId])
  @@unique([id, ownerUserId])
  @@index([ownerUserId, trashedAt, archivedAt])
  @@index([trashedAt, deletionRequestedAt, id])
}

model KnowledgeUploadBatch {
  id              String                @id @default(uuid())
  ownerUserId     String
  knowledgeBaseId String
  clientBatchId   String                @db.VarChar(128)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  items           KnowledgeUploadItem[]
  knowledgeBase   KnowledgeBase         @relation(fields: [knowledgeBaseId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeUploadBatch_base_owner_fkey")
  owner           User                  @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([ownerUserId, clientBatchId])
  @@unique([id, ownerUserId])
  @@index([knowledgeBaseId, updatedAt, id])
  @@index([ownerUserId, updatedAt, id])
}

model KnowledgeUploadItem {
  id                 String                        @id @default(uuid())
  batchId            String
  clientFileId       String                        @db.VarChar(128)
  attemptNumber      Int                           @default(1)
  fileName           String
  declaredMimeType   String
  normalizedMimeType String
  declaredByteSize   Int
  checksumHint       String?                       @db.Char(64)
  storageKey         String?
  transport          KnowledgeUploadTransport
  multipartUploadId  String?
  sessionExpiresAt   DateTime
  state              KnowledgeUploadItemState      @default(QUEUED)
  uploadedByteSize   Int                           @default(0)
  errorCode          String?                       @db.VarChar(64)
  sourceId           String?
  sourceVersionId    String?
  sourceArtifactId   String?
  documentId         String?
  documentVersionId  String?
  settledAt          DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  batch              KnowledgeUploadBatch          @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  parts              KnowledgeUploadPart[]
  sourceArtifact     KnowledgeSourceIndexArtifact? @relation("KnowledgeUploadItemSourceArtifact", fields: [sourceVersionId, sourceArtifactId], references: [sourceVersionId, id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([batchId, clientFileId])
  @@unique([batchId, id])
  @@index([storageKey])
  @@index([sourceId])
  @@index([sourceVersionId, sourceArtifactId], map: "KnowledgeUploadItem_source_artifact_idx")
  @@index([state, sessionExpiresAt, updatedAt, id])
}

model KnowledgeUploadPart {
  uploadItemId String
  partNumber   Int
  byteOffset   Int
  byteSize     Int
  etag         String?
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  uploadItem   KnowledgeUploadItem @relation(fields: [uploadItemId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([uploadItemId, partNumber])
  @@index([uploadItemId, completedAt, partNumber])
}

model KnowledgeIndexGeneration {
  id                       String                             @id @default(uuid())
  knowledgeBaseId          String
  profileRevisionId        String?
  embeddingProviderModelId String
  sourceIndexGenerationId  String?
  sourceBaseVersion        Int?
  targetContentRevision    Int?
  targetSourceRevision     Int?
  embeddingConfiguration   Json
  vectorSpaceFingerprint   String                             @db.Char(64)
  targetDimension          Int
  chunkingProfileVersion   Int
  indexedContentRevision   Int                                @default(0)
  status                   KnowledgeIndexGenerationStatus     @default(building)
  lastErrorCode            String?                            @db.VarChar(64)
  readyAt                  DateTime?
  activatedAt              DateTime?
  retiredAt                DateTime?
  failedAt                 DateTime?
  createdAt                DateTime                           @default(now())
  updatedAt                DateTime                           @updatedAt
  activeFor                KnowledgeBase?                     @relation("KnowledgeBaseActiveIndexGeneration")
  baseSnapshots            KnowledgeBaseSnapshot[]
  chunks                   KnowledgeChunk[]
  derivedIndexGenerations  KnowledgeIndexGeneration[]         @relation("KnowledgeIndexGenerationSource")
  embeddingProviderModel   ProviderModel                      @relation(fields: [embeddingProviderModelId], references: [id], onDelete: Restrict)
  generationDocuments      KnowledgeGenerationDocument[]
  ingestDocumentVersions   KnowledgeDocumentVersion[]         @relation("KnowledgeDocumentVersionIngestGeneration")
  knowledgeBase            KnowledgeBase                      @relation("KnowledgeBaseIndexGenerations", fields: [knowledgeBaseId], references: [id], onDelete: Restrict)
  profileRevision          KnowledgeIndexProfileRevision?     @relation(fields: [profileRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  runBindings              KnowledgeRunBinding[]
  sourceIndexGeneration    KnowledgeIndexGeneration?          @relation("KnowledgeIndexGenerationSource", fields: [knowledgeBaseId, sourceIndexGenerationId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeIndexGeneration_source_fkey")
  usageEvents              UsageEvent[]                       @relation("KnowledgeUsageGeneration")
  v1SourceArtifactMaps     KnowledgeV1GenerationArtifactMap[]

  @@unique([knowledgeBaseId, id])
  @@index([embeddingProviderModelId])
  @@index([knowledgeBaseId, status])
  @@index([profileRevisionId])
  @@index([profileRevisionId, status], map: "KnowledgeIndexGeneration_profile_status_idx")
  @@index([sourceIndexGenerationId])
}

model KnowledgeSource {
  id                  String                          @id @default(uuid())
  ownerUserId         String
  name                String
  description         String                          @default("")
  tags                String[]                        @default([])
  currentVersionId    String?                         @unique
  pendingVersionId    String?                         @unique
  version             Int                             @default(1)
  trashedAt           DateTime?
  deletionRequestedAt DateTime?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  baseMemberships     KnowledgeBaseSource[]
  currentVersion      KnowledgeSourceVersion?         @relation("KnowledgeSourceCurrentVersion", fields: [id, currentVersionId], references: [sourceId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeSource_currentVersion_fkey")
  owner               User                            @relation("KnowledgeSourceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  pendingVersion      KnowledgeSourceVersion?         @relation("KnowledgeSourcePendingVersion", fields: [id, pendingVersionId], references: [sourceId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeSource_pendingVersion_fkey")
  projectBindings     ProjectKnowledgeSourceBinding[]
  runSourceBindings   KnowledgeRunSourceBinding[]
  snapshotSources     KnowledgeBaseSnapshotSource[]
  v1DocumentMaps      KnowledgeV1DocumentSourceMap[]
  versions            KnowledgeSourceVersion[]        @relation("KnowledgeSourceVersions")

  @@unique([id, ownerUserId])
  @@unique([id, currentVersionId])
  @@unique([id, pendingVersionId])
  @@index([ownerUserId, trashedAt, name])
  @@index([trashedAt, deletionRequestedAt, id])
}

model KnowledgeDeletionJob {
  id              String                      @id @default(uuid())
  ownerUserId     String
  targetType      KnowledgeDeletionTargetType
  targetId        String
  state           KnowledgeDeletionState      @default(PENDING)
  manifestVersion Int                         @default(1)
  claimToken      String?
  claimedAt       DateTime?
  leaseExpiresAt  DateTime?
  attemptCount    Int                         @default(0)
  nextAttemptAt   DateTime                    @default(now())
  lastAttemptAt   DateTime?
  completedAt     DateTime?
  lastErrorCode   String?                     @db.VarChar(64)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  objects         KnowledgeDeletionObject[]

  @@unique([targetType, targetId])
  @@index([state, nextAttemptAt, leaseExpiresAt, createdAt, id])
  @@index([ownerUserId, state, createdAt, id])
}

model KnowledgeDeletionObject {
  knowledgeDeletionJobId String
  storageKey             String
  disposition            KnowledgeDeletionObjectDisposition @default(PENDING)
  settledAt              DateTime?
  createdAt              DateTime                           @default(now())
  updatedAt              DateTime                           @updatedAt
  job                    KnowledgeDeletionJob               @relation(fields: [knowledgeDeletionJobId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([knowledgeDeletionJobId, storageKey])
  @@index([storageKey, disposition])
}

model KnowledgeSourceVersion {
  id                 String                                @id @default(uuid())
  sourceId           String
  ownerUserId        String
  versionNumber      Int
  fileName           String
  mimeType           String
  byteSize           Int
  checksum           String                                @db.Char(64)
  originalStorageKey String?
  createdAt          DateTime                              @default(now())
  artifacts          KnowledgeSourceIndexArtifact[]
  currentFor         KnowledgeSource?                      @relation("KnowledgeSourceCurrentVersion")
  pendingFor         KnowledgeSource?                      @relation("KnowledgeSourcePendingVersion")
  runSourceBindings  KnowledgeRunSourceBinding[]
  snapshotSources    KnowledgeBaseSnapshotSource[]
  source             KnowledgeSource                       @relation("KnowledgeSourceVersions", fields: [sourceId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeSourceVersion_source_owner_fkey")
  v1VersionMaps      KnowledgeV1DocumentVersionSourceMap[]

  @@unique([sourceId, versionNumber])
  @@unique([sourceId, id])
  @@unique([id, ownerUserId])
  @@unique([sourceId, id, ownerUserId])
  @@index([originalStorageKey])
}

model KnowledgeSourceIndexArtifact {
  id                       String                                  @id @default(uuid())
  sourceVersionId          String
  profileRevisionId        String
  state                    KnowledgeSourceArtifactState            @default(pending)
  processingStage          KnowledgeSourceArtifactProcessingStage?
  normalizedTextStorageKey String?
  normalizedTextByteSize   Int?
  normalizedTextChecksum   String?                                 @db.Char(64)
  pageCount                Int?
  chunkCount               Int?
  embeddedPassageCount     Int                                     @default(0)
  warningCodes             String[]                                @default([])
  errorCode                String?                                 @db.VarChar(64)
  claimToken               String?                                 @db.VarChar(128)
  claimedAt                DateTime?
  attemptCount             Int                                     @default(0)
  nextAttemptAt            DateTime                                @default(now())
  processingStartedAt      DateTime?
  readyAt                  DateTime?
  createdAt                DateTime                                @default(now())
  updatedAt                DateTime                                @updatedAt
  profileRevision          KnowledgeIndexProfileRevision           @relation(fields: [profileRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pdfProcessingAttempts    KnowledgePdfProcessingAttempt[]
  runSourceBindings        KnowledgeRunSourceBinding[]
  hierarchicalIndexes      KnowledgeHierarchicalIndexArtifact[]
  snapshotSources          KnowledgeBaseSnapshotSource[]
  sourceVersion            KnowledgeSourceVersion                  @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadItems              KnowledgeUploadItem[]                   @relation("KnowledgeUploadItemSourceArtifact")
  v1GenerationMaps         KnowledgeV1GenerationArtifactMap[]

  @@unique([sourceVersionId, profileRevisionId])
  @@unique([sourceVersionId, id])
  @@index([profileRevisionId, state])
  @@index([state, nextAttemptAt, claimedAt, createdAt], map: "KnowledgeSourceIndexArtifact_queue_idx")
}

model KnowledgePdfProcessingAttempt {
  id               String                             @id @default(uuid())
  sourceArtifactId String
  sourceVersionId  String
  batchIndex       Int
  mode             KnowledgePdfProcessingMode
  pageStart        Int
  pageEnd          Int
  requestDigest    String                             @db.Char(64)
  state            KnowledgePdfProcessingAttemptState @default(reserved)
  resultText       String?
  resultChecksum   String?                            @db.Char(64)
  usage            Json?
  dispatchedAt     DateTime?
  settledAt        DateTime?
  createdAt        DateTime                           @default(now())
  updatedAt        DateTime                           @updatedAt
  sourceArtifact   KnowledgeSourceIndexArtifact       @relation(fields: [sourceVersionId, sourceArtifactId], references: [sourceVersionId, id], onDelete: Cascade, onUpdate: Restrict, map: "KnowledgePdfAttempt_source_artifact_fkey")
  usageEvent       UsageEvent?

  @@unique([sourceArtifactId, batchIndex])
  @@index([sourceVersionId, sourceArtifactId], map: "KnowledgePdfAttempt_source_artifact_idx")
  @@index([state, updatedAt])
}

model KnowledgeHierarchicalIndexArtifact {
  id               String                          @id
  sourceArtifactId String
  sourceVersionId  String
  schemaVersion    Int
  derivationMode   String                          @db.VarChar(32)
  state            KnowledgeHierarchicalIndexState @default(building)
  checksum         String?                         @db.Char(64)
  documentCount    Int                             @default(0)
  sectionCount     Int                             @default(0)
  passageCount     Int                             @default(0)
  exactEntryCount  Int                             @default(0)
  lastErrorCode    String?                         @db.VarChar(64)
  readyAt          DateTime?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  sourceArtifact   KnowledgeSourceIndexArtifact    @relation(fields: [sourceVersionId, sourceArtifactId], references: [sourceVersionId, id], onDelete: Cascade, onUpdate: Restrict, map: "KHI_source_artifact_fkey")
  documentIndex    KnowledgeArtifactDocumentIndex?
  sectionIndexes   KnowledgeArtifactSectionIndex[]
  passageIndexes   KnowledgeArtifactPassageIndex[]
  exactEntries     KnowledgeArtifactExactEntry[]

  @@unique([sourceArtifactId, schemaVersion], map: "KHI_source_artifact_version_key")
  @@index([sourceVersionId, sourceArtifactId], map: "KHI_source_version_artifact_idx")
  @@index([state, schemaVersion, createdAt], map: "KHI_state_version_created_idx")
}

model KnowledgeArtifactDocumentIndex {
  indexArtifactId     String                             @id
  sourceName          String
  fileName            String
  title               String?
  description         String                             @default("")
  tags                String[]                           @default([])
  tagsText            String                             @default("")
  languages           String[]                           @default([])
  documentType        String                             @db.VarChar(255)
  pageCount           Int
  summary             String                             @default("")
  outline             String[]                           @default([])
