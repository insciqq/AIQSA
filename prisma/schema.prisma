  acceptedByUserId      String?
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
  acceptedBy            User?     @relation("MemoryEgressAdminPolicyUpdater", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([acceptedByUserId])
}

model AccessGrant {
  id                   String              @id @default(uuid())
  userId               String?
  groupId              String?
  providerConnectionId String?
  providerModelId      String?
  searchStrategy       String?
  enabled              Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  group                Group?              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  providerConnection   ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: Restrict)
  providerModel        ProviderModel?      @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  user                 User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([providerConnectionId])
  @@index([providerModelId])
  @@index([searchStrategy])
  @@index([userId])
}

model Folder {
  id                   String   @id @default(uuid())
  userId               String
  parentId             String?
  name                 String
  projectMemory        String   @default("")
  defaultKnowledgePlan Json?
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  chats                Chat[]
  children             Folder[] @relation("FolderHierarchy")
  parent               Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, parentId, name])
  @@unique([userId, id])
  @@index([parentId])
  @@index([userId, sortOrder])
  @@index([userId, parentId, sortOrder])
}

enum AssistantPublicationScope {
  group
  installation
}

enum SkillPublicationScope {
  group
  installation
}

enum SkillShareRequestState {
  pending
  approved
  rejected
  withdrawn
  superseded
}

enum AssistantListingRequestState {
  pending
  approved
  rejected
  withdrawn
  superseded
}

enum AssistantRowPolicy {
  fixed
  adjustable
}

enum AssistantMcpMode {
  inherit
  off
  exact
}

enum SkillsMode {
  auto
  off
}

enum AssistantSkillMode {
  pinned
  available
}

enum ModelRunSkillMode {
  pinned
  loaded
}

model AssistantDefinition {
  id                String                    @id @default(uuid())
  ownerUserId       String
  version           Int                       @default(1)
  archivedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  name               String
  description        String                    @default("")
  category           String?
  avatar             Json
  /// Null means Inherit; a fixed model row requires a concrete model.
  providerModelId    String?
  systemPrompt       String
  /// Retired and merged into systemPrompt; kept only for previous-release writers.
  developerPrompt    String?
  answerRules        String?
  responseReminder   String                    @default("")
  skillsMode         SkillsMode                @default(auto)
  runControls        Json                      @default("{}")
  searchPlan         Json
  mcpMode            AssistantMcpMode          @default(off)
  mcpServerIds       String[]                  @default([])
  starterPrompts     String[]                  @default([])
  modelPolicy        AssistantRowPolicy        @default(fixed)
  /// An empty control set is never fixed, so the column default matches runControls.
  controlsPolicy     AssistantRowPolicy        @default(adjustable)
  searchPolicy       AssistantRowPolicy        @default(fixed)
  toolsPolicy        AssistantRowPolicy        @default(fixed)
  skillsPolicy       AssistantRowPolicy        @default(fixed)
  owner              User                      @relation("AssistantDefinitionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  providerModel      ProviderModel?            @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  boundChats         Chat[]
  defaultForSettings UserSettings[]            @relation("UserDefaultAssistant")
  listingRequests    AssistantListingRequest[]
  pins               AssistantPin[]
  publications       AssistantPublication[]
  skillLinks         AssistantSkill[]
  modelRuns          ModelRun[]
  telegramLinks      TelegramLink[]

  @@unique([ownerUserId, id])
  @@index([ownerUserId, archivedAt])
  @@index([providerModelId])
}

model AssistantPublication {
  id                String                    @id @default(uuid())
  assistantId       String
  scope             AssistantPublicationScope
  groupId           String?
  publishedByUserId String?
  /// Installation scope only; unique among Featured publications through a SQL partial index.
  featuredOrder     Int?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  assistant         AssistantDefinition       @relation(fields: [assistantId], references: [id], onDelete: Restrict)
  group             Group?                    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  publishedBy       User?                     @relation("AssistantPublicationPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  @@unique([assistantId, groupId])
  @@index([groupId])
  @@index([assistantId, scope])
}

model AssistantPin {
  userId      String
  assistantId String
  createdAt   DateTime            @default(now())
  assistant   AssistantDefinition @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, assistantId])
  @@index([assistantId])
}

model SkillDefinition {
  id                     String                   @id @default(uuid())
  ownerUserId            String
  currentRevisionId      String?                  @unique
  sharedRevisionId       String?                  @unique
  importSourceJson       Json?
  version                Int                      @default(1)
  archivedAt             DateTime?
  deletedAt              DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  /// The composite relation proves the current pointer targets a revision of this definition.
  currentRevision        SkillRevision?           @relation("SkillCurrentRevision", fields: [id, currentRevisionId], references: [skillId, id], onDelete: Restrict, onUpdate: Restrict, map: "SkillDefinition_currentRevision_fkey")
  sharedRevision         SkillRevision?           @relation("SkillSharedRevision", fields: [id, sharedRevisionId], references: [skillId, id], onDelete: Restrict, onUpdate: Restrict, map: "SkillDefinition_sharedRevision_fkey")
  owner                  User                     @relation("SkillDefinitionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  assistantLinks         AssistantSkill[]
  publications           SkillPublication[]
  revisions              SkillRevision[]          @relation("SkillRevisions")
  shareRequests          SkillShareRequest[]
  preferences            UserSkillPreference[]

  @@unique([id, currentRevisionId])
  @@unique([id, sharedRevisionId])
  @@unique([ownerUserId, id])
  @@index([ownerUserId, archivedAt])
  @@index([deletedAt, updatedAt, id])
}

model SkillRevision {
  id               String                 @id @default(uuid())
  skillId          String
  revisionNumber   Int
  schemaVersion    Int                    @default(1)
  name             String
  description      String                 @default("")
  instructions     String
  frontmatterJson  Json?
  bundleDigest     String                 @default("")
  fileCount        Int                    @default(0)
  bundleByteSize   Int                    @default(0)
  hasExecutables   Boolean                @default(false)
  /// Staged binary objects are never selected before checksum settlement.
  bundleReady      Boolean                @default(true)
  authorUserId     String?
  createdAt        DateTime               @default(now())
  skill            SkillDefinition        @relation("SkillRevisions", fields: [skillId], references: [id], onDelete: Restrict)
  author           User?                  @relation("SkillRevisionAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  currentFor       SkillDefinition?       @relation("SkillCurrentRevision")
  sharedFor        SkillDefinition?       @relation("SkillSharedRevision")
  modelRunBindings ModelRunSkillBinding[]
  files            SkillRevisionFile[]
  shareRequests    SkillShareRequest[]

  @@unique([skillId, revisionNumber])
  @@unique([skillId, id])
  @@index([authorUserId])
}

model SkillRevisionFile {
  revisionId  String
  skillId     String
  path        String
  byteSize    Int
  checksum    String
  kind        String
  executable  Boolean       @default(false)
  textContent String?
  storageKey  String?
  revision    SkillRevision @relation(fields: [skillId, revisionId], references: [skillId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([revisionId, path])
  @@index([skillId, revisionId])
  @@index([storageKey])
}

model SkillPublication {
  id                String                @id @default(uuid())
  skillId           String
  scope             SkillPublicationScope
  groupId           String?
  publishedByUserId String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  skill             SkillDefinition       @relation(fields: [skillId], references: [id], onDelete: Restrict)
  group             Group?                @relation(fields: [groupId], references: [id], onDelete: Restrict)
  publishedBy       User?                 @relation("SkillPublicationPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  @@unique([skillId, groupId])
  @@index([groupId])
  @@index([skillId, scope])
}

model SkillShareRequest {
  id                String                 @id @default(uuid())
  skillId           String
  revisionId        String
  requestedByUserId String
  state             SkillShareRequestState @default(pending)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime               @default(now())
  skill             SkillDefinition        @relation(fields: [requestedByUserId, skillId], references: [ownerUserId, id], onDelete: Restrict, onUpdate: Restrict)
  revision          SkillRevision          @relation(fields: [skillId, revisionId], references: [skillId, id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy       User                   @relation("SkillShareRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy        User?                  @relation("SkillShareReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([state, createdAt, id])
  @@index([skillId, createdAt, id])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
}

/// One pending request per Assistant (SQL partial unique index); decided rows are frozen by a guard trigger.
model AssistantListingRequest {
  id                String                       @id @default(uuid())
  assistantId       String
  requestedByUserId String
  state             AssistantListingRequestState @default(pending)
  definitionVersion Int
  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime                     @default(now())
  assistant         AssistantDefinition          @relation(fields: [requestedByUserId, assistantId], references: [ownerUserId, id], onDelete: Cascade, onUpdate: Restrict)
  requestedBy       User                         @relation("AssistantListingRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy        User?                        @relation("AssistantListingReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([state, createdAt, id])
  @@index([assistantId, createdAt, id])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
}

model AssistantSkill {
  assistantId String
  skillId     String
  ordinal     Int
  mode        AssistantSkillMode @default(pinned)
  assistant   AssistantDefinition @relation(fields: [assistantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  skill       SkillDefinition     @relation(fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([assistantId, skillId])
  @@unique([assistantId, ordinal])
  @@index([skillId])
}

model UserSkillPreference {
  userId    String
  skillId   String
  enabled   Boolean
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  skill     SkillDefinition @relation(fields: [skillId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([userId, skillId])
  @@index([skillId])
}

model ProviderModel {
  nativeRoutingAdoptionVersion Int                             @default(1)
  nativeRoutingAdoptionReason  String?                         @db.VarChar(32)
  nativeRoutingAdoptionEvidence Json?
  chatPdfPreparations ChatPdfAttachmentPreparation[]
  id                          String                          @id @default(uuid())
  connectionId                String
  templateKey                 String?                         @unique
  provider                    String
  modelId                     String
  displayName                 String
  modelClass                  ProviderModelClass              @default(answer)
  inputTokenPriceMicros       Int                             @default(0)
  outputTokenPriceMicros      Int                             @default(0)
  /// Retained legacy integer columns above keep previous-release writers valid.
  inputTokenPriceUsdPerMillion Decimal? @db.Decimal(18, 8)
  cachedInputTokenPriceUsdPerMillion Decimal? @db.Decimal(18, 8)
  cacheWriteInputTokenPriceUsdPerMillion Decimal? @db.Decimal(18, 8)
  outputTokenPriceUsdPerMillion Decimal? @db.Decimal(18, 8)
  /// USD per 1,000 web searches the provider reports, charged on top of tokens; answer models only.
  webSearchPriceUsdPerThousand Decimal? @db.Decimal(18, 8)
  priceSource ModelPriceSource @default(catalog)
  supportsVision              Boolean                         @default(false)
  supportsPdf                 Boolean                         @default(false)
  supportsReasoning           Boolean                         @default(false)
  supportsNativeSearch        Boolean                         @default(false)
  enabled                     Boolean                         @default(true)
  draftConfig                 Json                            @default("{}")
  draftVersion                Int                             @default(1)
  activeConfig                Json?
  activeVersion               Int                             @default(0)
  activatedAt                 DateTime?
  capabilities                Json
  defaultParams               Json
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt
  accessGrants                AccessGrant[]
  activeCredentialChecks      ProviderModelCredentialCheck[]
  assistantDefinitions        AssistantDefinition[]
  connection                  ProviderConnection              @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  draftChecks                 ProviderDraftCheck[]
  providerRunBindings         ProviderRunBinding[]
  searchStrategies            SearchStrategy[]
  searchRevisions             SearchIntegrationRevision[]
  chatDefaults                Chat[]                          @relation("ChatDefaultProviderModel")
  installationDefaults        ModelPolicy[]                   @relation("InstallationDefaultProviderModel")
  chatTitleRoles              SystemModelPolicy[]             @relation("ChatTitleProviderModel")
  chatPdfNativeRoles          SystemModelPolicy[]             @relation("ChatPdfNativeProviderModel")
  visionRoles                 SystemModelPolicy[]             @relation("VisionProviderModel")
  chatPdfRoles                SystemModelPolicy[]             @relation("ChatPdfProviderModel")
  systemUtilityRoles          SystemModelPolicy[]             @relation("SystemUtilityProviderModel")
  memoryUtilityRoles          MemoryUtilityModelPolicy[]       @relation("MemoryUtilityProviderModel")
  memoryEmbeddingDefaults     MemoryUtilityModelPolicy[]       @relation("MemoryEmbeddingDefaultProviderModel")
  imageGenerationRoles       SystemModelPolicy[]             @relation("ImageGenerationProviderModel")
  imagePublication            PublishedImageModel?            @relation("PublishedImageModel")
  memoryRerankerRoles         SystemModelPolicy[]             @relation("MemoryRerankerProviderModel")
  semanticDecisionRoles       SystemModelPolicy[]             @relation("SemanticDecisionProviderModel")
  userDefaults                UserSettings[]                  @relation("UserDefaultProviderModel")

  @@unique([connectionId, id])
  @@index([provider, modelId])
  @@index([modelClass, enabled])
  @@index([connectionId, enabled])
  @@index([provider, enabled])
}

model ProviderConnection {
  id                  String                   @id @default(uuid())
  templateKey         String?                  @unique
  displayName         String
  family              String
  enabled             Boolean                  @default(false)
  unassignedPolicy    ProviderUnassignedPolicy @default(use_default)
  defaultCredentialId String?
  catalogSkippedIds   String[]                 @default([])
  draftConfig         Json                     @default("{}")
  draftVersion        Int                      @default(1)
  activeConfig        Json?
  activeVersion       Int                      @default(0)
  activatedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  accessGrants        AccessGrant[]
  credentials         ProviderCredential[]     @relation("ProviderConnectionCredentials")
  defaultCredential   ProviderCredential?      @relation("ProviderConnectionDefaultCredential", fields: [id, defaultCredentialId], references: [connectionId, id], onDelete: Restrict, onUpdate: Restrict, map: "ProviderConnection_defaultCredential_fkey")
  models              ProviderModel[]
  searchOptions       SearchOption[]

  @@index([enabled])
}

model SearchOption {
  id                 String                 @id @default(uuid())
  optionId           String                 @unique
  displayName        String
  description        String
  kind               String
  templateKey        String?                @unique
  sourceConnectionId String?
  enabled            Boolean                @default(true)
  archivedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  sourceConnection   ProviderConnection?    @relation(fields: [sourceConnectionId], references: [id], onDelete: Restrict)
  strategies         SearchStrategy[]

  @@unique([sourceConnectionId, kind])
  @@index([sourceConnectionId])
  @@index([enabled, archivedAt])
}

model ProviderCredential {
  id                          String                              @id @default(uuid())
  connectionId                String
  label                       String
  enabled                     Boolean                             @default(false)
  draftSecretEnvelope         String?
  draftVersion                Int                                 @default(0)
  activeVersionId             String?
  testedAt                    DateTime?
  activatedAt                 DateTime?
  createdAt                   DateTime                            @default(now())
  updatedAt                   DateTime                            @updatedAt
  activeCredentialChecks      ProviderModelCredentialCheck[]
  activeVersion               ProviderCredentialVersion?          @relation("ProviderCredentialActiveVersion", fields: [id, activeVersionId], references: [credentialId, id], onDelete: Restrict, onUpdate: Restrict, map: "ProviderCredential_activeVersion_fkey")
  connection                  ProviderConnection                  @relation("ProviderConnectionCredentials", fields: [connectionId], references: [id], onDelete: Restrict)
  defaultForConnections       ProviderConnection[]                @relation("ProviderConnectionDefaultCredential")
  draftChecks                 ProviderDraftCheck[]
  groupAssignments            ProviderGroupCredentialAssignment[]
  userAssignments             ProviderUserCredentialAssignment[]
  providerRunBindings         ProviderRunBinding[]
  versions                    ProviderCredentialVersion[]         @relation("ProviderCredentialVersions")

  @@unique([connectionId, id])
  @@unique([connectionId, label])
  @@unique([id, activeVersionId])
  @@index([connectionId, enabled])
}

model ProviderCredentialVersion {
  chatPdfPreparations ChatPdfAttachmentPreparation[]
  chatTitleGenerations ChatTitleGeneration[]
  id                          String                         @id @default(uuid())
  credentialId                String
  version                     Int
  secretEnvelope              String?
  testEvidence                Json
  testedAt                    DateTime
  activatedAt                 DateTime
  revokedAt                   DateTime?
  createdAt                   DateTime                       @default(now())
  activeFor                   ProviderCredential?            @relation("ProviderCredentialActiveVersion")
  activeCredentialChecks      ProviderModelCredentialCheck[]
  credential                  ProviderCredential             @relation("ProviderCredentialVersions", fields: [credentialId], references: [id], onDelete: Restrict)
  draftChecks                 ProviderDraftCheck[]
  providerRunBindings         ProviderRunBinding[]

  @@unique([credentialId, id])
  @@unique([credentialId, version])
  @@index([revokedAt])
}

model ProviderGroupCredentialAssignment {
  connectionId String
  groupId      String
  credentialId String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  credential   ProviderCredential @relation(fields: [connectionId, credentialId], references: [connectionId, id], onDelete: Restrict, onUpdate: Restrict, map: "ProviderGroupAssignment_credential_fkey")
  group        Group              @relation(fields: [groupId], references: [id], onDelete: Restrict, map: "ProviderGroupAssignment_group_fkey")

  @@id([connectionId, groupId])
  @@index([credentialId])
  @@index([groupId])
}

model ProviderUserCredentialAssignment {
  connectionId String
  userId       String
  credentialId String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  credential   ProviderCredential @relation(fields: [connectionId, credentialId], references: [connectionId, id], onDelete: Restrict, onUpdate: Restrict, map: "ProviderUserAssignment_credential_fkey")
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ProviderUserAssignment_user_fkey")

  @@id([connectionId, userId])
  @@index([credentialId])
  @@index([userId])
}

model ProviderDraftCheck {
  id                     String                        @id @default(uuid())
  fingerprint            String                        @unique
  connectionId           String
  providerModelId        String
  credentialId           String
  credentialVersionId    String?
  credentialDraftVersion Int?
  connectionDraftVersion Int
  modelDraftVersion      Int
  status                 ProviderCredentialCheckStatus
  evidence               Json?
  checkedAt              DateTime
  createdAt              DateTime                      @default(now())
  credential             ProviderCredential            @relation(fields: [connectionId, credentialId], references: [connectionId, id], onDelete: Cascade, onUpdate: Restrict, map: "ProviderDraftCheck_credential_fkey")
  credentialVersion      ProviderCredentialVersion?    @relation(fields: [credentialId, credentialVersionId], references: [credentialId, id], onDelete: Cascade, onUpdate: Restrict, map: "ProviderDraftCheck_version_fkey")
  model                  ProviderModel                 @relation(fields: [connectionId, providerModelId], references: [connectionId, id], onDelete: Cascade, onUpdate: Restrict, map: "ProviderDraftCheck_model_fkey")

  @@index([connectionId, providerModelId])
  @@index([credentialId, credentialVersionId])
}

model ProviderModelCredentialCheck {
  id                  String                        @id @default(uuid())
  connectionId        String
  providerModelId     String
  credentialId        String
  credentialVersionId String
  connectionVersion   Int
  modelVersion        Int
  status              ProviderCredentialCheckStatus
  evidence            Json?
  latestRefreshError  Json?
  checkedAt           DateTime
  refreshFailedAt     DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  credential          ProviderCredential            @relation(fields: [connectionId, credentialId], references: [connectionId, id], onDelete: Cascade, onUpdate: Restrict, map: "ProviderModelCredentialCheck_credential_fkey")
  credentialVersion   ProviderCredentialVersion     @relation(fields: [credentialId, credentialVersionId], references: [credentialId, id], onDelete: Cascade, onUpdate: Restrict, map: "ProviderModelCredentialCheck_version_fkey")
  model               ProviderModel                 @relation(fields: [connectionId, providerModelId], references: [connectionId, id], onDelete: Cascade, onUpdate: Restrict, map: "ProviderModelCredentialCheck_model_fkey")

  @@unique([providerModelId, credentialVersionId, connectionVersion, modelVersion], map: "ProviderModelCredentialCheck_tuple_key")
  @@index([connectionId, providerModelId], map: "ProviderModelCredentialCheck_connection_model_idx")
  @@index([credentialId, credentialVersionId], map: "ProviderModelCredentialCheck_credential_version_idx")
}

model ProviderRunBinding {
  visionAnalyses            VisionAnalysisAttempt[]
  id                        String                     @id @default(uuid())
  modelRunId                String
  bindingKey                String                     @default("answer")
  role                      ProviderRunRole
  connectionId              String?
  providerModelId           String?
  credentialId              String?
  credentialVersionId       String?
  credentialSource          ProviderCredentialSource
  executionSnapshot         Json
  recoverableUntil          DateTime?
  createdAt                 DateTime                   @default(now())
  credential                ProviderCredential?        @relation(fields: [connectionId, credentialId], references: [connectionId, id], onDelete: Restrict, onUpdate: Restrict, map: "ProviderRunBinding_credential_fkey")
  credentialVersion         ProviderCredentialVersion? @relation(fields: [credentialId, credentialVersionId], references: [credentialId, id], onDelete: Restrict, onUpdate: Restrict, map: "ProviderRunBinding_version_fkey")
  model                     ProviderModel?             @relation(fields: [connectionId, providerModelId], references: [connectionId, id], onDelete: Restrict, onUpdate: Restrict, map: "ProviderRunBinding_model_fkey")
  modelRun                  ModelRun                   @relation(fields: [modelRunId], references: [id], onDelete: Cascade)

  @@unique([modelRunId, bindingKey])
  @@index([modelRunId, role])
  @@index([connectionId, providerModelId], map: "ProviderRunBinding_connection_model_idx")
  @@index([credentialId, credentialVersionId], map: "ProviderRunBinding_credential_version_idx")
  @@index([recoverableUntil])
}

model SearchStrategy {
  id                String                      @id @default(uuid())
  searchOptionId    String
  strategyId        String                      @unique
  provider          String
  modelId           String?
  providerModelId   String?
  displayName       String
  kind              String
  description       String
  enabled           Boolean                     @default(true)
  config            Json
  adapterKind       String                      @default("answer_provider_hosted")
  credentialMode    String                      @default("answer_provider")
  draft             Json                        @default("{}")
  draftVersion      Int                         @default(1)
  testedDraftHash   String?
  draftTestEvidence Json?
  activeRevisionId  String?                     @unique
  activatedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  activeRevision    SearchIntegrationRevision?  @relation("ActiveSearchRevision", fields: [id, activeRevisionId], references: [searchStrategyId, id], onDelete: Restrict, onUpdate: Restrict, map: "SearchStrategy_activeRevision_fkey")
  providerModel     ProviderModel?              @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  revisions         SearchIntegrationRevision[] @relation("SearchIntegrationRevisions")
  searchOption      SearchOption                @relation(fields: [searchOptionId], references: [id], onDelete: Restrict)

  @@unique([id, activeRevisionId])
  @@index([providerModelId])
  @@index([searchOptionId])
  @@index([enabled, archivedAt])
}

model SearchIntegrationRevision {
  id                    String          @id @default(uuid())
  searchStrategyId      String
  revisionNumber        Int
  adapterKind           String
  credentialMode        String
  configuration         Json
  providerModelId       String?
  validationEvidence    Json
  draftHash             String
  validationFingerprint String
  createdAt             DateTime        @default(now())
  activeFor             SearchStrategy? @relation("ActiveSearchRevision")
  providerModel         ProviderModel?  @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  searchStrategy        SearchStrategy  @relation("SearchIntegrationRevisions", fields: [searchStrategyId], references: [id], onDelete: Restrict)
  searchRuns            SearchRun[]

  @@unique([searchStrategyId, revisionNumber])
  @@unique([searchStrategyId, draftHash, validationFingerprint], map: "SearchIntegrationRevision_strategy_draft_validation_key")
  @@unique([searchStrategyId, id])
  @@index([providerModelId])
}

model Chat {
  artifactBindings  ArtifactChatBinding[]
  continuations      ChatContinuation[] @relation("SourceChatContinuation")
  continuationSource ChatContinuation?  @relation("ContinuedChat")
  continuationWorkspaceSeeds ChatContinuationWorkspaceSeed[] @relation("ContinuationWorkspaceSeedSource")
  receivedWorkspaceSeeds ChatContinuationWorkspaceSeed[] @relation("ContinuationWorkspaceSeedDestination")
  id                              String               @id @default(uuid())
  userId                          String?
  projectId                       String?
  projectFolderId                 String?
  createdByUserId                 String?
  createdByDisplayName            String               @default("")
  folderId                        String?
  title                           String
  titleRevision                   Int                  @default(0)
  titleGeneration                 ChatTitleGeneration?
  activeLeafMessageId             String?
  defaultProviderModelId          String?
  defaultKnowledgePlan            Json?
  defaultSearchPlan               Json?
  /// Lookups by Assistant use a SQL partial index over bound chats.
  assistantId                     String?
  /// Per-chat changes to adjustable Assistant rows; a present key means changed for this chat.
  assistantOverrides              Json?
  memoryMode                      MemoryChatMode       @default(NORMAL)
  memoryBranchGeneration          Int                  @default(0)
  memorySourceRevision            Int                  @default(0)
  /// Set on an imported chat and copied to its continuations and branch copies.
  /// A SQL check keeps every such chat Excluded from Memory.
  importSource                    ChatImportSource?
  /// SHA-256 of the source conversation identity (for AIQSA documents, of their
  /// canonical content). A SQL partial unique index over (userId, importSource,
  /// importSourceKey) for chats not pending deletion makes a re-import
  /// "already imported"; copies never carry it.
  importSourceKey                 String?              @db.Char(64)
  /// The source's chat-level model label, for display only.
  importSourceModel               String?              @db.VarChar(128)
  permanentDeletionAt             DateTime?
  permanentDeletionOperationId    String?              @unique
  temporaryRetentionPolicyVersion String?              @db.VarChar(64)
  temporaryRetentionDeadline      DateTime?
  pinned                          Boolean              @default(false)
  archived                        Boolean              @default(false)
  /// The scheduled task whose run created this chat: only such chats fall
  /// under that task's history retention. Deleting the task makes it an
  /// ordinary chat (the migration's column-scoped SET NULL).
  scheduledTaskId                 String?
  /// The owner renamed this chat or restored it from the archive; a scheduled
  /// task's history retention keeps such a chat.
  ownerKeptAt                     DateTime?
  workspaceEnabled                Boolean              @default(false)
  /// Retired (Answer Review removed 2026-10-25): nothing reads or writes it;
  /// dropped in a later release.
  answerReviewConfig              Json?
  totalInputTokens                Int                  @default(0)
  totalOutputTokens               Int                  @default(0)
  totalReasoningTokens            Int                  @default(0)
  createdAt                       DateTime             @default(now())
  updatedAt                       DateTime             @updatedAt
  /// The migration uses PostgreSQL's column-scoped SET NULL so deleting the leaf clears only activeLeafMessageId, never Chat.id.
  activeLeafMessage               Message?             @relation("ChatActiveLeaf", fields: [id, activeLeafMessageId], references: [chatId, id], onDelete: SetNull, onUpdate: Restrict, map: "Chat_id_activeLeafMessageId_fkey")
  assistant                       AssistantDefinition? @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  attachments                     Attachment[]
  createdBy                       User?                @relation("ProjectChatCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  folder                          Folder?              @relation(fields: [folderId], references: [id], onDelete: SetNull)
  defaultProviderModel            ProviderModel?       @relation("ChatDefaultProviderModel", fields: [defaultProviderModelId], references: [id], onDelete: Restrict)
  messages                        Message[]            @relation("ChatMessages")
  memoryToolEvents                MemoryToolEvent[]
  modelRuns                       ModelRun[]
  sharedSnapshots                 SharedChatSnapshot[]
  user                            User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceSession                WorkspaceSession?
  scheduledTasks                  ScheduledTask[]           @relation("ScheduledTaskChat")
  scheduledTaskOccurrences        ScheduledTaskOccurrence[]
  /// The migration uses column-scoped SET NULL so task deletion never clears userId.
  scheduledTask                   ScheduledTask?            @relation("ScheduledTaskCreatedChats", fields: [userId, scheduledTaskId], references: [userId, id], onDelete: SetNull, onUpdate: Restrict)
  scheduledTaskCarryovers         ScheduledTaskCarryover[]
  answerReviewSessions            AnswerReviewSession[]
  telegramLinks                   TelegramLink[]            @relation("TelegramLinkCurrentChat")
  telegramMessageRefs             TelegramMessageRef[]
  subagentThreads                 SubagentThread[]

  @@unique([userId, id])
  @@index([activeLeafMessageId])
  @@index([defaultProviderModelId])
  @@index([scheduledTaskId])
  @@index([memoryMode, temporaryRetentionDeadline])
  @@index([projectId, archived, updatedAt])
  @@index([projectFolderId])
  @@index([userId, permanentDeletionAt])
  @@index([userId, archived, updatedAt])
  @@index([userId, assistantId, updatedAt])
}

/// Installation usage limits: a pooled monthly cap for everyone plus per-user
/// defaults, in USD micro-dollars and messages. Null means not set.
model UsageLimitPolicy {
  id                  String   @id
  monthlyCapMicros    BigInt?
  monthlyBudgetMicros BigInt?
  messagesPerHour     Int?
  messagesPerDay      Int?
  version             Int      @default(1)
  updatedByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  updatedBy           User?    @relation("UsageLimitPolicyUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

/// A group's per-member allowance or one user's override: exactly one target.
/// Only a user override may be `exempt`; a row that sets nothing is deleted.
model UsageLimit {
  id                  String   @id @default(uuid())
  groupId             String?  @unique
  userId              String?  @unique
  exempt              Boolean  @default(false)
  monthlyBudgetMicros BigInt?
  messagesPerHour     Int?
  messagesPerDay      Int?
  /// Optimistic concurrency token for administrator saves. Every insert and
  /// change takes the next value of one sequence, so a row removed and created
  /// again never repeats a version that a stale draft still holds.
  version             Int      @default(autoincrement())
  updatedByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  group               Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user                User?    @relation("UsageLimitUser", fields: [userId], references: [id], onDelete: Cascade)
  updatedBy           User?    @relation("UsageLimitUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

/// One admitted interactive run (a send, edit or regeneration; never a
/// scheduled run or the continuation of an accepted one), written with the run
/// and kept 25 hours for the message limits. Unlike ModelRun it survives chat
/// and branch deletion, so deleting chats cannot reset a limit.
model UsageMessageAdmission {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum UsageLimitAlertKind {
  installation_cap_near
  installation_cap_reached
  user_budget_reached
}

enum UsageLimitAlertState {
  claimed
  delivered
  undelivered
}

/// One budget alert to administrators per UTC month, threshold and user
/// (`userId` only for `user_budget_reached`; the unique index treats NULLs as
/// equal). The row is the claim, inserted before sending, so replicas and
/// restarts send an alert at most once. `claimed` is in flight or
/// crash-ambiguous and never retried; `undelivered` means no administrator
/// received it on any channel, so a later check may claim it again.
model UsageLimitAlert {
  id          String               @id @default(uuid())
  periodStart DateTime
  kind        UsageLimitAlertKind
  userId      String?
  state       UsageLimitAlertState @default(claimed)
  attempts    Int                  @default(1)
  claimedAt   DateTime
  settledAt   DateTime?
  user        User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([periodStart, kind, userId])
  @@index([userId])
}

model WorkspacePolicy {
  id              String   @id
  enabled         Boolean  @default(true)
  internetEnabled Boolean  @default(true)
  version         Int      @default(1)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       User?    @relation("WorkspacePolicyUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

model WorkspaceSession {
  id               String                @id @default(uuid())
  chatId           String                @unique
  sandboxName      String                @unique
  runtimeSandboxId String?
  imageRef         String
  state            WorkspaceSessionState @default(PENDING)
  internetEnabled  Boolean
  policyRevision   Int
  version          Int                   @default(1)
  operationOwner   String?               @db.VarChar(160)
  operationExpiresAt DateTime?
  lastErrorCode    String?               @db.VarChar(64)
  lastActiveAt     DateTime              @default(now())
  stoppedAt        DateTime?
  expiresAt        DateTime
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  chat             Chat                  @relation(fields: [chatId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cleanupJob       WorkspaceCleanupJob?
  executions       WorkspaceExecution[]
  runBindings      WorkspaceRunBinding[]

  @@index([state, expiresAt])
  @@index([state, lastActiveAt])
}

model WorkspaceCleanupJob {
  id                 String                @id @default(uuid())
  workspaceSessionId String                @unique
  sandboxName        String
  runtimeSandboxId   String?
  state              WorkspaceCleanupState @default(PENDING)
  claimToken         String?
  claimedAt          DateTime?
  attemptCount       Int                   @default(0)
  nextAttemptAt      DateTime              @default(now())
  lastAttemptAt      DateTime?
  lastErrorCode      String?               @db.VarChar(64)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  workspaceSession   WorkspaceSession      @relation(fields: [workspaceSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([nextAttemptAt, claimedAt, createdAt])
  @@index([state, nextAttemptAt])
}

model Message {
  continuations ChatContinuation[] @relation("SourceMessageContinuation")
  id                     String            @id @default(uuid())
  chatId                 String
  role                   String
  parentMessageId        String?
  content                Json
  provider               String?
  modelId                String?
  status                 MessageStatus     @default(complete)
  inputTokens            Int?
  outputTokens           Int?
  reasoningTokens        Int?
  errorMessage           String?
  authorUserId           String?
  authorDisplayName      String?
  authorProjectRole      ProjectRole?
  branchSourceModelRunId String?
  branchFollowups        Json?
  /// A user message a scheduled task posted (its prompt, possibly model-written). Set
  /// with the scheduled run and kept by branch copies: every answer to it stays out
  /// of Personal Memory and never creates a scheduled task.
  scheduledTaskPrompt    Boolean           @default(false)
  /// A user message the server wrote (`MessageSystemTurnKind`); a CHECK keeps it on user messages.
  systemTurnKind         MessageSystemTurnKind?
  /// A step of a retired answer review session (Answer Review removed
  /// 2026-10-25): its server-written turn and that turn's answer. Nothing
  /// writes it; only the legacy collapse reads it. Deleting the session clears
  /// only this column.
  answerReviewSessionId  String?
  /// The step's round and ordinal in it, set on its turn only. Retired with
  /// the session: nothing reads or writes them.
  answerReviewRound      Int?
  answerReviewStep       Int?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  assistantModelRuns     ModelRun[]        @relation("AssistantMessageRun")
  author                 User?             @relation("ProjectMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  branchSourceModelRun   ModelRun?         @relation("BranchSourceModelRun", fields: [branchSourceModelRunId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  activeLeafForChats     Chat[]            @relation("ChatActiveLeaf")
  chat                   Chat              @relation("ChatMessages", fields: [chatId], references: [id], onDelete: Cascade)
  children               Message[]         @relation("MessageBranches")
  parent                 Message?          @relation("MessageBranches", fields: [chatId, parentMessageId], references: [chatId, id], onDelete: Restrict, onUpdate: Restrict, map: "Message_chatId_parentMessageId_fkey")
  memoryToolEvents       MemoryToolEvent[]
  userModelRuns          ModelRun[]        @relation("UserMessageRun")
  scheduledTaskOccurrences ScheduledTaskOccurrence[]
  scheduledTaskCarryovers  ScheduledTaskCarryover[]
  /// The migration uses column-scoped SET NULL so deleting a session never clears chatId.
  answerReviewSession      AnswerReviewSession? @relation("AnswerReviewSessionMessages", fields: [chatId, answerReviewSessionId], references: [chatId, id], onDelete: SetNull, onUpdate: Restrict, map: "Message_chatId_answerReviewSessionId_fkey")
  answerReviewSources      AnswerReviewSession[] @relation("AnswerReviewSource")
  problemReports           AnswerProblemReport[]
  telegramMessageRefs      TelegramMessageRef[]

  @@unique([chatId, id], map: "Message_chatId_id_key")
  @@unique([answerReviewSessionId, answerReviewRound, answerReviewStep])
  @@index([chatId, parentMessageId])
  @@index([chatId, createdAt])
  @@index([authorUserId])
  @@index([branchSourceModelRunId])
}

/// A cross-model answer review the previous release recorded: reviewer models
/// critiqued an answer and its author model revised it, each step a run of a
/// turn the server wrote (`Message.answerReviewSessionId`). Retired (Answer
/// Review removed 2026-10-25): nothing writes it, and only the legacy collapse
/// reads `id` and `sourceAssistantMessageId`, so the chat reads as the source
/// question and the latest version (`lib/domain/answerReviewTranscript.ts`).
model AnswerReviewSession {
  id                       String                  @id @default(uuid())
  chatId                   String
  /// The initiator; null once the account is deleted.
  userId                   String?
  sourceAssistantMessageId String
  mode                     AnswerReviewMode
  authorModel              Json
  reviewers                Json
  /// Null for a manual session.
  maxRounds                Int?
  round                    Int                     @default(1)
  state                    AnswerReviewState       @default(running)
  stopReason               AnswerReviewStopReason?
  /// Automatic only: the controls the send froze for every step.
  controls                 Json?
  /// Automatic only: when the session's end was handled.
  endNotifiedAt            DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  chat                     Chat                    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  /// A deleted initiator leaves the session and its steps in their chat.
  user                     User?                   @relation("AnswerReviewInitiator", fields: [userId], references: [id], onDelete: SetNull)
  sourceAssistantMessage   Message                 @relation("AnswerReviewSource", fields: [chatId, sourceAssistantMessageId], references: [chatId, id], onDelete: Cascade, onUpdate: Restrict, map: "AnswerReviewSession_source_fkey")
  messages                 Message[]               @relation("AnswerReviewSessionMessages")

  @@unique([chatId, id])
  @@unique([chatId, sourceAssistantMessageId])
  @@index([chatId, state])
  @@index([mode, state])
  @@index([userId])
}

/// A user's report that a persisted answer went wrong, for administrators
/// (Control Center Health): one per user and answer, updated in place. It
/// holds a reason and the user's optional comment, never the question or the
/// answer. The application prunes it 90 days after its last change.
model AnswerProblemReport {
  id        String                    @id @default(uuid())
  chatId    String
  messageId String
  /// The answer's run, for the administrator's run lookup. The migration uses
  /// column-scoped SET NULL so deleting the run never clears chatId.
  runId     String?
  userId    String
  reason    AnswerProblemReportReason
  /// User text only administrators see; never logged or sent to telemetry.
  comment   String?                   @db.VarChar(1000)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  message   Message                   @relation(fields: [chatId, messageId], references: [chatId, id], onDelete: Cascade, onUpdate: Restrict, map: "AnswerProblemReport_message_fkey")
  run       ModelRun?                 @relation(fields: [chatId, runId], references: [chatId, id], onDelete: SetNull, onUpdate: Restrict, map: "AnswerProblemReport_run_fkey")
  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([chatId, runId])
  @@index([updatedAt])
  @@index([userId])
}

/// Content-free claim/result identity. Provider work is never replayed automatically.
model ChatContinuation {
  workspaceSeed     ChatContinuationWorkspaceSeed?
  steps             ChatContinuationStep[]
  id                String   @id @default(uuid())
  sourceChatId      String
  sourceMessageId   String
  snapshotUpdatedAt DateTime
  actorUserId       String?
  attemptId         String   @unique
  requestedProviderModelId String?
  leaseExpiresAt    DateTime?
  cancelRequestedAt DateTime?
  completedParts    Int      @default(0)
  progressStage     String   @default("preparing") @db.VarChar(16)
  status            String   @db.VarChar(16)
  errorCode         String?  @db.VarChar(64)
  newChatId         String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  actor             User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  sourceChat        Chat     @relation("SourceChatContinuation", fields: [sourceChatId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  sourceMessage     Message  @relation("SourceMessageContinuation", fields: [sourceChatId, sourceMessageId], references: [chatId, id], onDelete: Cascade, onUpdate: Restrict)
  newChat           Chat?    @relation("ContinuedChat", fields: [newChatId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([sourceChatId, sourceMessageId, snapshotUpdatedAt], map: "ChatContinuation_source_snapshot_key")
  @@index([actorUserId])
}

/// Settled summary fragments support recovery without repeating paid requests.
/// The owning source lifecycle deletes these private derived contents.
model ChatContinuationStep {
  id             String   @id @default(uuid())
  continuationId String
  attemptId      String
  requestHash    String   @db.VarChar(64)
  status         String   @db.VarChar(16)
  summary        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  continuation   ChatContinuation @relation(fields: [continuationId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([continuationId, requestHash])
}

/// Private Workspace archive captured for one continuation claim. It is never
/// exposed as a conversation attachment or model input.
model ChatContinuationWorkspaceSeed {
  id               String                              @id @default(uuid())
  continuationId   String?                             @unique
  sourceChatId     String?
  newChatId        String?                             @unique
  status           ChatContinuationWorkspaceSeedStatus @default(CAPTURING)
  failureCode      String?                             @db.VarChar(64)
  storageKey       String?
  checksum         String?                             @db.Char(64)
  byteSize         Int?
  attemptCount     Int                                 @default(0)
  leaseToken       String?                             @db.VarChar(64)
  leaseExpiresAt   DateTime?
  restoreStartedAt DateTime?
  /// A scheduled task's monthly rotation captured this seed from the task's
  /// previous chat. Until it is restored the task's scheduled runs in the new
  /// chat fail closed instead of opening an empty project, and the source disk
  /// keeps its retention pin. Deleting the task leaves an ordinary seed.
  scheduledTaskId  String?
  createdAt        DateTime                            @default(now())
  updatedAt        DateTime                            @updatedAt
  continuation     ChatContinuation?                   @relation(fields: [continuationId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  sourceChat       Chat?                               @relation("ContinuationWorkspaceSeedSource", fields: [sourceChatId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  newChat          Chat?                               @relation("ContinuationWorkspaceSeedDestination", fields: [newChatId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  scheduledTask    ScheduledTask?                      @relation(fields: [scheduledTaskId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([status, leaseExpiresAt])
  @@index([sourceChatId, status])
  @@index([newChatId, status])
  @@index([scheduledTaskId, status])
}

enum ChatTitleGenerationStatus {
  pending
  dispatched
  settled
  skipped
  ambiguous
}

model ChatTitleGeneration {
  runId            String                    @id
  chatId           String                    @unique
  userId           String
  expectedTitle    String
  titleRevision    Int
  questionText     String
  answerText       String
  reasoningEffort  String?
  providerSnapshot Json?
  /// Null preserves the legacy accepted title request.
  maxOutputTokens  Int?
  responseTimeoutMs Int?
  dispatchDeadlineAt DateTime?
  credentialVersionId String?
  status           ChatTitleGenerationStatus @default(pending)
  createdAt        DateTime                  @default(now())
  expiresAt        DateTime
  dispatchedAt     DateTime?
  finishedAt       DateTime?
  chat             Chat                      @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  modelRun         ModelRun                  @relation(fields: [userId, chatId, runId], references: [userId, chatId, id], onDelete: Cascade, onUpdate: Restrict)
  usageEvent       UsageEvent?
  credentialVersion ProviderCredentialVersion? @relation(fields: [credentialVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, chatId, runId])
  @@index([status, createdAt])
  @@index([credentialVersionId])
}

model ModelRun {
  followups                    RunFollowup[]
  /// Null for older writers and executors that do not support steering.
  followupMode                 String?                             @db.VarChar(16)
  followupRevision             Int                                 @default(0)
  followupBudgetTokens         Int                                 @default(0)
  followupClosedAt             DateTime?
  followupKnowledgeRevision    Int                                 @default(0)
  followupKnowledgeOffset      Int                                 @default(0)
  workspaceFollowup            WorkspaceFollowup?                  @relation("WaitingWorkspaceRun")
  dependentWorkspaceFollowups   WorkspaceFollowup[]                 @relation("PreviousWorkspaceRun")
  chatTitleGeneration          ChatTitleGeneration?
  chatPdfPreparation           ChatPdfRunPreparation?
  chatPdfAttachments           ChatPdfAttachmentPreparation[]
  id                           String                              @id @default(uuid())
  chatId                       String
  userId                       String
  userMessageId                String
  assistantMessageId           String?
  assistantId                  String?
  assistantIdentity            Json?
  provider                     String
  modelId                      String
  status                       ModelRunStatus
  /// Fixed at admission. Each engine's recovery and background claims touch only
  /// its own runs; previous writers omit the column and create `v1` runs.
  engine                       ModelRunEngine                      @default(v1)
  normalizedRequest            Json?
  providerResponseId           String?
  inputTokens                  Int?
  cachedInputTokens            Int?
  cacheWriteInputTokens        Int?
  outputTokens                 Int?
  reasoningTokens              Int?
  totalTokens                  Int?
  usageCompleteness             TokenUsageCompleteness              @default(UNAVAILABLE)
  estimatedCostMicros          Int?
  errorPayload                 Json?
  toolLoopState                Json?
  answerStartedAt              DateTime?
  answerCompletedAt            DateTime?
  /// Frozen completion accounting for recovery until the run settles.
  answerCompletionUsage        Json?
  workspaceWaitPending         Boolean                             @default(false)
  /// A scheduled task's run: its task, occurrence and task generation at acceptance.
  /// Plain values without relations, so they outlive the task and its history.
  scheduledTaskId              String?
  scheduledOccurrenceId        String?
  scheduledTaskGeneration      Int?
  /// A settled monitoring check's outcome (`ScheduledTaskCheckOutcome`): what the
  /// transcript collapses (`no_update`) after the occurrence history is pruned.
  scheduledOutcome             String?                             @db.VarChar(64)
  /// A background sub-agent run: the thread it executes and its turn (`SubagentTurn`), both or neither (SQL check).
  /// Null on every main-agent run, so `subagentTurnId: null` selects the chat's own turns. Such a run shares its
  /// parent run's user message and never answers one (`assistantMessageId` stays null). The SQL-only
  /// `ModelRun_one_active_per_chat_idx` holds one active run per (chat, thread), NULLS NOT DISTINCT, so the main
  /// agent keeps one per chat and a background sub-agent runs beside it.
  subagentThreadId             String?
  subagentTurnId               String?
  createdAt                    DateTime                            @default(now())
  updatedAt                    DateTime                            @updatedAt
  subagentTurn                 SubagentTurn?                       @relation("SubagentTurnExecution", fields: [userId, chatId, subagentThreadId, subagentTurnId], references: [userId, chatId, threadId, id], onDelete: Cascade, onUpdate: Restrict, map: "ModelRun_subagentTurn_fkey")
  subagentThreadsAnchored      SubagentThread[]                    @relation("SubagentThreadAnchor")
  subagentTurnsStarted         SubagentTurn[]                      @relation("SubagentTurnParent")
  subagentCallbacks            SubagentTurn[]                      @relation("SubagentTurnCallback")
  assistantMessage             Message?                            @relation("AssistantMessageRun", fields: [assistantMessageId], references: [id], onDelete: SetNull)
  branchSourceMessages         Message[]                           @relation("BranchSourceModelRun")
  /// Accepted identity is immutable; deleting the definition only detaches assistantId. Execution lives in the normalized request and exact bindings.
  assistant                    AssistantDefinition?                @relation(fields: [assistantId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  chat                         Chat                                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  events                       ModelRunEvent[]
  mcpRunBindings               McpRunBinding[]
  mcpToolApprovals             McpToolApproval[]
  optionalDecisionAttempts     OptionalDecisionAttempt[]
  memoryHistoryRuns            MemoryHistoryRun[]
  memoryToolEvents             MemoryToolEvent[]
  providerRunBindings          ProviderRunBinding[]
  searchRuns                   SearchRun[]
  skillRunBindings             ModelRunSkillBinding[]
  toolCalls                    ModelRunToolCall[]
  toolObservations             ToolObservation[]
  transcriptItems              RunTranscriptItem[]
  userMessage                  Message                             @relation("UserMessageRun", fields: [userMessageId], references: [id], onDelete: Restrict)
  usageEvents                  UsageEvent[]
  workspaceRunBinding          WorkspaceRunBinding?
  workspaceExecutions          WorkspaceExecution[]
  workspaceProducedAttachments Attachment[]                        @relation("WorkspaceProducedAttachment")
  workspaceCaptureReferences   WorkspaceCaptureReference[]
  scheduledTaskOccurrences     ScheduledTaskOccurrence[]
  browserPushDelivery          BrowserPushDelivery?
  problemReports               AnswerProblemReport[]
  telegramRunLinks             TelegramRunLink[]

  @@unique([userId, id])
  @@unique([chatId, id], map: "ModelRun_chatId_id_key")
  @@unique([userId, chatId, id])
  /// Built concurrently in its own migration (`20261029230500_model_run_subagent_turn_index`).
  @@unique([userId, chatId, subagentThreadId, subagentTurnId], map: "ModelRun_subagentTurn_key")
  @@index([assistantId, createdAt])
  @@index([assistantMessageId])
  @@index([chatId, createdAt])
  @@index([provider, modelId])
  @@index([status])
  @@index([userId, createdAt])
  @@index([userMessageId])
}

/// Ordered user clarifications of this exact task, independent of message DAG edges.
model RunFollowup {
  id              String   @id @default(uuid())
  chatId          String
  modelRunId      String
  ordinal         Int
  nonce           String   @db.VarChar(128)
  text            String
  authorUserId    String?
  authorName      String   @db.VarChar(256)
  createdAt       DateTime @default(now())
  deliveredAt     DateTime?
  precedingText   String?
  /// Only `user` follow-ups are the user's clarifications; the others are never user speech.
  origin          RunFollowupOrigin @default(user)
  /// The background sub-agent turn a `subagent_callback` reports, and only then (SQL check): the engine renders the
  /// callback from that turn's result.
  subagentTurnId  String?
  modelRun        ModelRun @relation(fields: [chatId, modelRunId], references: [chatId, id], onDelete: Cascade, onUpdate: Restrict)
  author          User?    @relation(fields: [authorUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  subagentTurn    SubagentTurn? @relation(fields: [chatId, subagentTurnId], references: [chatId, id], onDelete: Cascade, onUpdate: Restrict, map: "RunFollowup_subagentTurn_fkey")

  @@unique([modelRunId, ordinal])
  @@unique([modelRunId, nonce])
  @@index([chatId, modelRunId])
  @@index([authorUserId])
  @@index([chatId, subagentTurnId])
}

/// A named sub-agent of a chat (`lib/contracts/subagents.ts`): the identity its turns, transcript items and tool
/// calls share. It belongs to the branch of its anchor, the main-agent run whose `call_subagent` started it: it is
/// visible where that run's answer is on the branch, and a name resolves to the visible thread of that name, so
/// `(chatId, anchorRunId, name)` is unique and two calls of one round that start one name meet one row. Its state
/// on a branch is that of its latest turn whose parent run's answer is on the branch, so editing an earlier message
/// branches its threads too. Deleted with its anchor run, and so with the branch or the chat.
model SubagentThread {
  id              String              @id @default(uuid())
  userId          String
  chatId          String
  anchorRunId     String
  name            String              @db.VarChar(48)
  /// The custom sub-agent it was started as: null for the default sub-agent, and once the definition is deleted,
  /// which `typeName` (kept) tells apart. The migration uses column-scoped SET NULL to clear only this column.
  definitionId    String?
  typeName        String?             @db.VarChar(48)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  chat            Chat                @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  anchorRun       ModelRun            @relation("SubagentThreadAnchor", fields: [userId, chatId, anchorRunId], references: [userId, chatId, id], onDelete: Cascade, onUpdate: Restrict, map: "SubagentThread_anchorRun_fkey")
  definition      SubagentDefinition? @relation(fields: [userId, definitionId], references: [ownerUserId, id], onDelete: SetNull, onUpdate: Restrict, map: "SubagentThread_definition_fkey")
  turns           SubagentTurn[]

  @@unique([chatId, anchorRunId, name])
  @@unique([userId, chatId, id])
  @@index([chatId, createdAt])
  @@index([userId, definitionId])
}

/// One turn of a sub-agent thread: what one `call_subagent` call of a main-agent run (`parentRunId`,
/// `parentToolCallId`) started or continued. A foreground turn runs inside its parent run, whose transcript items and
/// tool calls carry the thread key; a background turn runs as its own `ModelRun` (`ModelRun.subagentTurnId`), whose
/// `main_agent` follow-ups are its mailbox. The binding columns snapshot the resolved model and effort and where
/// each came from, so a continuation keeps a model the call or the type chose. A background turn that ended owes
/// its callback until `callbackRunId` names the main-agent run that received it (a running answer, or the wake-up
/// turn); deleting that run makes it owed again.
model SubagentTurn {
  id                   String                @id @default(uuid())
  userId               String
  chatId               String
  threadId             String
  parentRunId          String
  parentToolCallId     String
  mode                 SubagentTurnMode
  state                SubagentTurnState     @default(running)
  outcome              SubagentOutcome?
  /// A stable code: the reason of a `blocked` outcome, or why the turn failed, stopped or was interrupted.
  reasonCode           String?               @db.VarChar(64)
  /// The bounded `call_subagent` result once the turn ended (`decodeSubagentCallResult`); private to the chat.
  result               Json?
  provider             String
  modelId              String
  providerModelId      String?
  reasoningEffort      String?               @db.VarChar(32)
  modelSource          SubagentBindingSource @default(parent)
  effortSource         SubagentBindingSource @default(parent)
  /// The custom sub-agent revision the turn ran, as a plain value that outlives the definition.
  definitionRevisionId String?
  callbackRunId        String?
  startedAt            DateTime              @default(now())
  endedAt              DateTime?
  updatedAt            DateTime              @updatedAt
  thread               SubagentThread        @relation(fields: [userId, chatId, threadId], references: [userId, chatId, id], onDelete: Cascade, onUpdate: Restrict, map: "SubagentTurn_thread_fkey")
  parentRun            ModelRun              @relation("SubagentTurnParent", fields: [userId, chatId, parentRunId], references: [userId, chatId, id], onDelete: Cascade, onUpdate: Restrict, map: "SubagentTurn_parentRun_fkey")
  parentToolCall       ModelRunToolCall      @relation(fields: [parentRunId, parentToolCallId], references: [modelRunId, id], onDelete: Cascade, onUpdate: Restrict, map: "SubagentTurn_parentToolCall_fkey")
  /// The migration uses column-scoped SET NULL so deleting the receiving run clears only callbackRunId.
  callbackRun          ModelRun?             @relation("SubagentTurnCallback", fields: [chatId, callbackRunId], references: [chatId, id], onDelete: SetNull, onUpdate: Restrict, map: "SubagentTurn_callbackRun_fkey")
  executionRun         ModelRun?             @relation("SubagentTurnExecution")
  followups            RunFollowup[]

  @@unique([parentRunId, parentToolCallId])
  @@unique([userId, chatId, threadId, id])
  @@unique([chatId, id])
  @@index([threadId, startedAt])
  @@index([chatId, state])
  @@index([chatId, callbackRunId])
}

/// A custom sub-agent, one of its owner's resources (like Claude Code's custom agents); its current revision holds
/// what it is. Revisions are append-only, so Undo restores an earlier one as a new revision. Deleting the
/// definition deletes them and clears it from its threads, which keep the type name and their turns' revision ids.
model SubagentDefinition {
  id                String                       @id @default(uuid())
  ownerUserId       String
  /// The current revision's name, unique among the owner's definitions.
  name              String                       @db.VarChar(48)
  currentRevisionId String?                      @unique
  /// Optimistic concurrency token for Studio and agent edits.
  version           Int                          @default(1)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  owner             User                         @relation("SubagentDefinitionOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  /// The composite relation proves the current pointer targets a revision of this definition.
  currentRevision   SubagentDefinitionRevision?  @relation("SubagentDefinitionCurrentRevision", fields: [id, currentRevisionId], references: [definitionId, id], onDelete: NoAction, onUpdate: Restrict, map: "SubagentDefinition_currentRevision_fkey")
  revisions         SubagentDefinitionRevision[] @relation("SubagentDefinitionRevisions")
  threads           SubagentThread[]

  @@unique([ownerUserId, name])
  @@unique([ownerUserId, id])
  @@unique([id, currentRevisionId])
}

/// One immutable revision of a custom sub-agent (`SUBAGENT_DEFINITION_LIMITS` bounds its fields).
model SubagentDefinitionRevision {
  id              String              @id @default(uuid())
  definitionId    String
  revisionNumber  Int
  name            String              @db.VarChar(48)
  description     String
  instructions    String
  /// The catalog model it runs on, as a plain value so removing the model never touches history; null runs on the
  /// parent run's model. Admission resolves it against the user's catalog and refuses it when unavailable.
  providerModelId String?
  /// Null is the model's default effort.
  reasoningEffort String?             @db.VarChar(32)
  /// The tool groups it may use (`SUBAGENT_TOOL_GROUPS`); null is every default sub-agent tool.
  toolGroups      Json?
  createdAt       DateTime            @default(now())
  definition      SubagentDefinition  @relation("SubagentDefinitionRevisions", fields: [definitionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  currentFor      SubagentDefinition? @relation("SubagentDefinitionCurrentRevision")

  @@unique([definitionId, revisionNumber])
  @@unique([definitionId, id])
}

/// One accepted next message waiting for its predecessor to retire Workspace authority.
model WorkspaceFollowup {
  modelRunId            String                 @id
  chatId                String
  predecessorRunId      String
  admissionKey          String                 @unique @db.Char(64)
  state                 WorkspaceFollowupState @default(waiting)
  snapshot              Json?
  admissionResult       Json?
  sourceRevisionAdvance Int                    @default(0)
  deadlineAt            DateTime
  claimToken            String?
  leaseExpiresAt        DateTime?
  errorCode             String?                @db.VarChar(64)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  modelRun              ModelRun               @relation("WaitingWorkspaceRun", fields: [chatId, modelRunId], references: [chatId, id], onDelete: Cascade, onUpdate: Restrict)
  predecessor           ModelRun               @relation("PreviousWorkspaceRun", fields: [chatId, predecessorRunId], references: [chatId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([chatId, modelRunId])
  @@index([state, createdAt])
  @@index([chatId, predecessorRunId])
}

model ModelRunSkillBinding {
  modelRunId String
  skillId    String
  revisionId String
  mode       ModelRunSkillMode @default(pinned)
  alias      String            @default("") @db.VarChar(64)
  modelRunToolCallId String?
  createdAt  DateTime      @default(now())
  modelRun   ModelRun      @relation(fields: [modelRunId], references: [id], onDelete: Cascade)
  revision   SkillRevision @relation(fields: [skillId, revisionId], references: [skillId, id], onDelete: Restrict, onUpdate: Restrict, map: "ModelRunSkillBinding_revision_fkey")
  modelRunToolCall ModelRunToolCall? @relation(fields: [modelRunId, modelRunToolCallId], references: [modelRunId, id], onDelete: NoAction, onUpdate: Restrict)

  @@id([modelRunId, skillId])
  @@unique([modelRunId, revisionId])
  @@unique([modelRunId, alias])
  @@index([modelRunId, modelRunToolCallId])
  @@index([skillId, revisionId])
}

/// One item of a native engine run's provider-neutral transcript, in run order
/// (`sequence`). Items are immutable: a chat's transcript is the items of the
/// native runs on its branch, in message order. A large tool output is bounded
/// here and kept whole as the `ToolObservation` of its call.
model RunTranscriptItem {
  id         String                @id @default(uuid())
  userId     String
  chatId     String
  modelRunId String
  sequence   Int
  kind       RunTranscriptItemKind
  /// The provider call id of a tool call or result, pairing them across runs.
  callId     String?               @db.VarChar(256)
  /// The item's fields as `lib/server/engine/transcriptCodec.ts` writes them.
  body       Json
  /// The sub-agent thread the item belongs to (`SubagentThread.id`); null for the main agent. Each thread of a run
  /// has its own sequence. A plain value: the item goes with its run, and a thread's items live only in runs of its
  /// own branch, which are deleted with it.
  subagentThreadId String?
  /// The thread's turn (`SubagentTurn.id`) that wrote the item, a plain value like the thread key: a thread may run
  /// two turns in one answer, and its sequence continues across them.
  subagentTurnId   String?
  createdAt  DateTime              @default(now())
  modelRun   ModelRun              @relation(fields: [userId, chatId, modelRunId], references: [userId, chatId, id], onDelete: Cascade, onUpdate: Restrict, map: "RunTranscriptItem_modelRun_fkey")

  /// NULLS NOT DISTINCT, so the main agent keeps one sequence per run
  /// (`20261029230200_run_transcript_item_thread_sequence_index`).
  @@unique([modelRunId, subagentThreadId, sequence], map: "RunTranscriptItem_thread_sequence_key")
}

model ModelRunEvent {
  id         String   @id @default(uuid())
  modelRunId String
  sequence   Int
  eventType  String
  payload    Json
  createdAt  DateTime @default(now())
  modelRun   ModelRun @relation(fields: [modelRunId], references: [id], onDelete: Cascade)

  @@unique([modelRunId, sequence])
}

/// Installation-wide MCP policy; one row, id `installation`.
model McpPolicy {
  id                          String   @id
  /// Personal MCP may reach private, CGNAT and host addresses (never AIQSA's own services).
  personalLocalNetworkEnabled Boolean  @default(true)
  version                     Int      @default(1)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model McpServer {
  id                   String               @id @default(uuid())
  namespace            String               @unique
  ownerUserId          String?
  displayName          String
  description          String               @default("")
  enabled              Boolean              @default(false)
  archivedAt           DateTime?
  activeRevisionId     String?              @unique
  legacyToolRecheckPending Boolean           @default(false)
  /// Trusted: a runtime that sees changed tools asks for an automatic Test & Save (operator decision 2026-10-24).
  autoApplyToolUpdates     Boolean              @default(true)
  toolUpdateCheckPending   Boolean              @default(false)
  /// The last request, so a change that persists asks again only after a while.
  toolUpdateCheckRequestedAt DateTime?
  draft                Json                 @default("{}")
  testedDraftHash      String?
  draftTestEvidence    Json?
  sharedConfigEnvelope String?
  sharedConfigVersion  Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  activeRevision       McpRevision?         @relation("ActiveMcpRevision", fields: [activeRevisionId], references: [id], onDelete: SetNull)
  activationJob        McpActivationJob?
  grants               McpGrant[]
  toolAccessPolicies   McpToolAccessPolicy[]
  oauthConnections     McpOAuthConnection[]
  revisions            McpRevision[]        @relation("McpServerRevisions")
  userServers          McpUserServer[]
  toolConsents         McpToolConsent[]
  toolApprovals        McpToolApproval[]
  owner                User?                @relation("McpServerOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([enabled, archivedAt])
  @@index([ownerUserId, enabled, archivedAt])
}

model McpActivationJob {
  id                  String             @id @default(uuid())
  serverId            String             @unique
  draftHash           String
  sharedConfigVersion Int
  validationUserId    String?
  stage               McpActivationStage @default(queued)
  errorCode           String?
  issues              Json?
  leaseId             String?
  requestedAt         DateTime           @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  updatedAt           DateTime           @updatedAt
  server              McpServer          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  validationUser      User?              @relation(fields: [validationUserId], references: [id], onDelete: SetNull)

  @@index([stage, updatedAt])
  @@index([validationUserId])
}

model McpRevision {
  id                 String                 @id @default(uuid())
  serverId           String
  revisionNumber     Int
  configuration      Json
  resolvedArtifact   Json?
  validationEvidence Json
