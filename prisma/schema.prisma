  knowledgeBaseSnapshot        KnowledgeBaseSnapshot?      @relation(fields: [knowledgeBaseId, knowledgeBaseSnapshotId], references: [knowledgeBaseId, id], onDelete: Restrict, onUpdate: Restrict, map: "KnowledgeRunBinding_snapshot_fkey")
