# Runtime-local agent mountpoints are ignored; repository instructions use AGENTS.md only.
.codex
.agents/

node_modules/
.next/
.aiqsa/
tsconfig.tsbuildinfo
coverage/
playwright-report/
test-results/
# Queued, parked, and completed task instances are local-only; directory contracts remain tracked.
/agent_docs/tasks/queue/*.md
!/agent_docs/tasks/queue/README.md
/agent_docs/tasks/archive/*
!/agent_docs/tasks/archive/README.md
/agent_docs/tasks/drafts/*
!/agent_docs/tasks/drafts/README.md
# Keep pre-migration local task state private until its checkout owner moves it.
/agent_docs/tasks/*.md
!/agent_docs/tasks/README.md
/agent_docs/task_archive/*
/agent_docs/backlog/**

.env
.env.*
!.env.example

/DEPLOY.md
/GITHUB_RELEASE.md
/ops/deploy/
/sa.json
/sa.json:Zone.Identifier
# Operator-local reference material outside the task namespace.
/agent_docs/PRD/**
