{
  "version": 1,
  "about": "Past-chat search scenarios over corpus.json. A chat is named by its key within the scenario's user, or as user/chat for another user's. expect.chat must appear within maxRank (default 3; turn narrows it to that turn's result); expect.never lists chats that must never appear; expect.recent checks the listing against the corpus's own order. Every scenario also checks that no result is another user's, an ineligible or the current chat.",
  "scenarios": [
    { "id": "exact-ops-4821", "class": "exact_identifier", "user": "alice", "query": "OPS-4821 выгрузка CRM 502",
      "expect": { "chat": "ops-ticket", "turn": "t0", "maxRank": 1 } },
    { "id": "exact-ops-4812", "class": "exact_identifier", "user": "alice", "query": "OPS-4812",
      "expect": { "chat": "ops-ticket-similar", "maxRank": 1 } },
    { "id": "exact-cmp-0417", "class": "exact_identifier", "user": "alice", "query": "CMP-0417_vk_1080x1080 креатив",
      "expect": { "chat": "naming-rule", "maxRank": 1 } },
    { "id": "exact-invoice", "class": "exact_identifier", "user": "alice", "query": "INV-2026-118 Orbita Retail",
      "expect": { "chat": "invoice", "maxRank": 1 } },
    { "id": "exact-file-name", "class": "exact_identifier", "user": "alice", "query": "otchet_prodazhi_w46.xlsx",
      "expect": { "chat": "report-w46", "maxRank": 1 } },
    { "id": "exact-dlq", "class": "exact_identifier", "user": "alice", "query": "warehouse-dlq",
      "expect": { "chat": "long-warehouse", "maxRank": 1 } },
    { "id": "exact-boris-ops", "class": "exact_identifier", "user": "boris", "query": "OPS-4821 разбор инцидента",
      "expect": { "chat": "ops-ticket-boris", "maxRank": 1 } },

    { "id": "paraphrase-rate", "class": "paraphrase", "user": "alice", "query": "почасовая стоимость иллюстратора",
      "expect": { "chat": "rate-card" } },
    { "id": "paraphrase-winback", "class": "paraphrase", "user": "alice", "query": "letter to bring back inactive merchants",
      "expect": { "chat": "winback-email" } },
    { "id": "paraphrase-kazan", "class": "paraphrase", "user": "alice", "query": "где я жила в поездке в столицу Татарстана",
      "expect": { "chat": "kazan-trip" } },

    { "id": "cross-rate-en", "class": "cross_language", "user": "alice", "query": "hourly design rate for the commercial proposal",
      "expect": { "chat": "rate-card" } },
    { "id": "cross-naming-en", "class": "cross_language", "user": "alice", "query": "naming convention for campaign creative files",
      "expect": { "chat": "naming-rule" } },
    { "id": "cross-k8s-ru", "class": "cross_language", "user": "alice", "query": "сервис платежей падает после изменения конфигурации",
      "expect": { "chat": "k8s-restart" } },
    { "id": "cross-cohort-en", "class": "cross_language", "user": "alice", "query": "monthly signup cohort retention",
      "expect": { "chat": "cohort-sql" } },
    { "id": "cross-vera-ab", "class": "cross_language", "user": "vera", "query": "значимость теста кнопки оформления заказа",
      "expect": { "chat": "ab-test", "maxRank": 1 } },
    { "id": "cross-vera-standup", "class": "cross_language", "user": "vera", "query": "шаблон заметок для ежедневной планёрки",
      "expect": { "chat": "standup-template", "maxRank": 1 } },

    { "id": "similar-onboarding", "class": "similar_chats", "user": "alice", "query": "welcome email template new sellers onboarding steps payout",
      "expect": { "chat": "onboarding-email", "maxRank": 1 } },
    { "id": "similar-partner-tariff", "class": "similar_chats", "user": "alice", "query": "шаблон письма партнёрам новый тариф декабрь",
      "expect": { "chat": "partner-email-ru", "maxRank": 1 } },
    { "id": "similar-report-books", "class": "similar_chats", "user": "alice", "query": "отчёт по продажам, где выросла категория книги",
      "expect": { "chat": "report-w42", "maxRank": 1 } },
    { "id": "similar-webhook", "class": "similar_chats", "user": "alice", "query": "вебхук оплаты задержка pending",
      "expect": { "chat": "ops-ticket-similar", "maxRank": 1 } },

    { "id": "long-retries", "class": "long_answer_detail", "user": "alice", "query": "сколько попыток повторной доставки и какая пауза в очереди складских событий",
      "expect": { "chat": "long-warehouse", "turn": "t0", "excerptIncludes": ["45 секунд"] } },
    { "id": "long-alert", "class": "long_answer_detail", "user": "alice", "query": "порог алерта дежурному по мёртвым письмам склада",
      "expect": { "chat": "long-warehouse", "turn": "t0", "excerptIncludes": ["50 сообщений"] } },

    { "id": "fresh-post", "class": "fresh", "user": "alice", "query": "пост запуск Ventra API v2 лимиты вебхуки",
      "expect": { "chat": "fresh-post", "maxRank": 1 } },
    { "id": "fresh-meeting", "class": "fresh", "user": "alice", "query": "заметки встреча подрядчик доставка сроки",
      "expect": { "chat": "meeting-notes", "maxRank": 1 } },

    { "id": "date-w46", "class": "date_bounded", "user": "alice", "query": "отчёт по продажам выручка средний чек",
      "after": { "daysAgo": 11 }, "before": { "daysAgo": 9 },
      "expect": { "chat": "report-w46", "maxRank": 1, "never": ["report-w42"] } },
    { "id": "date-w42", "class": "date_bounded", "user": "alice", "query": "отчёт по продажам выручка средний чек",
      "after": { "daysAgo": 40 }, "before": { "daysAgo": 36 },
      "expect": { "chat": "report-w42", "maxRank": 1, "never": ["report-w46"] } },
    { "id": "date-email", "class": "date_bounded", "user": "alice", "query": "email template",
      "after": { "daysAgo": 15 }, "before": { "daysAgo": 13 },
      "expect": { "chat": "onboarding-email", "maxRank": 1, "never": ["winback-email"] } },

    { "id": "recent-alice", "class": "recent_listing", "user": "alice", "limit": 5,
      "expect": { "recent": true } },
    { "id": "recent-alice-week", "class": "recent_listing", "user": "alice", "after": { "daysAgo": 6 }, "limit": 20,
      "expect": { "recent": true } },
    { "id": "recent-boris", "class": "recent_listing", "user": "boris", "limit": 3,
      "expect": { "recent": true } },

    { "id": "read-venue", "class": "read_to_message", "user": "alice", "query": "коворкинг Маяк зал вместимость",
      "expect": { "chat": "read-workshop", "turn": "t3", "read": { "turn": "t3", "role": "assistant", "includes": "зал 3" } } },
    { "id": "read-idempotency", "class": "read_to_message", "user": "alice", "query": "409 повторная отправка ключ идемпотентности",
      "expect": { "chat": "ops-ticket", "turn": "t1", "read": { "turn": "t1", "role": "assistant", "includes": "24 часа" } } },

    { "id": "edited-current", "class": "edited_branch", "user": "alice", "query": "тарифы хостинга Нимбус",
      "expect": { "chat": "edited-hosting", "turn": "t0", "maxRank": 1, "excerptIncludes": ["Нимбус"], "excerptsExclude": ["Стратус"] } },
    { "id": "edited-old-text", "class": "edited_branch", "user": "alice", "query": "Стратус хостинг без бэкапов",
      "expect": { "excerptsExclude": ["Стратус", "1 700"] } },

    { "id": "never-excluded", "class": "never_returned", "user": "alice", "query": "запись к стоматологу паспорт полис",
      "expect": { "never": ["excluded-dentist"] } },
    { "id": "never-temporary", "class": "never_returned", "user": "alice", "query": "идеи подарка коллеге на день рождения",
      "expect": { "never": ["temporary-gift"] } },
    { "id": "never-deleted", "class": "never_returned", "user": "alice", "query": "пункт 4.2 договора Таймыр Логистик штраф",
      "expect": { "never": ["deleted-contract", "boris/taymyr-supply"] } },
    { "id": "never-excluded-later", "class": "never_returned", "user": "alice", "query": "бюджет новогоднего корпоратива банкетный зал",
      "expect": { "never": ["excluded-later-party", "boris/budget-boris"] } },
    { "id": "never-foreign", "class": "never_returned", "user": "alice", "query": "OPS-4821 разбор инцидента хронология",
      "expect": { "never": ["boris/ops-ticket-boris"] } },
    { "id": "never-foreign-release", "class": "never_returned", "user": "alice", "query": "Ventra API v2 release notes rate limit",
      "expect": { "never": ["boris/release-notes"] } },
    { "id": "never-current", "class": "never_returned", "user": "alice", "query": "OPS-4821", "currentChat": "ops-ticket",
      "expect": { "never": ["ops-ticket"] } },
    { "id": "never-recent", "class": "never_returned", "user": "alice", "limit": 20,
      "expect": { "never": ["excluded-dentist", "temporary-gift", "deleted-contract", "excluded-later-party"] } }
  ]
}
