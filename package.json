{
  "name": "aiqsa",
  "version": "0.1.25",
  "private": true,
  "description": "Self-hosted multi-user AI workspace with multi-provider chat, MCP tools, and web search.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/insciqq/AIQSA.git"
  },
  "engines": {
    "node": ">=22.13 <23 || >=24 <25",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "benchmark:knowledge-ocr": "tsx scripts/benchmark-knowledge-ocr.ts",
    "check": "prisma generate && npm run docs:check && npm run lint && tsc --noEmit && vitest run --config vitest.full.config.ts",
    "check:container": "AIQSA_APP_MEMORY_LIMIT=2g AIQSA_APP_CPU_LIMIT=2 docker compose -f docker-compose.dev.yml run --rm -T --no-deps --name aiqsa-dev-check -e NODE_OPTIONS=--max-old-space-size=1536 app npm run check:container:inner",
    "check:container:inner": "prisma generate && prisma migrate deploy && npm run docs:check && vitest run --config vitest.full.config.ts --maxWorkers=1",
    "check:hermetic": "prisma generate && npm run docs:check && npm run lint && tsc --noEmit && vitest run --config vitest.hermetic.config.ts",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:generate": "node scripts/generate-doc-reference.mjs",
    "docs:generated:check": "node scripts/generate-doc-reference.mjs --check",
    "release:privacy:check": "node scripts/release-privacy-check.mjs --require-origin",
    "db:generate": "prisma generate",
    "db:bootstrap": "tsx prisma/bootstrap.ts",
    "db:auth-rate-limit:migration:contract": "tsx prisma/scripts/tests/auth-rate-limit-migration-contract.ts",
    "db:attachment-processing:migration:contract": "tsx prisma/scripts/tests/attachment-processing-migration-contract.ts",
    "db:control-plane:migration:contract": "tsx prisma/scripts/tests/control-plane-cutover-contract.ts",
    "db:document-processing-fairness:migration:contract": "tsx prisma/scripts/tests/document-processing-fairness-migration-contract.ts",
    "db:full-access:migration:contract": "tsx prisma/scripts/tests/full-access-system-group-migration-contract.ts",
    "db:gemini:migration:contract": "tsx prisma/scripts/tests/native-gemini-interactions-migration-contract.ts",
    "db:knowledge:migration:contract": "tsx prisma/scripts/tests/knowledge-base-foundation-migration-contract.ts",
    "db:knowledge-ingestion:migration:contract": "tsx prisma/scripts/tests/knowledge-ingestion-migration-contract.ts",
    "db:knowledge-run:migration:contract": "tsx prisma/scripts/tests/knowledge-run-plan-migration-contract.ts",
    "db:knowledge-policy:migration:contract": "tsx prisma/scripts/tests/knowledge-policy-migration-contract.ts",
    "db:memory:migration:contract": "tsx prisma/scripts/tests/memory-foundation-migration-contract.ts",
    "db:provider:migration:contract": "tsx prisma/scripts/tests/provider-control-plane-migration-contract.ts",
    "db:cutover": "tsx prisma/scripts/control-plane-cutover.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:resolve": "prisma migrate resolve",
    "db:integrity:smoke": "prisma generate && tsx prisma/schema-integrity-smoke.ts",
    "db:migration:contract": "tsx prisma/scripts/tests/schema-integrity-migration-contract.ts",
    "db:retention:migration:contract": "tsx prisma/scripts/tests/attachment-retention-migration-contract.ts",
    "db:search:migration:contract": "tsx prisma/scripts/tests/search-control-plane-migration-contract.ts",
    "db:assistants:migration:contract": "tsx prisma/scripts/tests/reusable-assistants-migration-contract.ts",
    "db:seed": "prisma generate && prisma db seed",
    "db:seed:smoke": "prisma generate && tsx prisma/seed-smoke.ts",
    "db:test:bootstrap": "npm run db:migrate:deploy && npm run db:seed",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "memory:coordinator": "tsx scripts/memory-coordinator.ts",
    "memory:learning:evaluate": "AIQSA_APP_MEMORY_LIMIT=2g AIQSA_APP_CPU_LIMIT=2 docker compose -f docker-compose.dev.yml run --rm -T --no-deps -e NODE_OPTIONS=--max-old-space-size=1536 app npx tsx scripts/memory-learning-beta-evaluation.ts",
    "memory:phase7:ablation:evaluate": "AIQSA_APP_MEMORY_LIMIT=2g AIQSA_APP_CPU_LIMIT=2 docker compose -f docker-compose.dev.yml run --rm -T --no-deps -e NODE_OPTIONS=--max-old-space-size=1536 app npx tsx scripts/memory-phase7-ablation-evaluation.ts",
    "memory:phase7:hindsight:evaluate": "NODE_OPTIONS=--max-old-space-size=1024 npx tsx scripts/memory-phase7-hindsight-orchestrator.ts",
    "memory:phase7:profile:evaluate": "AIQSA_APP_MEMORY_LIMIT=2g AIQSA_APP_CPU_LIMIT=2 docker compose -f docker-compose.dev.yml run --rm -T --no-deps -e NODE_OPTIONS=--max-old-space-size=1536 app npx tsx scripts/memory-phase7-profile-evaluation.ts",
    "memory:qualification:build": "AIQSA_APP_MEMORY_LIMIT=512m AIQSA_APP_CPU_LIMIT=1 docker compose -f docker-compose.dev.yml run --rm -T --no-deps -e NODE_OPTIONS=--max-old-space-size=384 app npx tsx scripts/build-memory-qualification-registry.ts",
    "memory:restore:reconcile": "tsx scripts/memory-restore-reconcile.ts",
    "memory:suppression:preflight": "tsx scripts/memory-suppression-preflight.ts",
    "mcp:cleanup": "tsx scripts/mcp-toolhive-cleanup.ts",
    "prune": "tsx scripts/prune.ts",
    "security:deps": "npm audit --audit-level=high",
    "smoke:anthropic": "tsx scripts/smoke-anthropic-messages.ts",
    "smoke:custom-openai-compatible": "tsx scripts/smoke-custom-openai-compatible.ts",
    "smoke:openai": "tsx scripts/smoke-openai-responses.ts",
    "smoke:gemini": "tsx scripts/smoke-gemini-interactions.ts",
    "smoke:memory-semantic": "tsx scripts/smoke-memory-semantic-retrieval.ts",
    "smoke:openrouter": "tsx scripts/smoke-openrouter-perplexity.ts",
    "smoke:nginx-upload-envelope": "node scripts/smoke-nginx-upload-envelope.mjs",
    "smoke:parsers": "tsx scripts/smoke-parser-sidecars.ts",
    "pretest": "prisma generate",
    "preprune": "prisma generate",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:backup-restore": "AIQSA_RUN_BACKUP_RESTORE_TEST=1 bash scripts/test-backup-restore-reconciliation.sh",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "task:new": "node scripts/task-ledger.mjs new",
    "task:promote": "node scripts/task-ledger.mjs promote",
    "task:park": "node scripts/task-ledger.mjs park",
    "task:restore": "node scripts/task-ledger.mjs restore",
    "task:complete": "node scripts/task-ledger.mjs complete"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@prisma/client": "^6.19.3",
    "jose": "6.2.3",
    "katex": "0.18.1",
    "lucide-react": "0.468.0",
    "next": "16.2.11",
    "parse5": "7.3.0",
    "react": "19",
    "react-dom": "19",
    "semver": "7.8.5",
    "shiki": "^4.2.0",
    "unpdf": "^1.6.2",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "^22.12.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/semver": "7.7.1",
    "autoprefixer": "10.4.20",
    "eslint": "9",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "postcss": "8.5.25",
    "prisma": "^6.19.3",
    "sharp": "0.35.3",
    "tailwindcss": "3.4.17",
    "tsx": "^4.22.4",
    "typescript": "5.7.2",
    "vitest": "4.1.8"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "nanoid": "3.3.17",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
