    { "name": "a public second level", "input": "shop.example.co.uk", "host": "shop.example.co.uk", "site": "example.co.uk" },
    { "name": "a public second level of a zone", "input": "www.example.com.kz", "host": "www.example.com.kz", "site": "example.com.kz" },
