    { "name": "com under a long zone is an ordinary label", "input": "a.com.example", "host": "a.com.example", "site": "com.example" },
    { "name": "a public second level on its own", "input": "co.uk", "host": "co.uk", "site": "co.uk" },
    { "name": "an underscore", "input": "my_shop.example.kz", "host": "my_shop.example.kz", "site": "example.kz" },
    { "name": "a single label", "input": "localhost", "host": null },
    { "name": "a zone alone", "input": "kz", "host": null },
    { "name": "an IPv4 address", "input": "93.184.216.34", "host": null },
    { "name": "an IPv6 address", "input": "[2606:4700::1]", "host": null },
    { "name": "a host with a port", "input": "ozon.ru:443", "host": null },
    { "name": "empty", "input": "", "host": null }
  ],
  "selection": [
    {
      "name": "no proxies goes direct",
      "proxies": [],
      "steps": [
        { "op": "select", "host": "ozon.ru", "expect": { "kind": "direct", "reason": "no_match" } }
      ]
    },
    {
      "name": "a hint matches its zone and its domain with subdomains, at label boundaries only",
      "proxies": [
        { "id": "kz", "name": "KZ", "owner": "personal", "active": true, "domainHints": [".kz"] },
        { "id": "ozon", "name": "Ozon", "owner": "personal", "active": true, "domainHints": ["ozon.ru"] }
      ],
      "steps": [
        { "op": "select", "host": "kaspi.kz", "expect": { "kind": "proxy", "proxyId": "kz", "reason": "hint", "hint": ".kz" } },
