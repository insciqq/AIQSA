        { "op": "select", "host": "www.ozon.ru", "expect": { "kind": "proxy", "proxyId": "ozon", "reason": "site", "hint": "ozon.ru" } },
        { "op": "select", "host": "notozon.ru", "expect": { "kind": "direct", "reason": "no_match" } },
        { "op": "select", "host": "ozon.ru.evil.example", "expect": { "kind": "direct", "reason": "no_match" } },
        { "op": "select", "host": "example.kzz", "expect": { "kind": "direct", "reason": "no_match" } },
        { "op": "select", "host": "kz", "expect": { "kind": "direct", "reason": "no_match" } },
        { "op": "select", "host": "93.184.216.34", "expect": { "kind": "direct", "reason": "no_match" } }
