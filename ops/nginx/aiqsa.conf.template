# Install `aiqsa-http-limits.conf` in the Nginx `http` context, then render the
# two __AIQSA_*__ placeholders before enabling this site.
# Keep the upstream bound to loopback; expose only Nginx to the Internet.
log_format aiqsa_json escape=json
    '{"time":"$time_iso8601","request_id":"$request_id",'
    '"method":"$request_method","status":$status,'
    '"request_time":$request_time,"upstream_time":"$upstream_response_time"}';

server {
    listen 80;
    listen [::]:80;
    server_name __AIQSA_DOMAIN__;
    server_tokens off;

    # Ordinary JSON routes are application-bounded to 1 MiB by default.
    client_max_body_size 2m;
    error_page 413 = @aiqsa_request_body_too_large;
    access_log /var/log/nginx/aiqsa-access.log aiqsa_json;
    add_header X-Request-ID $request_id always;

    location = /api/uploads {
        # AIQSA accepts files up to 25,000,000 bytes by default. Leave
        # multipart headroom and keep this above the application envelope.
        client_max_body_size 32m;
        limit_conn aiqsa_upload_per_client 4;
        limit_conn_status 429;
        error_page 413 = @aiqsa_file_too_large;
        error_page 429 = @aiqsa_upload_busy;

        proxy_pass http://127.0.0.1:__AIQSA_LOOPBACK_PORT__;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Request-ID $request_id;

        # Security boundary: overwrite untrusted client forwarding headers.
        # Do not replace this with $proxy_add_x_forwarded_for.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP "";

        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_hide_header X-Powered-By;
        gzip off;
        proxy_read_timeout 720s;
        proxy_send_timeout 720s;
    }

    location @aiqsa_request_body_too_large {
        default_type application/json;
        return 413 '{"error":"request_body_too_large"}';
    }

    location @aiqsa_file_too_large {
        default_type application/json;
        return 413 '{"error":"file_too_large"}';
    }

    location @aiqsa_upload_busy {
        default_type application/json;
        add_header X-Request-ID $request_id always;
        add_header Retry-After 1 always;
        return 429 '{"error":"upload_busy"}';
    }

    location / {
        proxy_pass http://127.0.0.1:__AIQSA_LOOPBACK_PORT__;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Request-ID $request_id;

        # Security boundary: overwrite untrusted client forwarding headers.
        # Do not replace this with $proxy_add_x_forwarded_for.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP "";

        # Preserve long AIQSA SSE/background runs without response buffering.
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_hide_header X-Powered-By;
        gzip off;
        proxy_read_timeout 720s;
        proxy_send_timeout 720s;
    }
}
