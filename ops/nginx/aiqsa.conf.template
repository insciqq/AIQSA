# Install `aiqsa-http-limits.conf` in the Nginx `http` context, then render the
# two __AIQSA_*__ placeholders before enabling this site.
# Keep the upstream bound to loopback; expose only Nginx to the Internet.
log_format aiqsa_json escape=json
    '{"time":"$time_iso8601","request_id":"$request_id",'
    '"method":"$request_method","status":$status,'
    '"request_time":$request_time,"upstream_time":"$upstream_response_time"}';

server {
    listen 80;
    listen [::]:80;
    server_name __AIQSA_DOMAIN__;
    server_tokens off;

    # Ordinary JSON routes are application-bounded to 1 MiB by default.
    client_max_body_size 2m;
    error_page 413 = @aiqsa_request_body_too_large;
    access_log /var/log/nginx/aiqsa-access.log aiqsa_json;
    add_header X-Request-ID $request_id always;

    # Route only the canonical Source replacement and proxy-upload content
    # shapes before Nginx performs location lookup and its declared
    # Content-Length check. Query arguments remain attached to the internal
    # redirect, and the method is unchanged.
    if ($request_method = POST) {
        rewrite ^(/api/me/knowledge-sources/[^/]+/versions)$ /__aiqsa_internal_knowledge_upload$1 last;
    }
    if ($request_method = PUT) {
        rewrite ^(/api/me/knowledge-bases/[^/]+/upload-batches/[^/]+/items/[^/]+/content)$ /__aiqsa_internal_knowledge_upload$1 last;
    }

    location = /api/uploads {
        # AIQSA accepts files up to 25,000,000 bytes by default. Leave
        # multipart headroom and keep this above the application envelope.
        client_max_body_size 32m;
        limit_conn aiqsa_upload_per_client 4;
        limit_conn_status 429;
        error_page 413 = @aiqsa_file_too_large;
        error_page 429 = @aiqsa_upload_busy;

        proxy_pass http://127.0.0.1:__AIQSA_LOOPBACK_PORT__;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Request-ID $request_id;

        # Security boundary: overwrite untrusted client forwarding headers.
        # Do not replace this with $proxy_add_x_forwarded_for.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP "";

        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_hide_header X-Powered-By;
        gzip off;
        proxy_read_timeout 720s;
        proxy_send_timeout 720s;
    }

    location ~ ^/__aiqsa_internal_knowledge_upload(/api/me/(?:knowledge-sources/[^/]+/versions|knowledge-bases/[^/]+/upload-batches/[^/]+/items/[^/]+/content))$ {
        # This location is reachable only through the exact server-rewrite
        # producer above. Direct client requests to the internal namespace are
        # rejected by Nginx, and requests with any other method retain the
        # ordinary 2 MiB server envelope during their own location lookup.
        internal;

        # 80 MiB covers the 64 MiB application hard ceiling plus multipart
        # framing. AIQSA's configured 50,000,000-byte default remains the
        # authoritative product limit.
        client_max_body_size 80m;
        limit_conn aiqsa_upload_per_client 4;
        limit_conn_status 429;
        error_page 413 = @aiqsa_file_too_large;
        error_page 429 = @aiqsa_upload_busy;

        # Restore the public route without changing its method or query before
        # proxy_pass forwards the normalized URI to the loopback application.
        rewrite ^/__aiqsa_internal_knowledge_upload(/.*)$ $1 break;
        proxy_pass http://127.0.0.1:__AIQSA_LOOPBACK_PORT__;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Request-ID $request_id;

        # Security boundary: overwrite untrusted client forwarding headers.
        # Do not replace this with $proxy_add_x_forwarded_for.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP "";

        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_hide_header X-Powered-By;
        gzip off;
        proxy_read_timeout 720s;
        proxy_send_timeout 720s;
    }

    location @aiqsa_request_body_too_large {
        default_type application/json;
        return 413 '{"error":"request_body_too_large"}';
    }

    location @aiqsa_file_too_large {
        default_type application/json;
        return 413 '{"error":"file_too_large"}';
    }

    location @aiqsa_upload_busy {
        default_type application/json;
        add_header X-Request-ID $request_id always;
        add_header Retry-After 1 always;
        return 429 '{"error":"upload_busy"}';
    }

    location / {
        proxy_pass http://127.0.0.1:__AIQSA_LOOPBACK_PORT__;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Request-ID $request_id;

        # Security boundary: overwrite untrusted client forwarding headers.
        # Do not replace this with $proxy_add_x_forwarded_for.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP "";

        # Preserve long AIQSA SSE/background runs without response buffering.
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_hide_header X-Powered-By;
        gzip off;
        proxy_read_timeout 720s;
        proxy_send_timeout 720s;
    }
}
