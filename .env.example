DATABASE_URL=postgresql://aiqsa:aiqsa@postgres:5432/aiqsa?schema=public
AIQSA_PROD_POSTGRES_DB=aiqsa_prod
AIQSA_PROD_POSTGRES_USER=aiqsa_prod
AIQSA_PROD_POSTGRES_PASSWORD=replace-with-prod-postgres-password
AIQSA_PROD_DATABASE_URL=postgresql://aiqsa_prod:replace-with-prod-postgres-password@postgres-prod:5432/aiqsa_prod?schema=public&connect_timeout=5

# Required for the first production bootstrap. Remove only the password after
# the first successful run; the exact identity fields remain the adoption key.
AIQSA_INITIAL_ADMIN_EMAIL=
AIQSA_INITIAL_ADMIN_DISPLAY_NAME=Initial Administrator
AIQSA_INITIAL_ADMIN_USER_ID=
AIQSA_INITIAL_ADMIN_PASSWORD=

# Production Compose image, loopback exposure, resource, and log bounds.
AIQSA_APP_IMAGE=aiqsa-app:local
AIQSA_TOOLS_IMAGE=aiqsa-tools:local
AIQSA_APP_REVISION=
AIQSA_PROD_BIND_ADDRESS=127.0.0.1
AIQSA_PROD_APP_PORT=3100
AIQSA_PROD_APP_CPU_LIMIT=2.0
AIQSA_PROD_APP_MEMORY_LIMIT=2g
AIQSA_PROD_TOOLS_CPU_LIMIT=1.0
AIQSA_PROD_TOOLS_MEMORY_LIMIT=1g
AIQSA_PROD_POSTGRES_CPU_LIMIT=1.0
AIQSA_PROD_POSTGRES_MEMORY_LIMIT=1g
AIQSA_PROD_MINIO_CPU_LIMIT=1.0
AIQSA_PROD_MINIO_MEMORY_LIMIT=1g
AIQSA_PROD_LOG_MAX_FILES=5
AIQSA_PROD_LOG_MAX_SIZE=10m

# Generate secrets with:
#   openssl rand -hex 32
AUTH_SESSION_SECRET=replace-with-local-random-secret
AIQSA_BOOTSTRAP_AUTH_TOKEN=replace-with-local-bootstrap-token

# Optional: store only the SHA-256 hash of the bootstrap token.
#   printf '%s' "$AIQSA_BOOTSTRAP_AUTH_TOKEN" | sha256sum
AIQSA_BOOTSTRAP_AUTH_TOKEN_SHA256=
# Disabled by default. Set to 1 only for temporary admin recovery.
AIQSA_BOOTSTRAP_LOGIN_ENABLED=
AIQSA_BOOTSTRAP_USER_ID=00000000-0000-4000-8000-000000000001
APP_ENV=local
AIQSA_APP_BASE_URL=http://localhost:3000
# Local Compose publishes app/Postgres/MinIO on loopback by default. Use an
# explicit non-loopback address only on a trusted development network.
AIQSA_DEV_BIND_ADDRESS=127.0.0.1
AIQSA_COOKIE_SECURE=
AIQSA_GOOGLE_OAUTH_CLIENT_ID=
AIQSA_GOOGLE_OAUTH_CLIENT_SECRET=
AIQSA_YANDEX_OAUTH_CLIENT_ID=
AIQSA_YANDEX_OAUTH_CLIENT_SECRET=
AIQSA_TRUST_PROXY_HEADERS=
AIQSA_TRUSTED_PROXY_COUNT=
AIQSA_SMTP_HOST=
AIQSA_SMTP_PORT=587
AIQSA_SMTP_USER=
AIQSA_SMTP_PASSWORD=
AIQSA_SMTP_FROM=
AIQSA_SMTP_SECURE=0
AIQSA_SMTP_STARTTLS=1
AIQSA_SMTP_CONNECT_TIMEOUT_MS=10000
AIQSA_SMTP_COMMAND_TIMEOUT_MS=15000
AIQSA_SMTP_TOTAL_TIMEOUT_MS=60000
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=AIQSA
AIQSA_DEFAULT_MODEL=gpt-5.5
AIQSA_DEFAULT_SEARCH_MODEL=perplexity/sonar-pro-search
AIQSA_PROVIDER_RESPONSE_MAX_BYTES=16777216
AIQSA_PROVIDER_TIMEOUT_MS=30000
AIQSA_PROVIDER_STREAM_IDLE_TIMEOUT_MS=30000
AIQSA_OPENAI_BACKGROUND_POLL_TIMEOUT_MS=660000
AIQSA_FAKE_PROVIDER=
AIQSA_FAKE_PROVIDER_TOKEN_DELAY_MS=
AIQSA_SHOW_FAKE_PROVIDER=
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=aiqsa-uploads
S3_ACCESS_KEY_ID=aiqsa
S3_SECRET_ACCESS_KEY=aiqsa-local-password
AIQSA_PROD_S3_ENDPOINT=http://minio-prod:9000
AIQSA_PROD_S3_REGION=us-east-1
AIQSA_PROD_S3_BUCKET=aiqsa-prod-uploads
AIQSA_PROD_S3_ACCESS_KEY_ID=replace-with-prod-minio-user
AIQSA_PROD_S3_SECRET_ACCESS_KEY=replace-with-prod-minio-password
UPLOAD_MAX_BYTES=25000000
AIQSA_UPLOAD_STORAGE_DIR=.aiqsa/uploads
