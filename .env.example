# Optional local development overrides for docker-compose.dev.yml.
# The Compose file supplies disposable credentials and defaults without .env.
# Copy this file to an ignored .env only to customize your local stand.
# Existing .aiqsa/local-dev-profile/ settings and credentials are local state.
# Never reuse the public development credentials for a persistent installation.

AIQSA_APP_BASE_URL=http://localhost:3000
AIQSA_PORT=3000
AIQSA_APP_MEMORY_LIMIT=3g
AIQSA_APP_CPU_LIMIT=4

# Choose unique ports and non-overlapping subnets for parallel local stands.
AIQSA_DEV_POSTGRES_PORT=5432
AIQSA_DEV_MINIO_PORT=9000
AIQSA_DEV_MINIO_CONSOLE_PORT=9001
AIQSA_DEV_OPENSEARCH_PORT=19200
AIQSA_DEV_DEFAULT_NETWORK_SUBNET=192.168.72.0/24
AIQSA_DEV_MCP_NETWORK_SUBNET=192.168.73.0/24
AIQSA_DEV_PARSER_NETWORK_SUBNET=192.168.74.0/24
AIQSA_DEV_SEARCH_NETWORK_SUBNET=192.168.64.0/24
AIQSA_DEV_SEARCH_DIAGNOSTIC_NETWORK_SUBNET=192.168.66.0/24
AIQSA_DEV_WORKSPACE_CONTROL_NETWORK_SUBNET=192.168.67.0/24
AIQSA_DEV_WORKSPACE_EGRESS_NETWORK_SUBNET=192.168.68.0/24
