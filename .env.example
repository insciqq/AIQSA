# AIQSA configuration
#
# Copy this file to .env. Fill every value marked REQUIRED before the first
# `docker compose up -d --build`. Blank optional values disable that feature.

# -----------------------------------------------------------------------------
# REQUIRED: application and initial administrator
# -----------------------------------------------------------------------------

# Generate with: openssl rand -hex 32
# REQUIRED: replace this placeholder.
AIQSA_AUTH_SESSION_SECRET=replace-with-random-session-secret

# Generate with: openssl rand -base64 32
# REQUIRED for encrypted MCP shared values, user values, and OAuth tokens.
AIQSA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# REQUIRED: replace this placeholder. The password is also required on first start.
AIQSA_INITIAL_ADMIN_EMAIL=replace-with-admin-email
AIQSA_INITIAL_ADMIN_PASSWORD=

# Optional identity details. Leave USER_ID blank to generate one on first start.
AIQSA_INITIAL_ADMIN_DISPLAY_NAME=Administrator
AIQSA_INITIAL_ADMIN_USER_ID=

# -----------------------------------------------------------------------------
# REQUIRED: bundled PostgreSQL and private object storage
# -----------------------------------------------------------------------------

AIQSA_POSTGRES_DB=aiqsa
AIQSA_POSTGRES_USER=aiqsa
# Generate a URI-safe value with: openssl rand -hex 32
AIQSA_POSTGRES_PASSWORD=replace-with-random-postgres-password

AIQSA_S3_ENDPOINT=http://minio:9000
AIQSA_S3_REGION=us-east-1
AIQSA_S3_BUCKET=aiqsa-uploads
AIQSA_S3_ACCESS_KEY_ID=aiqsa
# Generate with: openssl rand -hex 32
AIQSA_S3_SECRET_ACCESS_KEY=replace-with-random-object-storage-secret

# -----------------------------------------------------------------------------
# REQUIRED: configure at least one AI provider
# -----------------------------------------------------------------------------

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Local address and browser security
# -----------------------------------------------------------------------------

AIQSA_APP_BASE_URL=http://localhost:3000
AIQSA_BIND_ADDRESS=127.0.0.1
AIQSA_PORT=3000

# Blank derives the setting from AIQSA_APP_BASE_URL. Set to 1 behind HTTPS or
# to 0 only for an intentional HTTP installation.
AIQSA_COOKIE_SECURE=

# -----------------------------------------------------------------------------
# Optional provider endpoint overrides
# -----------------------------------------------------------------------------

OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
OPENROUTER_BASE_URL=
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=AIQSA

# -----------------------------------------------------------------------------
# Optional email (SMTP)
# -----------------------------------------------------------------------------

AIQSA_SMTP_HOST=
AIQSA_SMTP_PORT=587
AIQSA_SMTP_USER=
AIQSA_SMTP_PASSWORD=
AIQSA_SMTP_FROM=
AIQSA_SMTP_SECURE=0
AIQSA_SMTP_STARTTLS=1

# -----------------------------------------------------------------------------
# Optional login providers
# -----------------------------------------------------------------------------

AIQSA_GOOGLE_OAUTH_CLIENT_ID=
AIQSA_GOOGLE_OAUTH_CLIENT_SECRET=
AIQSA_YANDEX_OAUTH_CLIENT_ID=
AIQSA_YANDEX_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Optional reverse-proxy settings
# -----------------------------------------------------------------------------

AIQSA_TRUST_PROXY_HEADERS=
AIQSA_TRUSTED_PROXY_COUNT=

# -----------------------------------------------------------------------------
# Optional upload limit
# -----------------------------------------------------------------------------

AIQSA_UPLOAD_MAX_BYTES=25000000
