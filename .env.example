# AIQSA configuration
#
# For a new installation, run `bash prepare-secrets.sh`; it creates `.env`,
# prompts for the administrator email, and fills every REQUIRED value. Copy
# this file manually only if you prefer to configure those values yourself.
# Blank optional values disable that feature.

# Published release image. Replace `latest` with a release such as `X.Y.Z` to
# pin upgrades while keeping this single .env file.
AIQSA_IMAGE=ghcr.io/insciqq/aiqsa:latest

# -----------------------------------------------------------------------------
# REQUIRED: application and initial administrator
# -----------------------------------------------------------------------------

# Generate with: openssl rand -hex 32
# REQUIRED: replace this placeholder.
AIQSA_AUTH_SESSION_SECRET=replace-with-random-session-secret

# Generate with: openssl rand -base64 32
# REQUIRED for encrypted provider, SMTP, and MCP values/tokens.
AIQSA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Generate one independent key with: openssl rand -base64 32
# REQUIRED for versioned Memory no-resurrection fingerprints. Keep the
# `current=<id>,<id>=<key>` grammar and retain old named keys during rotation.
AIQSA_MEMORY_FINGERPRINT_KEYRING=current=v1,v1=replace-with-base64-encoded-32-byte-key

# Generate a separate independent key with: openssl rand -base64 32
# REQUIRED for opaque per-user Memory OpenSearch routing. The identifier is
# part of the projection contract; rotating either value requires a full
# Memory lexical projection rebuild.
AIQSA_MEMORY_OPENSEARCH_ROUTING_KEY=replace-with-base64-encoded-32-byte-routing-key
AIQSA_MEMORY_OPENSEARCH_ROUTING_KEY_ID=v1

# ADMIN (default) makes administrator-connected Memory utility destinations
# trusted installation policy. PER_USER preserves account-level destination
# acceptance for installations that explicitly want that ceremony.
AIQSA_MEMORY_EGRESS_CONSENT_MODE=ADMIN

# Optional Memory coordinator/backpressure controls.
AIQSA_MEMORY_EMBEDDING_BATCH_SIZE=16
AIQSA_MEMORY_IDENTITY_WRITE_PROFILE=LEGACY_V1
AIQSA_MEMORY_COORDINATOR_INTERVAL_MS=1000
AIQSA_MEMORY_COORDINATOR_LEASE_MS=30000
AIQSA_MEMORY_DELETION_CLAIMS_PER_PASS=64
AIQSA_MEMORY_DELETION_PARALLELISM=1
AIQSA_MEMORY_JOB_CLAIMS_PER_PASS=16
AIQSA_MEMORY_JOB_PARALLELISM=2
AIQSA_MEMORY_JOB_PER_USER_PARALLELISM=1

# Versioned Memory lexical projection and bounded OpenSearch transport. Index
# names are installation-owned and are never accepted from browser input.
# POSTGRES is the rollback default. SHADOW keeps PostgreSQL authoritative;
# OPENSEARCH_CANARY uses a stable HMAC-derived user cohort; OPENSEARCH makes
# OpenSearch primary while retaining automatic PostgreSQL fallback.
AIQSA_MEMORY_LEXICAL_BACKEND=POSTGRES
AIQSA_MEMORY_OPENSEARCH_CANARY_PERCENT=1
AIQSA_MEMORY_OPENSEARCH_CIRCUIT_FAILURE_THRESHOLD=5
AIQSA_MEMORY_OPENSEARCH_CIRCUIT_COOLDOWN_MS=30000
AIQSA_MEMORY_OPENSEARCH_INDEX_BUILD_ID=20260831a
AIQSA_MEMORY_OPENSEARCH_READ_ALIAS=aiqsa-memory-lexical-read
AIQSA_MEMORY_OPENSEARCH_WRITE_ALIAS=aiqsa-memory-lexical-write
AIQSA_MEMORY_OPENSEARCH_SEARCH_TIMEOUT_MS=3000
AIQSA_MEMORY_OPENSEARCH_BULK_TIMEOUT_MS=30000
AIQSA_MEMORY_OPENSEARCH_BULK_MAX_DOCUMENTS=100
AIQSA_MEMORY_OPENSEARCH_BULK_MAX_BYTES=2097152
AIQSA_MEMORY_OPENSEARCH_MAX_RESPONSE_BYTES=4194304
AIQSA_MEMORY_OPENSEARCH_SHADOW_MAX_CONCURRENCY=2
AIQSA_MEMORY_OPENSEARCH_SHADOW_TIMEOUT_MS=1200
AIQSA_MEMORY_OPENSEARCH_SHARDS=1
AIQSA_MEMORY_OPENSEARCH_REPLICAS=0
AIQSA_MEMORY_OPENSEARCH_PROJECTION_BATCH=16
AIQSA_MEMORY_OPENSEARCH_PROJECTION_INTERVAL_MS=2000
AIQSA_MEMORY_OPENSEARCH_PROJECTION_LEASE_MS=120000
AIQSA_MEMORY_OPENSEARCH_PROJECTION_MAX_ATTEMPTS=8
AIQSA_MEMORY_OPENSEARCH_VERIFICATION_BATCH=4

# Derived Knowledge BM25 projection worker. Keep the default single claim on
# small self-hosted machines; the hard product bound is 16.
AIQSA_KNOWLEDGE_SEARCH_PROJECTION_BATCH=1
AIQSA_KNOWLEDGE_SEARCH_PROJECTION_INTERVAL_MS=2000

# REQUIRED: replace this placeholder. The password is also required on first start.
AIQSA_INITIAL_ADMIN_EMAIL=replace-with-admin-email
AIQSA_INITIAL_ADMIN_PASSWORD=

# Optional identity details. Leave USER_ID blank to generate one on first start.
AIQSA_INITIAL_ADMIN_DISPLAY_NAME=Administrator
AIQSA_INITIAL_ADMIN_USER_ID=

# -----------------------------------------------------------------------------
# REQUIRED: bundled PostgreSQL and private object storage
# -----------------------------------------------------------------------------

AIQSA_POSTGRES_DB=aiqsa
AIQSA_POSTGRES_USER=aiqsa
# Generate a URI-safe value with: openssl rand -hex 32
AIQSA_POSTGRES_PASSWORD=replace-with-random-postgres-password

AIQSA_S3_ENDPOINT=http://minio:9000
# Optional browser-reachable endpoint for the same private bucket. Leave blank
# to use bounded streaming through the app. Direct upload also requires bucket
# CORS for the application origin and exposed ETag response headers.
AIQSA_S3_PUBLIC_ENDPOINT=
AIQSA_S3_REGION=us-east-1
AIQSA_S3_BUCKET=aiqsa-uploads
AIQSA_S3_ACCESS_KEY_ID=aiqsa
# Generate with: openssl rand -hex 32
AIQSA_S3_SECRET_ACCESS_KEY=replace-with-random-object-storage-secret

# -----------------------------------------------------------------------------
# Local address and browser security
# -----------------------------------------------------------------------------

AIQSA_APP_BASE_URL=http://localhost:3000
AIQSA_BIND_ADDRESS=127.0.0.1
AIQSA_PORT=3000

# Internal OpenSearch control-plane subnet. Parallel installations must use
# non-overlapping values; it is never published as a browser-facing network.
AIQSA_SEARCH_NETWORK_SUBNET=192.168.65.0/24

# Host ports and internal subnets used only by the disposable
# docker-compose.dev.yml topology. Give each parallel checkout a unique
# COMPOSE_PROJECT_NAME, port set, and non-overlapping subnet set.
AIQSA_DEV_POSTGRES_PORT=5432
AIQSA_DEV_MINIO_PORT=9000
AIQSA_DEV_MINIO_CONSOLE_PORT=9001
AIQSA_DEV_OPENSEARCH_PORT=19200
AIQSA_DEV_DEFAULT_NETWORK_SUBNET=192.168.72.0/24
AIQSA_DEV_MCP_NETWORK_SUBNET=192.168.73.0/24
AIQSA_DEV_PARSER_NETWORK_SUBNET=192.168.74.0/24
AIQSA_DEV_SEARCH_NETWORK_SUBNET=192.168.64.0/24
AIQSA_DEV_SEARCH_DIAGNOSTIC_NETWORK_SUBNET=192.168.66.0/24

# Blank derives the setting from AIQSA_APP_BASE_URL. Set to 1 behind HTTPS or
# to 0 only for an intentional HTTP installation.
AIQSA_COOKIE_SECURE=

# -----------------------------------------------------------------------------
# Optional login providers
# -----------------------------------------------------------------------------

AIQSA_GOOGLE_OAUTH_CLIENT_ID=
AIQSA_GOOGLE_OAUTH_CLIENT_SECRET=
AIQSA_YANDEX_OAUTH_CLIENT_ID=
AIQSA_YANDEX_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Leave blank for direct localhost or LAN publication; AIQSA then ignores
# forwarding headers. Non-loopback LAN publication additionally uses the
# immediate TCP peer. Enable both only behind an overwriting proxy; the count
# is the exact X-Forwarded-For IP count (1 for ops/nginx).
# -----------------------------------------------------------------------------

AIQSA_TRUST_PROXY_HEADERS=
AIQSA_TRUSTED_PROXY_COUNT=

# -----------------------------------------------------------------------------
# Optional bounded request/upload/run limits
# -----------------------------------------------------------------------------

AIQSA_AUTH_REQUEST_BODY_MAX_BYTES=65536
AIQSA_JSON_REQUEST_BODY_MAX_BYTES=1048576
AIQSA_UPLOAD_MAX_BYTES=25000000
AIQSA_UPLOAD_MULTIPART_OVERHEAD_BYTES=1048576
AIQSA_UPLOAD_MAX_CONCURRENCY=4
AIQSA_PDF_MAX_PAGES=500
AIQSA_PDF_EXTRACTION_TIMEOUT_MS=20000
AIQSA_ATTACHMENT_EXTRACTED_TEXT_MAX_CHARS=1000000
AIQSA_KNOWLEDGE_MAX_FILE_BYTES=50000000
AIQSA_KNOWLEDGE_MAX_BATCH_FILES=100
AIQSA_KNOWLEDGE_MAX_PAGES=2000
AIQSA_KNOWLEDGE_MAX_NORMALIZED_CHARS=5000000
AIQSA_KNOWLEDGE_MAX_CHUNKS_PER_DOCUMENT=10000
# Leave parser request caps blank to inherit the applicable accepted-file cap.
AIQSA_DOCLING_REQUEST_MAX_BYTES=
AIQSA_DOCLING_RESPONSE_MAX_BYTES=33554432
AIQSA_DOCLING_TIMEOUT_MS=300000
AIQSA_TIKA_REQUEST_MAX_BYTES=
AIQSA_TIKA_RESPONSE_MAX_BYTES=16777216
AIQSA_TIKA_TIMEOUT_MS=120000
AIQSA_RUN_ATTACHMENT_MAX_COUNT=20
AIQSA_RUN_ATTACHMENT_MAX_MATERIALIZED_BYTES=67108864
AIQSA_RUN_ATTACHMENT_MAX_ENCODED_BYTES=100663296
AIQSA_RUN_ATTACHMENT_READ_CONCURRENCY=2
AIQSA_OPENAI_BACKGROUND_POLL_TIMEOUT_MS=660000
AIQSA_PROVIDER_RESPONSE_MAX_BYTES=16777216
AIQSA_PROVIDER_STREAM_MAX_EVENT_BYTES=4194304
AIQSA_PROVIDER_STREAM_MAX_BYTES=67108864
AIQSA_PROVIDER_STREAM_MAX_OUTPUT_CHARS=8388608
AIQSA_MCP_INITIALIZE_RESPONSE_MAX_BYTES=1048576
AIQSA_MCP_LIST_TOOLS_RESPONSE_MAX_BYTES=16777216
AIQSA_MCP_CALL_TOOL_RESPONSE_MAX_BYTES=524288
AIQSA_MCP_UNKNOWN_RESPONSE_MAX_BYTES=1048576
AIQSA_MCP_SSE_EVENT_MAX_BYTES=16777216
