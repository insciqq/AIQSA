# Run `sh scripts/configure.sh` to generate .env with unique secrets.
# Set the administrator email and the URL users will open before starting Compose.
AIQSA_APP_BASE_URL=http://localhost:3000
# Set 0 to disable only the external MCP Hub; Personal Memory stays independent.
AIQSA_MCP_HUB_ENABLED=1
# Artifact resources are downloaded at creation and viewed offline.
# Host lists replace defaults; an empty list permits no hosts.
# AIQSA_ARTIFACT_EXTERNAL_RESOURCES=on
# AIQSA_ARTIFACT_LIBRARY_HOSTS=cdnjs.cloudflare.com,fonts.googleapis.com,fonts.gstatic.com
# AIQSA_ARTIFACT_IMAGE_HOSTS=
# MCP JSON-RPC request envelope, shared by Agent relay, gateway and MCP client.
# AIQSA_MCP_REQUEST_MAX_BYTES=8388608
# Maximum MCP tools/call response envelope in bytes (8 MiB; configurable up to 16 MiB).
# AIQSA_MCP_CALL_TOOL_RESPONSE_MAX_BYTES=8388608
# MCP inventory and selected-schema budget, including paginated tools (16 MiB; up to 64 MiB).
# AIQSA_MCP_LIST_TOOLS_RESPONSE_MAX_BYTES=16777216
# Local PDF extraction deadline, independent of worker memory/page limits.
# AIQSA_PDF_EXTRACTION_TIMEOUT_MS=300000
# Structured helper resource guards; model context/output limits still apply.
# AIQSA_STRUCTURED_INPUT_MAX_BYTES=16777216
# AIQSA_STRUCTURED_SCHEMA_MAX_BYTES=1048576
# AIQSA_STRUCTURED_OUTPUT_MAX_CHARS=1048576
AIQSA_INITIAL_ADMIN_EMAIL=
AIQSA_INITIAL_ADMIN_PASSWORD=

# Generated once. Preserve these values across upgrades and with your backups.
AIQSA_AUTH_SESSION_SECRET=
AIQSA_ENCRYPTION_KEY=
AIQSA_MEMORY_FINGERPRINT_KEYRING=
AIQSA_MEMORY_OPENSEARCH_ROUTING_KEY=
AIQSA_POSTGRES_PASSWORD=
AIQSA_S3_SECRET_ACCESS_KEY=

# Default: stable published images and an application port bound to loopback.
# AIQSA_IMAGE=ghcr.io/insciqq/aiqsa:latest
# AIQSA_PORT=3000
# AIQSA_APP_MEMORY_LIMIT=2g
# AIQSA_APP_CPU_LIMIT=2
# Docker log rotation per container (capacity, not a retention duration).
# AIQSA_LOG_MAX_FILES=5
# AIQSA_LOG_MAX_SIZE=10m

# Enable only when the application is behind your reviewed reverse-proxy chain.
# AIQSA_TRUST_PROXY_HEADERS=1
# AIQSA_TRUSTED_PROXY_COUNT=1

# Optional KVM Workspace. Set all four values together; use `stat -c %g /dev/kvm`
# for the group and `openssl rand -hex 32` for a new independent runner token.
# COMPOSE_PROFILES=workspace
# AIQSA_WORKSPACE_RUNNER_URL=http://workspace-runner:4310
# AIQSA_WORKSPACE_RUNNER_TOKEN=
# AIQSA_KVM_GID=

# Agent limits are managed in Control Center → Workspace (off by default).
